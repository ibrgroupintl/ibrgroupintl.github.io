<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#0284c7">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="index, follow">
  <title>Edit Profile — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/resource-centre.css">
  <link rel="stylesheet" href="/index.css">
  <link rel="stylesheet" href="/mobile-compat.css">
  <link rel="stylesheet" href="/page-transition.css">
  <style>
    :root {
      --muted: #475569;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Open Sans', Arial, sans-serif;
      color: #0f172a;
      background: linear-gradient(180deg, #f5f9ff 0%, #ffffff 100%);
    }

    .page-wrapper {
      background: #fff;
      max-width: 1920px;
      min-height: 100vh;
      margin: 0 auto;
      box-shadow: 0 0 20px rgba(0, 0, 0, .1)
    }

    .auth-shell {
      max-width: 760px;
      margin: 2rem auto;
      padding: 2rem;
      border-radius: 16px;
      border: 1px solid #dbe3ee;
      background: linear-gradient(145deg, #fff 0%, #f6fbff 100%);
      text-align: center;
      box-shadow: 0 8px 24px rgba(2, 6, 23, .08)
    }

    .profile-shell {
      display: none;
      max-width: 980px;
      margin: 2rem auto 3rem;
      padding: 0 1rem
    }

    .panel {
      background: #fff;
      border: 1px solid #dbe3ee;
      border-radius: 14px;
      box-shadow: 0 6px 20px rgba(2, 6, 23, .06)
    }

    .panel-head {
      padding: 1rem;
      border-bottom: 1px solid #edf2f7
    }

    .panel-body {
      padding: 1rem
    }

    .form-grid {
      display: grid;
      gap: 12px
    }

    .form-row {
      display: grid;
      gap: 8px
    }

    .name-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px
    }

    .form-label {
      font-weight: 600;
      color: #0f2f4f
    }

    .form-control {
      width: 100%;
      border: 1px solid #d0d7de;
      border-radius: 8px;
      padding: 10px 12px;
      box-sizing: border-box;
      font: inherit
    }

    .form-control:focus {
      border-color: #0284c7;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, .12);
      outline: none
    }

    textarea.form-control {
      min-height: 170px;
      font-size: inherit;
      line-height: 1.5;
      font-family: 'Open Sans', Arial, sans-serif
    }

    .muted {
      color: var(--muted);
      font-size: .9rem
    }

    .image-preview {
      width: 120px;
      height: 120px;
      border-radius: 12px;
      object-fit: cover;
      border: 1px solid #dbe3ee;
      background: #f8fafc
    }

    .button-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap
    }

    .status-note {
      margin-top: .75rem;
      color: var(--muted)
    }

    .profile-url-box {
      padding: .75rem;
      border: 1px solid #dbe3ee;
      border-radius: 10px;
      background: #f8fbff;
      word-break: break-all
    }

    /* Sidebar menu (shared across all pages) */
    .sidebar-menu-shell {
      display: none;
      position: fixed;
      top: 88px;
      left: 24px;
      width: 220px;
      background: #ffffff;
      border: 1px solid #dbe3ee;
      border-radius: 12px;
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.12);
      padding: 10px 0;
      z-index: 950;
    }

    .sidebar-menu-link {
      display: block;
      padding: 11px 14px;
      margin: 2px 8px;
      border-radius: 8px;
      color: #092a4b;
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .sidebar-menu-link:hover,
    .sidebar-menu-link:focus {
      background: #092a4b;
      color: #ffffff;
      transform: translateX(3px);
    }

    body.has-sidebar #protected-content {
      margin-left: 260px;
    }

    @media (max-width: 980px) {
      .sidebar-menu-shell {
        position: static;
        width: 100%;
        max-width: 900px;
        margin: 12px auto;
      }

      body.has-sidebar #protected-content {
        margin-left: 0;
      }
    }

    @media (max-width: 980px) {
      .name-grid {
        grid-template-columns: 1fr
      }
    }
  </style>
</head>

<body class="auth-pending">
  <div class="page-wrapper">
    <header class="resource-nav" role="banner">
      <div class="container container-nav">
        <div class="logo" style="display:flex;align-items:center;gap:12px">
          <img src="/160.jpg" alt="Impact logo" class="site-logo" style="height:36px;width:auto;display:block">
          <span class="site-title" style="color:lightgrey">Premium</span>
        </div>
        <div class="user-menu" style="margin-left:auto;display:flex;align-items:center;gap:12px">
          <div class="auth-profile-chip" data-auth-profile>
            <img class="auth-profile-photo" data-auth-photo src="/100.png" alt="Profile photo">
            <span class="auth-profile-name" data-auth-name></span>
          </div>
          <a class="btn btn-outline nav-login" href="/login.html" id="signInLink">Sign In</a>
          <button class="btn btn-outline" id="signOutBtn" style="display:none">Sign Out</button>
        </div>
      </div>
    </header>

    <nav id="topNavMenu" class="sidebar-menu-shell" aria-label="Members navigation">
      <a class="sidebar-menu-link" href="/index.html">Home</a>
      <a class="sidebar-menu-link" href="/editprofile.html">Edit Profile</a>
      <a class="sidebar-menu-link" href="/directory.html">Member Directory</a>
      <a class="sidebar-menu-link" href="/members.html">Members Area</a>
      <a class="sidebar-menu-link" href="/accounts.html">Accounts Admin</a>
      <a class="sidebar-menu-link" href="/messages.html">Messages Inbox</a>
      <a class="sidebar-menu-link" href="/insights.html">Insights Archive</a>
      <a class="sidebar-menu-link" href="/uploads.html">Resume Uploads</a>
      <a class="sidebar-menu-link" href="/settings.html">Account Settings</a>
      <a class="sidebar-menu-link" href="https://editor.ibrecruitment.com/claude.html" target="_blank" rel="noopener noreferrer">Ask Claude Code</a>
      <a class="sidebar-menu-link" href="https://www.ibrecruitment.com/contact" target="_blank" rel="noopener noreferrer">Contact Sales</a>
    </nav>
    <script>
      // Show/hide sidebar menu based on authentication
      function updateSidebarVisibility() {
        var sidebar = document.getElementById('topNavMenu');
        if (document.body.classList.contains('has-sidebar')) {
          sidebar.style.display = 'block';
        } else {
          sidebar.style.display = 'none';
        }
      }
      document.addEventListener('DOMContentLoaded', updateSidebarVisibility);
      var observer = new MutationObserver(updateSidebarVisibility);
      observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    </script>

    <section id="loginSection" class="auth-shell">
      <h1 style="margin:0;color:#092a4b">Edit Profile</h1>
      <p style="margin:.75rem 0 1.25rem;color:var(--muted)">Sign in to edit your member profile.</p>
      <a class="btn btn-primary" href="/login.html">Go to Sign In</a>
    </section>

    <main id="profileShell" class="profile-shell" role="main">
      <section class="panel">
        <div class="panel-head">
          <h1 style="margin:0;color:#092a4b;font-size:1.3rem">Member Profile Settings</h1>
          <p class="muted" style="margin:.45rem 0 0">Profile URL:</p>
          <div class="profile-url-box"><a id="publicProfileLink" href="#" target="_blank" rel="noopener noreferrer">-</a>
          </div>
          <p id="profileDocStatus" class="muted" style="margin:.35rem 0 0">Profile record: loading...</p>
        </div>
        <div class="panel-body">
          <div class="form-grid">
            <div class="form-row">
              <span class="form-label">Profile image</span>
              <img id="profileImagePreview" class="image-preview" src="/100.png" alt="Profile image preview">
              <input id="profileImageInput" class="form-control" type="file" accept="image/png,image/jpeg,image/webp">
              <span class="muted">Default image is used if none uploaded.</span>
            </div>

            <div class="name-grid">
              <div class="form-row">
                <label class="form-label" for="firstNameInput">First name (max 50)</label>
                <input id="firstNameInput" class="form-control" type="text" maxlength="50" placeholder="First name">
              </div>
              <div class="form-row">
                <label class="form-label" for="lastNameInput">Last name (max 50)</label>
                <input id="lastNameInput" class="form-control" type="text" maxlength="50" placeholder="Last name">
              </div>
            </div>

            <div class="form-row">
              <label class="form-label" for="bioInput">Bio (max 1000)</label>
              <textarea id="bioInput" class="form-control" maxlength="1000" placeholder="Tell people about your work and focus..."></textarea>
            </div>

            <div class="name-grid">
              <div class="form-row">
                <label class="form-label" for="socialLabelInput">Social platform</label>
                <input id="socialLabelInput" class="form-control" type="text" maxlength="40" placeholder="LinkedIn">
              </div>
              <div class="form-row">
                <label class="form-label" for="socialUrlInput">Social URL</label>
                <input id="socialUrlInput" class="form-control" type="url" maxlength="300" placeholder="https://...">
              </div>
            </div>

            <div class="button-row">
              <button type="button" class="btn btn-primary" id="saveProfileBtn">Save Profile</button>
              <a href="/settings.html" class="btn btn-outline">Back to Settings</a>
              <a id="openProfileBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Open Profile Page</a>
            </div>

            <p id="profileStatus" class="status-note">Loading profile...</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="resource-footer" role="contentinfo">
      <div class="container" style="text-align:center">
        <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
      </div>
    </footer>
  </div>

  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <script defer src="/header-profile.js"></script>
  <script defer src="/mobile-compat.js"></script>
  <script defer src="/page-transition.js"></script>

  <script>
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) return;
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) {}
      const auth = firebase.auth();
      const db = firebase.firestore();
      const DEFAULT_PUBLIC_IMAGE = '/100.png';
      const loginSection = document.getElementById('loginSection');
      const profileShell = document.getElementById('profileShell');
      const signOutBtn = document.getElementById('signOutBtn');
      const signInLink = document.getElementById('signInLink');
      const profileImagePreview = document.getElementById('profileImagePreview');
      const profileImageInput = document.getElementById('profileImageInput');
      const firstNameInput = document.getElementById('firstNameInput');
      const lastNameInput = document.getElementById('lastNameInput');
      const bioInput = document.getElementById('bioInput');
      const socialLabelInput = document.getElementById('socialLabelInput');
      const socialUrlInput = document.getElementById('socialUrlInput');
      const saveProfileBtn = document.getElementById('saveProfileBtn');
      const profileStatus = document.getElementById('profileStatus');
      const profileDocStatus = document.getElementById('profileDocStatus');
      const publicProfileLink = document.getElementById('publicProfileLink');
      const openProfileBtn = document.getElementById('openProfileBtn');
      let currentUser = null;
      let userIdValue = '';
      let profileSlug = '';
      let imageDataUrl = '';
      const normalize = (v, max) => String(v || '').trim().slice(0, max);
      const normalizeUrl = (v) => {
        try {
          const u = new URL(normalize(v, 300));
          return ['http:', 'https:'].includes(u.protocol) ? u.toString() : '';
        } catch {
          return '';
        }
      };
      const slugify = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').replace(/-{2,}/g, '-') || 'profile';
      const randomSuffix = () => Array.from(window.crypto.getRandomValues(new Uint32Array(4)), n => 'abcdefghijklmnopqrstuvwxyz0123456789'[n % 36]).join('');
      const buildSlug = (first, last, fallback, existing) => existing ? String(existing).toLowerCase() : slugify((first + ' ' + last).trim() || fallback) + '-' + randomSuffix();
      const setUrl = (slug) => {
        const href = slug ? '/profile/' + encodeURIComponent(slug) + '.html' : '#';
        publicProfileLink.href = href;
        publicProfileLink.textContent = href === '#' ? '-' : href;
        if (openProfileBtn) openProfileBtn.href = href;
      };
      const setStatus = (msg) => profileStatus.textContent = msg;

      async function loadProfile() {
        const snap = await db.collection('publicProfiles').doc(currentUser.uid).get();
        const data = snap.exists ? snap.data() || {} : {};
        userIdValue = normalize(data.userId, 20) || userIdValue || currentUser.uid;
        firstNameInput.value = normalize(data.firstName, 50);
        lastNameInput.value = normalize(data.lastName, 50);
        bioInput.value = normalize(data.bio, 1000);
        socialLabelInput.value = normalize(data.socialLabel, 40);
        socialUrlInput.value = normalize(data.socialUrl, 300);
        profileSlug = buildSlug(firstNameInput.value, lastNameInput.value, userIdValue, data.profileSlug);
        setUrl(profileSlug);
        imageDataUrl = normalize(data.imageDataUrl, 1000000);
        profileImagePreview.src = imageDataUrl || DEFAULT_PUBLIC_IMAGE;
        profileDocStatus.textContent = snap.exists ? 'Profile record: found' : 'Profile record: not saved yet';
      }

      async function saveProfile() {
        if (!currentUser) return;
        const firstName = normalize(firstNameInput.value, 50);
        const lastName = normalize(lastNameInput.value, 50);
        const bio = normalize(bioInput.value, 1000);
        const socialLabel = normalize(socialLabelInput.value, 40);
        const socialUrl = normalizeUrl(socialUrlInput.value);
        if (socialUrlInput.value && !socialUrl) {
          setStatus('Please enter a valid http(s) social URL.');
          return;
        }
        const nextId = userIdValue || currentUser.uid;
        const nextSlug = buildSlug(firstName, lastName, nextId, profileSlug);
        const userProfilePayload = {
          userId: nextId,
          email: currentUser.email || '',
          updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        };
        const profilePayload = {
          uid: currentUser.uid,
          userId: nextId,
          profileSlug: nextSlug,
          firstName,
          lastName,
          bio,
          socialLabel,
          socialUrl,
          imageDataUrl: imageDataUrl || '',
          updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        };
        try {
          saveProfileBtn.disabled = true;
          setStatus('Saving profile...');
          const batch = db.batch();
          batch.set(db.collection('userProfiles').doc(currentUser.uid), userProfilePayload);
          batch.set(db.collection('publicProfiles').doc(currentUser.uid), profilePayload);
          await batch.commit();
          userIdValue = nextId;
          profileSlug = nextSlug;
          setUrl(profileSlug);
          profileDocStatus.textContent = 'Profile record: saved';
          setStatus('Profile saved successfully.');
        } catch (err) {
          setStatus('Profile save failed: ' + (err && err.message ? err.message : 'unknown error'));
        } finally {
          saveProfileBtn.disabled = false;
        }
      }

      function showSignedOut() {
        loginSection.style.display = 'block';
        profileShell.style.display = 'none';
        signOutBtn.style.display = 'none';
        signInLink.style.display = 'inline-flex';
        document.body.classList.remove('auth-pending', 'has-sidebar');
      }
      async function showSignedIn(user) {
        currentUser = user;
        loginSection.style.display = 'none';
        profileShell.style.display = 'block';
        signOutBtn.style.display = 'inline-flex';
        signInLink.style.display = 'none';
        document.body.classList.remove('auth-pending');
        document.body.classList.add('has-sidebar');
        await loadProfile();
      }
      auth.onAuthStateChanged(async (user) => {
        if (!user) {
          currentUser = null;
          showSignedOut();
          return;
        }
        await showSignedIn(user);
      });
      profileImageInput.addEventListener('change', async () => {
        const file = profileImageInput.files && profileImageInput.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
          imageDataUrl = String(reader.result || '');
          profileImagePreview.src = imageDataUrl;
          setStatus('Image ready. Save profile to publish it.');
        };
        reader.readAsDataURL(file);
      });
      saveProfileBtn.addEventListener('click', saveProfile);
      signOutBtn.addEventListener('click', () => auth.signOut());
    });
  </script>
</body>

</html>