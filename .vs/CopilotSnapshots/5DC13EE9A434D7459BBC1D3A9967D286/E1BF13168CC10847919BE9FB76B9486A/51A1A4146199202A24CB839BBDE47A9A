<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#0284c7">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>Member Directory — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/resource-centre.css">
  <link rel="stylesheet" href="/index.css">
  <link rel="stylesheet" href="/mobile-compat.css">
  <link rel="stylesheet" href="/page-transition.css">
  <style>
    .directory-shell { max-width: 1100px; margin: 2rem auto 3rem; padding: 0 1rem; }
    .directory-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
    .profile-card { background: #fff; border: 1px solid #dbe3ee; border-radius: 14px; box-shadow: 0 6px 20px rgba(2,6,23,.06); padding: 1.25rem; display: flex; flex-direction: column; align-items: center; transition: box-shadow 0.2s; }
    .profile-card:hover { box-shadow: 0 12px 32px rgba(2,6,23,.10); }
    .profile-card img { width: 80px; height: 80px; border-radius: 12px; object-fit: cover; border: 1px solid #dbe3ee; background: #f8fafc; margin-bottom: 0.75rem; }
    .profile-card .name { font-weight: 700; color: #0f2f4f; font-size: 1.1rem; margin-bottom: 0.25rem; }
    .profile-card .bio { color: #475569; font-size: 0.97rem; margin-bottom: 0.5rem; text-align: center; min-height: 2.5em; }
    .profile-card .social-link { color: #0284c7; text-decoration: none; font-size: 0.95rem; margin-top: 0.25rem; }
    .profile-card .social-link:hover { text-decoration: underline; }
    .directory-status { color: var(--muted); text-align: center; margin: 1.5rem 0; }
  </style>
</head>
<body class="auth-pending">
  <div class="page-wrapper">
    <header class="resource-nav" role="banner">
      <div class="container container-nav">
        <div class="logo" style="display:flex;align-items:center;gap:12px">
          <img src="/160.jpg" alt="Impact logo" class="site-logo" style="height:36px;width:auto;display:block">
          <span class="site-title" style="color:lightgrey">Premium</span>
        </div>
        <div class="user-menu" style="margin-left:auto;display:flex;align-items:center;gap:12px">
          <div class="auth-profile-chip" data-auth-profile>
            <img class="auth-profile-photo" data-auth-photo src="/100.png" alt="Profile photo">
            <span class="auth-profile-name" data-auth-name></span>
          </div>
          <a class="btn btn-outline nav-login" href="/login.html" id="signInLink">Sign In</a>
          <button class="btn btn-outline" id="signOutBtn" style="display:none">Sign Out</button>
        </div>
      </div>
    </header>
    <nav id="topNavMenu" class="sidebar-menu-shell" aria-label="Members navigation">
      <a class="sidebar-menu-link" href="/index.html">Home</a>
      <a class="sidebar-menu-link" href="/editprofile.html">Edit Profile</a>
      <a class="sidebar-menu-link" href="/members.html">Members Area</a>
      <a class="sidebar-menu-link" href="/accounts.html">Accounts Admin</a>
      <a class="sidebar-menu-link" href="/messages.html">Messages Inbox</a>
      <a class="sidebar-menu-link" href="/insights.html">Insights Archive</a>
      <a class="sidebar-menu-link" href="/uploads.html">Resume Uploads</a>
      <a class="sidebar-menu-link" href="/settings.html">Account Settings</a>
      <a class="sidebar-menu-link" href="https://editor.ibrecruitment.com/claude.html" target="_blank" rel="noopener noreferrer">Ask Claude Code</a>
      <a class="sidebar-menu-link" href="https://www.ibrecruitment.com/contact" target="_blank" rel="noopener noreferrer">Contact Sales</a>
    </nav>
    <main class="directory-shell" role="main">
      <h1 style="margin:0 0 1.5rem;color:#092a4b;font-size:1.5rem;text-align:center">Member Directory</h1>
      <div id="directoryStatus" class="directory-status">Loading directory...</div>
      <div id="directoryGrid" class="directory-grid" style="display:none"></div>
    </main>
    <footer class="resource-footer" role="contentinfo">
      <div class="container" style="text-align:center">
        <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
      </div>
    </footer>
  </div>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <script defer src="/header-profile.js"></script>
  <script defer src="/mobile-compat.js"></script>
  <script defer src="/page-transition.js"></script>
  <script>
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) return;
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) {}
      const auth = firebase.auth();
      const db = firebase.firestore();
      const DEFAULT_PUBLIC_IMAGE = '/100.png';
      const directoryStatus = document.getElementById('directoryStatus');
      const directoryGrid = document.getElementById('directoryGrid');
      const signOutBtn = document.getElementById('signOutBtn');
      const signInLink = document.getElementById('signInLink');
      function showSignedOut() {
        directoryStatus.textContent = 'Sign in to view the member directory.';
        directoryGrid.style.display = 'none';
        signOutBtn.style.display = 'none';
        signInLink.style.display = 'inline-flex';
        document.body.classList.remove('auth-pending','has-sidebar');
      }
      async function showSignedIn(user) {
        directoryStatus.textContent = 'Loading directory...';
        directoryGrid.style.display = 'grid';
        signOutBtn.style.display = 'inline-flex';
        signInLink.style.display = 'none';
        document.body.classList.remove('auth-pending');
        document.body.classList.add('has-sidebar');
        // Query all public profiles
        try {
          const snap = await db.collection('publicProfiles').where('isPublic', '!=', false).get();
          if (snap.empty) {
            directoryStatus.textContent = 'No member profiles found.';
            directoryGrid.innerHTML = '';
            return;
          }
          directoryStatus.textContent = '';
          directoryGrid.innerHTML = '';
          snap.forEach(doc => {
            const data = doc.data() || {};
            const img = data.imageDataUrl || DEFAULT_PUBLIC_IMAGE;
            const name = (data.firstName || '') + ' ' + (data.lastName || '');
            const bio = data.bio || '';
            const socialLabel = data.socialLabel || '';
            const socialUrl = data.socialUrl || '';
            const profileSlug = data.profileSlug || doc.id;
            const profileUrl = '/profile/' + encodeURIComponent(profileSlug) + '.html';
            const card = document.createElement('div');
            card.className = 'profile-card';
            card.innerHTML = `
              <a href="${profileUrl}" tabindex="0"><img src="${img}" alt="${name} profile photo"></a>
              <a href="${profileUrl}" class="name">${name}</a>
              <div class="bio">${bio}</div>
              ${socialUrl ? `<a class="social-link" href="${socialUrl}" target="_blank" rel="noopener noreferrer">${socialLabel || 'Social'}</a>` : ''}
            `;
            directoryGrid.appendChild(card);
          });
        } catch (err) {
          directoryStatus.textContent = 'Failed to load directory.';
        }
      }
      auth.onAuthStateChanged(async (user) => {
        if (!user) { showSignedOut(); return; }
        await showSignedIn(user);
      });
      signOutBtn.addEventListener('click', () => auth.signOut());
    });
  </script>
</body>
</html>
