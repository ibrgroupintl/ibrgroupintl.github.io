<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Members — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/index.css">
  <link rel="stylesheet" href="/resource-centre.css">
  <!-- Google Identity Services (optional if you allow inline sign-in elsewhere) -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>

  <!-- Use modular Firebase SDK (imports performed in the module below) -->
  <script type="module" src="/firebase-init-members.js"></script>
</head>
<body>
  <header class="resource-nav" role="banner">
    <div class="container container-nav">
      <div class="logo">
        <span class="site-title">User Portal</span>
      </div>
      <div class="user-menu">
        <button id="logoutBtn" class="btn btn-outline">Sign out</button>
      </div>
    </div>
  </header>

  <!-- Login section (shown when not authenticated) -->
  <div id="login-section" style="max-width:820px;margin:1.5rem auto;text-align:center">
    <div class="signin-card">
      <p class="intro-note">Please sign in with your Google account to access the members area.</p>
      <div class="divider"></div>
      <div class="center-buttons">
        <div id="g_id_signin" aria-hidden="false"></div>
        <div id="google-login-status" role="status" aria-live="polite" style="color:var(--text); margin-left:8px;">Not signed in</div>
      </div>
    </div>
  </div>

  <main id="protected-content" class="container" role="main" style="padding:3rem 0;max-width:900px;text-align:center;display:none">
    <h1>Members Area</h1>
    <p class="lead">Welcome to the members area. This page is protected and requires authentication.</p>
    <div style="margin-top:1.5rem">
      <p>Hello, <strong id="userName">Member</strong></p>
      <p data-user-email></p>
    </div>

    <section style="margin-top:2rem">
      <h2>Your Resources</h2>
      <p>Access exclusive reports and tools available to authenticated users.</p>
      <a class="btn btn-primary" href="/resource-centre">Open Resource Centre</a>
    </section>
  </main>

  <footer class="resource-footer">
    <div class="container" style="text-align:center">
      <div style="margin-bottom:8px;">
        <a href="/terms.html" class="btn btn-outline" style="padding:6px 10px;margin-right:8px">Terms</a>
        <a href="/privacy.html" class="btn btn-outline" style="padding:6px 10px">Privacy</a>
      </div>
      <div>
        <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment</p>
      </div>
    </div>
  </footer>

  <script src="/top-script.js" defer></script>
  <script src="/index.js" defer></script>
</body>
</html>
