:root{
  --site-bg: #f8fafc;
  --card-bg: #ffffff;
  --text: #1a1e29;
  --muted: #64748b;
  --accent: #0284c7;
  --accent-strong: #0369a1;
  --border: #e2e8f0;
  --shadow: 0 6px 20px rgba(2,6,23,0.06);
  --radius: 12px;
  --elev-1: 0 8px 30px rgba(2,6,23,0.06);
  --touch-target: 48px; /* recommended minimum tappable size */
  --container-max: 1200px;
}

/* Page layout helpers */
html,body{height:100%;margin:0;font-family: "Open Sans", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;background:var(--site-bg);color:var(--text)}
.container{max-width:var(--container-max);margin:0 auto;padding:0 1.5rem}

/* Header */
.resource-nav{
  /* simplified header background (removed image for a cleaner, consistent header) */
  background: linear-gradient(180deg, rgba(2,6,23,0.9), rgba(2,6,23,0.85));
  border-bottom:1px solid rgba(255,255,255,0.08);
  padding:1rem 0;
  color: #fff;
}
.container-nav{display:flex;align-items:center;justify-content:space-between}
.site-title{font-weight:700;color:rgba(255,255,255,0.95);font-size:1.125rem}
.user-menu{display:flex;align-items:center;gap:0.75rem}

/* Mobile nav toggle (hidden on desktop) */
#navToggle{display:none;padding:0.5rem 0.7rem;border-radius:8px}


/* Buttons */
.btn{display:inline-block;padding:0.5rem 0.9rem;border-radius:8px;font-weight:600;border:none;cursor:pointer;line-height:1;min-height:var(--touch-target);display:inline-flex;align-items:center;justify-content:center}
.btn-primary{background:var(--accent);color:#fff;transition:transform 160ms cubic-bezier(.2,.8,.2,1),box-shadow 160ms,background 160ms}
.btn-primary:hover,.btn-primary:focus{
  transform:translateY(-4px);
  box-shadow:var(--elev-1);
  background:var(--accent-strong);
}
.btn-primary:active{transform:translateY(-1px);}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--muted)}

/* Cookie consent bar */
/* cookie consent styles removed - cookie bar implemented directly in index.html */
/* Ensure header login outline button contrasts against the nav background image */
.resource-nav .btn-outline.nav-login{
  color: rgba(255,255,255,0.95);
  font-weight:700;
  /* subtle light background for contrast against header */
  background: rgba(255,255,255,0.10);
  border-color: rgba(255,255,255,0.14);
  backdrop-filter: blur(2px);
}

/* Ensure any outline buttons inside the header also appear lighter */
.resource-nav .btn-outline{
  color: rgba(255,255,255,0.95);
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.12);
}

/* Contact code snippet in header */
.contact-code{
  color: lightgrey;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, 'Roboto Mono', 'Segoe UI Mono', monospace;
  background: rgba(255,255,255,0.03);
  padding: 6px 10px;
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.06);
  margin-right: 0.75rem;
  font-size: 0.95rem;
  display: inline-block;
  vertical-align: middle;
}

/* Hero */
.hub-main .container{padding:4.5rem 0}
.hub-main h1{font-size:2rem;margin:0 0 0.5rem}
.hub-main p{color:var(--muted);max-width:68ch;margin:0 auto}

/* Resource cards (tighter spacing for index) */
.resource-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem}
.resource-card{background:var(--card-bg);padding:1.25rem;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow);transition:transform 240ms ease,box-shadow 240ms ease}
.resource-card:hover{transform:translateY(-6px);box-shadow:var(--elev-1)}
.card-icon{font-size:2rem;margin-bottom:0.5rem}

/* Footer */
.resource-footer{padding:2rem 0;text-align:center;color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center}

/* small responsive tweaks */
/* Improved mobile-first and modern responsive rules */
@media (max-width:900px) {
  /* loosen container spacing and stack header */
  .container{padding:0 1rem}
  .container-nav{flex-direction:row;align-items:center;gap:0.5rem}
  .resource-nav{position:sticky;top:0;z-index:40;padding:0.65rem 0;background:linear-gradient(180deg, rgba(255,255,255,0.7), rgba(255,255,255,0.55));backdrop-filter: blur(6px);}
  .user-menu{width:auto;justify-content:flex-end}
  .hub-main .container{padding:3rem 0}
  .hub-main h1{font-size:1.75rem}
  .resource-grid{grid-template-columns:1fr}
  .resource-card{padding:1rem}
  /* show nav toggle on smaller screens */
  #navToggle{display:inline-flex}
  .user-menu{display:none}
  body.nav-open .user-menu{display:flex;flex-direction:column;position:absolute;top:64px;right:12px;background:linear-gradient(180deg,#fff,#fff);padding:10px;border-radius:8px;box-shadow:var(--elev-1);color:var(--text)}
}

@media (max-width:420px) {
  /* compact mobile adjustments */
  .container{padding:0 0.75rem}
  .site-title{font-size:0.95rem}
  .user-menu{gap:0.5rem}
  .btn{padding:0.5rem 0.75rem;font-size:0.95rem}
  .hub-main .container{padding:2rem 0}
  .hub-main h1{font-size:1.4rem}
  .resource-card{padding:0.85rem;border-radius:10px}
  .card-icon{font-size:1.6rem}
  /* ensure touch targets remain large enough */
  .btn{min-height:var(--touch-target)}

  /* Header adjustments for narrow screens: stack items and reduce contact code */
  .container-nav{flex-direction:row;align-items:center;gap:8px}
  .user-menu{display:flex;align-items:center;gap:8px}
  .contact-code{font-size:0.85rem;padding:5px 8px;margin-right:0.5rem}
  /* On very small screens hide the phone snippet to keep header compact */
  @media (max-width:360px){
    .contact-code{display:none}
  }

  /* Cookie consent bar stack and full-width buttons */
  #cookieConsentBar{flex-direction:column;align-items:stretch;padding:10px}
  #cookieConsentBar > div:first-child{margin-bottom:8px}
  #cookieConsentBar button{width:100%;}
}
