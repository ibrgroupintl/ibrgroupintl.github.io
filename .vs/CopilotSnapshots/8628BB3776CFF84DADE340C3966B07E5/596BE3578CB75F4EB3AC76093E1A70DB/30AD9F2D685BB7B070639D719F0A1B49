:root {
  --page-transition-overlay: rgba(2, 6, 23, 0.55);
  --page-transition-card-bg: rgba(15, 23, 42, 0.88);
  --page-transition-card-border: rgba(148, 163, 184, 0.35);
  --page-transition-spinner: var(--accent, #0284c7);
}

.page-transition-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  align-items: center;
  justify-content: center;
  background: var(--page-transition-overlay);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease;
}

.page-transition-overlay.active {
  display: flex;
  opacity: 1;
}

.page-transition-card {
  min-width: 180px;
  border: 1px solid var(--page-transition-card-border);
  border-radius: 14px;
  background: var(--page-transition-card-bg);
  color: #f8fafc;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 12px 16px;
  box-shadow: 0 20px 45px rgba(2, 6, 23, 0.35);
}

.page-transition-spinner {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: var(--page-transition-spinner);
  animation: page-transition-spin 0.8s linear infinite;
}

.page-transition-label {
  font-size: 0.92rem;
  font-weight: 600;
  letter-spacing: 0.01em;
}

body.page-transition-leaving .page-wrapper {
  opacity: 0.9;
  transform: scale(0.998);
  transition: opacity 220ms ease, transform 220ms ease;
}

@keyframes page-transition-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .page-transition-overlay,
  body.page-transition-leaving .page-wrapper {
    transition: none;
  }

  .page-transition-spinner {
    animation: none;
  }
}
