<script>
  // initialize after firebase is ready
  const CLIENT_ID = 'YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com';

  const tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: CLIENT_ID,
    scope: 'openid email profile',
    callback: async (tokenResponse) => {
      if (tokenResponse.error) {
        console.error('GSI token error', tokenResponse);
        return;
      }
      // use access token to sign into Firebase
      const accessToken = tokenResponse.access_token;
      const credential = firebase.auth.GoogleAuthProvider.credential(null, accessToken);
      try {
        const userCred = await firebase.auth().signInWithCredential(credential);
        console.log('Signed in via GSI -> Firebase:', userCred.user);
      } catch (err) {
        console.error('Firebase signInWithCredential failed', err);
      }
    }
  });
  // call this to start sign-in (e.g. wire to your Sign In button)
  function signInWithGoogleGSI() {
    tokenClient.requestAccessToken(); // opens accounts.google.com popup (no firebaseapp.com)
  }

  // example: attach to click
  document.getElementById('signInBtn')?.addEventListener('click', signInWithGoogleGSI);
</script>

