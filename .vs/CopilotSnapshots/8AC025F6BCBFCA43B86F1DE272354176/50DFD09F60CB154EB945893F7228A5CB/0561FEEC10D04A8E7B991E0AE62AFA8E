  <script>
	// Client-only auth: showhide protected UI using Firebase
	window.addEventListener('load', function () {
	  if (!window.firebase || !window.firebaseConfig) {
		console.warn('Firebase not available; protected UI will remain hidden');
		return;
	  }
	  try { firebase.initializeApp(window.firebaseConfig); } catch (e) { /* already initialized */ }
	  const auth = firebase.auth();
      const bodyEl = document.body;
	  const protectedMain = document.getElementById('protected-content');
	  const loginSection = document.getElementById('login-section');
	  const userNameEl = document.getElementById('userName');
	  const signOutBtn = document.getElementById('signOutBtn');
	  const signInLink = document.getElementById('signInLink');
      const messagesLink = document.getElementById('messagesLink');
	  const topNavSearch = document.getElementById('topNavSearch');
	  const topNavMenu = document.getElementById('topNavMenu');
	  const siteSearchInput = document.getElementById('siteSearchInput');
	  const searchResultsEl = document.getElementById('searchResults');
	  const downloadPostsBtn = document.getElementById('downloadPostsBtn');
      const messagesUnreadDot = document.getElementById('messagesUnreadDot');
      const db = (firebase.firestore && typeof firebase.firestore === 'function') ? firebase.firestore() : null;
      let unreadUnsubscribe = null;

	  function clearUnreadListener() {
        if (typeof unreadUnsubscribe === 'function') {
          unreadUnsubscribe();
          unreadUnsubscribe = null;
        }
        if (messagesUnreadDot) {
          messagesUnreadDot.style.display = 'none';
          messagesUnreadDot.textContent = '';
        }
      }

      function watchUnreadMessages(uid) {
        clearUnreadListener();
        if (!db || !uid) return;
        unreadUnsubscribe = db.collection('messages').where('recipientUid', '==', uid).onSnapshot(function (snapshot) {
          let unreadCount = 0;
          snapshot.forEach(function (doc) {
            const data = doc.data() || {};
            if (data.isOpened !== true) unreadCount += 1;
          });
          if (messagesUnreadDot) {
            if (unreadCount > 0) {
              messagesUnreadDot.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
              messagesUnreadDot.style.display = 'inline-flex';
            } else {
              messagesUnreadDot.style.display = 'none';
              messagesUnreadDot.textContent = '';
            }
          }
        }, function () {
          if (messagesUnreadDot) {
            messagesUnreadDot.style.display = 'none';
            messagesUnreadDot.textContent = '';
          }
        });
      }

	  function showAuthenticated(user) {
        if (bodyEl) {
          bodyEl.classList.remove('public-view');
          bodyEl.classList.add('authenticated-view');
        }
		if (loginSection) loginSection.style.display = 'none';
		if (protectedMain) protectedMain.style.display = 'block';
		if (userNameEl) userNameEl.textContent = user.displayName || (user.email || 'Member');
		if (signOutBtn) signOutBtn.style.display = 'inline-flex';
		if (signInLink) signInLink.style.display = 'none';
        if (messagesLink) messagesLink.style.display = 'inline-flex';
    if (topNavSearch) topNavSearch.style.display = 'flex';
    if (topNavMenu) topNavMenu.style.display = 'flex';
    if (downloadPostsBtn) downloadPostsBtn.style.display = 'inline-block';
        watchUnreadMessages(user && user.uid ? user.uid : '');
	  }
	  function showSignedOut() {
        if (bodyEl) {
          bodyEl.classList.remove('authenticated-view');
          bodyEl.classList.add('public-view');
        }
		if (loginSection) loginSection.style.display = 'block';
		if (protectedMain) protectedMain.style.display = 'none';
		if (userNameEl) userNameEl.textContent = 'Member';
		if (signOutBtn) signOutBtn.style.display = 'none';
		if (signInLink) signInLink.style.display = 'inline-flex';
        if (messagesLink) messagesLink.style.display = 'none';
    if (topNavSearch) topNavSearch.style.display = 'none';
    if (topNavMenu) topNavMenu.style.display = 'none';
    if (downloadPostsBtn) downloadPostsBtn.style.display = 'none';
        clearUnreadListener();
	  }

	  auth.onAuthStateChanged(function (user) {
		if (user) showAuthenticated(user);
		else showSignedOut();
	  });

  // Protected download handler using Firebase Storage SDK so Storage Rules are enforced.
  // This will request a download URL for the path defined in your Storage Rules (Default/posts.csv).
  if (downloadPostsBtn) {
	downloadPostsBtn.addEventListener('click', async function () {
	  const user = auth.currentUser;
	  if (!user) {
		alert('Please sign in to download posts.csv');
		return;
	  }
	  try {
		if (!firebase.storage) {
		  console.error('Firebase Storage SDK not loaded');
		  alert('Download not available');
		  return;
		}
		// Storage path must match the rule path in your Storage Rules: match /Default/{allPaths=**}
		const storagePath = 'Default/posts.csv';
		const storageRef = firebase.storage().ref(storagePath);
		// getDownloadURL will succeed only if Storage Rules allow this authenticated user to read
		const url = await storageRef.getDownloadURL();
		const a = document.createElement('a');
		a.href = url;
		a.download = 'posts.csv';
		document.body.appendChild(a);
		a.click();
		a.remove();
	  } catch (err) {
		console.error('Download error', err);
		alert('Download failed: ' + (err && err.message ? err.message : 'unknown error'));
	  }
	});
  }

  // Basic client-side search (searches headings, paragraphs, articles inside main)
  function performSearch(q) {
	if (!q || q.trim().length < 2) {
	  if (searchResultsEl) searchResultsEl.style.display = 'none';
	  return;
	}
	const query = q.trim().toLowerCase();
	const candidates = document.querySelectorAll('main h1, main h2, main h3, main h4, main p, main article, main li, main a');
	const results = [];
	candidates.forEach(el => {
	  const txt = (el.textContent || '').trim();
	  if (!txt) return;
	  const idx = txt.toLowerCase().indexOf(query);
	  if (idx !== -1) {
		// find nearest heading for title
		let title = '';
		const containerArticle = el.closest('article');
		if (containerArticle) title = (containerArticle.querySelector('h3') || containerArticle.querySelector('h2') || containerArticle.querySelector('h1'))?.textContent || '';
		if (!title) title = txt.slice(0, 60);
		const snippet = txt.slice(Math.max(0, idx - 30), Math.min(txt.length, idx + 80)).replace(/\s+/g, ' ');
		results.push({ el, title, snippet });
	  }
	});

	if (!searchResultsEl) return;
	if (results.length === 0) {
	  searchResultsEl.innerHTML = '<div style="padding:12px;color:#666">No results</div>';
	  searchResultsEl.style.display = 'block';
	  return;
	}
	searchResultsEl.innerHTML = results.map((r, i) => {
	  return `<div class="sr-item" data-idx="${i}" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid #f4f6f8"><div style=\"font-weight:600;color:#092a4b;margin-bottom:6px\">${escapeHtml(r.title)}</div><div style=\"font-size:0.9rem;color:#556\">${escapeHtml(r.snippet)}</div></div>`;
	}).join('');
	searchResultsEl.style.display = 'block';

	// attach click handlers
	Array.from(searchResultsEl.querySelectorAll('.sr-item')).forEach((node, i) => {
	  node.addEventListener('click', function () {
		const target = results[i].el;
		if (target) {
		  target.scrollIntoView({ behavior: 'smooth', block: 'center' });
		  const prev = target.style.backgroundColor;
		  target.style.transition = 'background-color 0.3s ease';
		  target.style.backgroundColor = 'rgba(255,244,179,0.8)';
		  setTimeout(() => { target.style.backgroundColor = prev || ''; }, 1600);
		}
		if (searchResultsEl) searchResultsEl.style.display = 'none';
	  });
	});
  }

  function escapeHtml(s) {
	return (s||'').replace(/[&<>\"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c]; });
  }

  // wire input events
  if (siteSearchInput) {
	siteSearchInput.addEventListener('input', function (e) { performSearch(e.target.value); });
	siteSearchInput.addEventListener('keydown', function (e) { if (e.key === 'Escape') { siteSearchInput.value = ''; if (searchResultsEl) searchResultsEl.style.display = 'none'; } });
  }

  // hide on outside click
  document.addEventListener('click', function (ev) {
	const path = ev.composedPath ? ev.composedPath() : (ev.path || []);
	if (!path.length) {
	  if (siteSearchInput && (siteSearchInput.contains(ev.target) || (searchResultsEl && searchResultsEl.contains(ev.target)))) return;
	} else {
	  if (path.indexOf(siteSearchInput) !== -1 || path.indexOf(searchResultsEl) !== -1) return;
	}
	if (searchResultsEl) searchResultsEl.style.display = 'none';
  });

  if (signOutBtn) signOutBtn.addEventListener('click', function () {
	auth.signOut().then(() => {
	  showSignedOut();
	  window.location.replace('/login.html');
	});
  });
	});
</script>
