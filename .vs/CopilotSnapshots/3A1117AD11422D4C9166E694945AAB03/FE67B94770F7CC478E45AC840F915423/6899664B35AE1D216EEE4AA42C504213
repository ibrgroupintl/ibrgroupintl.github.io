		<script>
			const topicTagButtons = Array.from(document.querySelectorAll('[data-topic-tag]'));
			let insightArticles = Array.from(document.querySelectorAll('[data-insight-article]'));
			const activeTagLabel = document.getElementById('activeTagLabel');
			const topicEmptyState = document.getElementById('topicEmptyState');
			const substackFeedStatus = document.getElementById('substackFeedStatus');
			const substackFeedList = document.getElementById('substackFeedList');
			let activeTopicTag = 'all';
			let substackFeedLoaded = false;

			function normalizeTag(value) {
			return String(value || '').trim().toLowerCase();
			}

			function refreshInsightArticles() {
			insightArticles = Array.from(document.querySelectorAll('[data-insight-article]'));
			}

			function setActiveTopicTag(tag) {
			const normalized = normalizeTag(tag);
			let visibleCount = 0;
			const selectedLabel = String(tag || 'all');
			activeTopicTag = selectedLabel;
			refreshInsightArticles();

			topicTagButtons.forEach(function (button) {
			const isActive = normalizeTag(button.getAttribute('data-topic-tag')) === normalized;
			button.classList.toggle('active', isActive);
			});

			insightArticles.forEach(function (article) {
			const tags = String(article.getAttribute('data-tags') || '')
			.split(',')
			.map(normalizeTag)
			.filter(Boolean);
			const isVisible = normalized === 'all' || tags.indexOf(normalized) !== -1;
			article.style.display = isVisible ? 'block' : 'none';
			if (isVisible) visibleCount += 1;
			});

			if (activeTagLabel) {
			activeTagLabel.textContent = normalized === 'all' ? 'Showing all insights' : 'Filtered by ' + selectedLabel;
			}
			if (topicEmptyState) {
			topicEmptyState.style.display = visibleCount > 0 ? 'none' : 'block';
			}
			}

			function decodeHtmlEntities(text) {
			const temp = document.createElement('textarea');
			temp.innerHTML = String(text || '');
			return temp.value;
			}

			function getImageUrl(itemNode, contentHtml) {
			const mediaNode = itemNode.querySelector('media\\:content, content');
			if (mediaNode && mediaNode.getAttribute('url')) return mediaNode.getAttribute('url');
			const enclosureNode = itemNode.querySelector('enclosure[url]');
			if (enclosureNode && /image\//i.test(enclosureNode.getAttribute('type') || '')) {
			return enclosureNode.getAttribute('url');
			}
			const imgMatch = String(contentHtml || '').match(/<img[^>]+src=["']([^"']+)["']/i);
			return imgMatch ? imgMatch[1] : '';
			}

			function xmlRssToJson(xmlText) {
			const parser = new DOMParser();
			const xml = parser.parseFromString(xmlText, 'application/xml');
			if (xml.querySelector('parsererror')) throw new Error('Invalid RSS XML');
			const items = Array.from(xml.querySelectorAll('item')).map(function (itemNode) {
			const title = decodeHtmlEntities(itemNode.querySelector('title') ? itemNode.querySelector('title').textContent : 'Untitled');
			const link = itemNode.querySelector('link') ? itemNode.querySelector('link').textContent : '#';
			const pubDateRaw = itemNode.querySelector('pubDate') ? itemNode.querySelector('pubDate').textContent : '';
			const pubDate = new Date(pubDateRaw);
			const formattedDate = isNaN(pubDate.getTime()) ? 'Date unavailable' : new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: '2-digit' }).format(pubDate);
			const descriptionRaw = itemNode.querySelector('description') ? itemNode.querySelector('description').textContent : '';
			const contentEncodedNode = itemNode.querySelector('content\\:encoded, encoded');
			const contentHtml = contentEncodedNode ? contentEncodedNode.textContent : descriptionRaw;
			const plainSnippet = decodeHtmlEntities(String(contentHtml || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim()).slice(0, 240);
			const categories = Array.from(itemNode.querySelectorAll('category')).map(function (cat) {
			return decodeHtmlEntities(cat.textContent).trim();
			}).filter(Boolean);
			const imageUrl = getImageUrl(itemNode, contentHtml);
			return {
				title: title,
				link: link,
				date: formattedDate,
				timestamp: isNaN(pubDate.getTime()) ? 0 : pubDate.getTime(),
				tags: categories,
				imageUrl: imageUrl,
				snippet: plainSnippet
			};
			});
			return { source: 'substack.ibrecruitment.com', items: items };
			}

			async function fetchSubstackRssText() {
			const feedUrl = 'https://substack.ibrecruitment.com/feed';
			const urls = [
				feedUrl,
				'https://api.allorigins.win/raw?url=' + encodeURIComponent(feedUrl)
			];
			for (let i = 0; i < urls.length; i += 1) {
				try {
					const response = await fetch(urls[i], { cache: 'no-store' });
					if (!response.ok) continue;
					const text = await response.text();
					if (text && text.indexOf('<rss') !== -1) return text;
				} catch (e) { }
			}
			throw new Error('Unable to fetch RSS feed');
			}

			function renderSubstackFeed(feedJson) {
			if (!substackFeedList || !substackFeedStatus) return;
			const posts = (feedJson && Array.isArray(feedJson.items) ? feedJson.items : []).sort(function (a, b) {
			return (b.timestamp || 0) - (a.timestamp || 0);
			}).slice(0, 8);
			if (!posts.length) {
				substackFeedStatus.textContent = 'No recent posts available.';
				substackFeedList.innerHTML = '';
				return;
			}
			substackFeedStatus.textContent = posts.length + ' latest posts loaded from Substack.';
			substackFeedList.innerHTML = posts.map(function (post) {
				const tags = post.tags && post.tags.length ? post.tags : ['Insights'];
				const safeTags = tags.map(function (tag) { return String(tag).replace(/"/g, '&quot;'); });
				const tagHtml = safeTags.map(function (tag) {
					const isPriority = ['esg', 'energy', 'real estate'].indexOf(normalizeTag(tag)) !== -1;
					return '<span class="insight-tag' + (isPriority ? ' priority' : '') + '">' + tag + '</span>';
				}).join('');
				const imageHtml = post.imageUrl ? '<img src="' + post.imageUrl + '" alt="' + post.title.replace(/"/g, '&quot;') + '" class="substack-image">' : '';
				return '<article data-insight-article="true" data-tags="' + safeTags.join(',') + '" style="background:#f8f9fa;padding:20px;border-radius:8px">' +
					imageHtml +
					'<h2 style="margin-top:0">' + post.title + '</h2>' +
					'<p class="substack-meta">Published: ' + post.date + ' | Substack</p>' +
					'<div class="insight-tags">' + tagHtml + '</div>' +
					'<p class="substack-snippet">' + (post.snippet || 'Read the full article for details.') + '</p>' +
					'<a href="' + post.link + '" target="_blank" rel="noopener noreferrer" class="resource-cta" style="display:inline-block">Read More</a>' +
				'</article>';
			}).join('');
			window.substackFeedJson = feedJson;
			setActiveTopicTag(activeTopicTag || 'all');
			}

			async function loadSubstackFeed() {
			if (substackFeedLoaded) return;
			substackFeedLoaded = true;
			if (substackFeedStatus) substackFeedStatus.textContent = 'Loading latest posts...';
			try {
				const rssText = await fetchSubstackRssText();
				const feedJson = xmlRssToJson(rssText);
				renderSubstackFeed(feedJson);
			} catch (err) {
				if (substackFeedStatus) {
					substackFeedStatus.textContent = 'Unable to load Substack feed right now. Please try again later.';
				}
				if (substackFeedList) substackFeedList.innerHTML = '';
			}
			}

			topicTagButtons.forEach(function (button) {
			button.addEventListener('click', function () {
			setActiveTopicTag(button.getAttribute('data-topic-tag') || 'all');
			});
			});
			setActiveTopicTag('all');
		</script>
	</body>
