<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0b1220" />
  <meta name="robots" content="index, follow" />
  <title>Subscribe — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/index.css" />
  <link rel="stylesheet" href="/mobile-compat.css" />
  <style>
    :root {
      --bg: #060b17;
      --surface: #0f1c33;
      --line: #2b3f62;
      --text: #fff;
      --muted: #fff;
      --shadow: 0 18px 40px rgba(2, 8, 23, 0.35);
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      font-family: 'Open Sans', Arial, sans-serif;
      color: #fff;
      background: radial-gradient(1200px 700px at 85% -15%, rgba(47,123,255,.35), transparent 55%),
                  radial-gradient(900px 520px at -5% 18%, rgba(0,183,255,.2), transparent 55%),
                  var(--bg);
    }

    .container {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
    }

    .page-shell {
      padding: 2rem 0 2.5rem;
    }

    .top-links {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .top-links a {
      color: #fff;
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 8px 12px;
      background: rgba(255,255,255,0.03);
      font-weight: 700;
    }

    .panel {
      border: 1px solid var(--line);
      border-radius: 18px;
      background: linear-gradient(160deg, rgba(12,23,43,.98), rgba(9,17,34,.98));
      box-shadow: var(--shadow);
      padding: 1rem;
      color: #fff;
    }

    h1 {
      margin: 0 0 0.5rem;
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      color: #fff;
      text-align: center;
    }

    .lead {
      margin: 0 0 1rem;
      color: #facc15 !important;
      text-align: center;
    }

    .site-footer {
      padding: 1rem 0 1.5rem;
      text-align: center;
      color: #fff;
    }
  </style>
</head>
<body>
  <main class="container page-shell" role="main">
    <div class="top-links">
	  <a href="/index.html">Home</a>
      <a href="/members.html">Members Area</a>
    </div>

    <section class="panel" aria-labelledby="subscribeHeading">
      <h1 id="subscribeHeading">Choose Your Subscription</h1>
      <p class="lead">Select the plan that best matches your access needs.</p>

      <script async src="https://js.stripe.com/v3/pricing-table.js"></script>
      <stripe-pricing-table pricing-table-id="prctbl_1TIk96IZSvVNdV4d07lAPwGT"
      publishable-key="pk_live_51IC6ReIZSvVNdV4dVhLOdnhfuSHXP0vZ9GlvIbGqTEPGzc1ywN5t9IphIUbFXEoQD8QMnRYgY7LEelyJBCb7E7T000hnIoomYV">
      </stripe-pricing-table>
    </section>
  </main>

  <footer class="site-footer" role="contentinfo">
    <p style="margin:0;">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
  </footer>
</body>
</html>
