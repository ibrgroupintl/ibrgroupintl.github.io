  <script>
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) {
        console.warn('Firebase not available; protected UI will remain hidden');
        return;
      }
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) { }

      const auth = firebase.auth();
      const db = (firebase.firestore && typeof firebase.firestore === 'function') ? firebase.firestore() : null;
      const protectedMain = document.getElementById('protected-content');
      const loginSection = document.getElementById('login-section');
      const signOutBtn = document.getElementById('signOutBtn');
      const deleteAccountBtn = document.getElementById('deleteAccountBtn');
      const signInLink = document.getElementById('signInLink');
      const messagesLink = document.getElementById('messagesLink');
      const messagesUnreadDot = document.getElementById('messagesUnreadDot');
      const topNavMenu = document.getElementById('topNavMenu');
      const topNavSearch = document.getElementById('topNavSearch');
      const userNameEl = document.getElementById('userName');
      const loginStatus = document.getElementById('google-login-status');
      const siteSearchInput = document.getElementById('siteSearchInput');
      const searchResultsEl = document.getElementById('searchResults');

      const settingsUserName = document.getElementById('settingsUserName');
      const settingsUserEmail = document.getElementById('settingsUserEmail');
      const settingsUserId = document.getElementById('settingsUserId');
      const settingsLastLogin = document.getElementById('settingsLastLogin');

      const USER_ID_PREFIX = 'IB';
      const USER_ID_TOTAL_LENGTH = 8;
      const USER_ID_SUFFIX_LENGTH = USER_ID_TOTAL_LENGTH - USER_ID_PREFIX.length;
      let unreadUnsubscribe = null;

      function clearUnreadListener() {
        if (typeof unreadUnsubscribe === 'function') {
          unreadUnsubscribe();
          unreadUnsubscribe = null;
        }
        if (messagesUnreadDot) {
          messagesUnreadDot.style.display = 'none';
          messagesUnreadDot.textContent = '';
        }
      }

      function watchUnreadMessages(uid) {
        clearUnreadListener();
        if (!db || !uid) return;
        unreadUnsubscribe = db.collection('messages').where('recipientUid', '==', uid).onSnapshot(function (snapshot) {
          let unreadCount = 0;
          snapshot.forEach(function (doc) {
            const data = doc.data() || {};
            if (data.isOpened !== true) unreadCount += 1;
          });
          if (messagesUnreadDot) {
            if (unreadCount > 0) {
              messagesUnreadDot.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
              messagesUnreadDot.style.display = 'inline-flex';
            } else {
              messagesUnreadDot.style.display = 'none';
              messagesUnreadDot.textContent = '';
            }
          }
        }, function () {
          if (messagesUnreadDot) {
            messagesUnreadDot.style.display = 'none';
            messagesUnreadDot.textContent = '';
          }
        });
      }

      const toBase36Padded = (num, len) => (num >>> 0).toString(36).toUpperCase().padStart(len, '0').slice(-len);

      function generateDeterministicUserId(uid, salt) {
        if (!uid) return 'IB000000';
        const input = String(uid) + '|' + String(salt || 0) + '|IBR';
        let hash = 2166136261;
        for (let i = 0; i < input.length; i++) {
          hash ^= input.charCodeAt(i);
          hash = Math.imul(hash, 16777619);
        }
        return USER_ID_PREFIX + toBase36Padded(hash, USER_ID_SUFFIX_LENGTH);
      }

      async function createUniqueUserIdForUser(user) {
        const deterministicFallback = generateDeterministicUserId(user && user.uid, 0);
        if (!db) {
          return deterministicFallback;
        }

        const profileRef = db.collection('userProfiles').doc(user.uid);

        for (let attempt = 0; attempt < 200; attempt++) {
          const candidate = generateDeterministicUserId(user.uid, attempt);
          const candidateRef = db.collection('userIds').doc(candidate);

          try {
            const assigned = await db.runTransaction(async function (tx) {
              const profileSnap = await tx.get(profileRef);
              if (profileSnap.exists) {
                const existing = profileSnap.data() && profileSnap.data().userId;
                if (existing && typeof existing === 'string') {
                  return existing.toUpperCase();
                }
              }

              const candidateSnap = await tx.get(candidateRef);
              if (candidateSnap.exists) {
                const data = candidateSnap.data() || {};
                if (data.uid !== user.uid) {
                  throw new Error('collision');
                }
              }

              tx.set(candidateRef, {
                uid: user.uid,
                email: user.email || '',
                updatedAt: firebase.firestore.FieldValue.serverTimestamp()
              }, { merge: true });

              tx.set(profileRef, {
                userId: candidate,
                email: user.email || '',
                updatedAt: firebase.firestore.FieldValue.serverTimestamp()
              }, { merge: true });

              return candidate;
            });

            if (assigned) return assigned.toUpperCase();
          } catch (err) {
            if (err && err.message === 'collision') continue;
            throw err;
          }
        }

        return deterministicFallback;
      }

      async function getOrCreateUserId(user) {
        const deterministicFallback = generateDeterministicUserId(user && user.uid, 0);
        if (!db) {
          return deterministicFallback;
        }

        const profileRef = db.collection('userProfiles').doc(user.uid);
        const profileSnap = await profileRef.get();

        if (profileSnap.exists) {
          const data = profileSnap.data() || {};
          if (data.userId && typeof data.userId === 'string') {
            return data.userId.toUpperCase();
          }
        }

        return createUniqueUserIdForUser(user);
      }

      function formatLastLoginLondon(lastSignInTime) {
        if (!lastSignInTime) return 'Not available';
        const date = new Date(lastSignInTime);
        if (isNaN(date.getTime())) return String(lastSignInTime);
        return new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          year: 'numeric',
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
          timeZoneName: 'short'
        }).format(date);
      }

      function setAccountDetails(user) {
        if (settingsUserName) settingsUserName.textContent = user.displayName || 'Not set';
        if (settingsUserEmail) settingsUserEmail.textContent = user.email || 'Not available';
        if (settingsLastLogin) settingsLastLogin.textContent = formatLastLoginLondon(user.metadata && user.metadata.lastSignInTime);
      }

      async function loadUserId(user) {
        if (settingsUserId) settingsUserId.textContent = 'Generating...';
        try {
          const userId = await getOrCreateUserId(user);
          if (settingsUserId) settingsUserId.textContent = userId;
          return userId;
        } catch (err) {
          console.error('User ID load failed', err);
          const fallbackId = generateDeterministicUserId(user && user.uid, 0);
          if (settingsUserId) settingsUserId.textContent = fallbackId;
          return fallbackId;
        }
      }

      async function showAuthenticated(user) {
        if (loginSection) loginSection.style.display = 'none';
        if (protectedMain) protectedMain.style.display = 'block';
        if (userNameEl) userNameEl.textContent = user.displayName || user.email || 'Member';
        if (signOutBtn) signOutBtn.style.display = 'inline-flex';
        if (signInLink) signInLink.style.display = 'none';
        if (messagesLink) messagesLink.style.display = 'inline-flex';
        if (topNavMenu) topNavMenu.style.display = 'block';
        if (topNavSearch) topNavSearch.style.display = 'flex';
        document.body.classList.remove('auth-pending');
        document.body.classList.add('has-sidebar');
        if (loginStatus) loginStatus.textContent = 'Signed in';
        setAccountDetails(user);
        await loadUserId(user);
        watchUnreadMessages(user && user.uid ? user.uid : '');
      }

      function showSignedOut() {
        if (loginSection) loginSection.style.display = 'block';
        if (protectedMain) protectedMain.style.display = 'none';
        if (userNameEl) userNameEl.textContent = 'Member';
        if (signOutBtn) signOutBtn.style.display = 'none';
        if (signInLink) signInLink.style.display = 'inline-flex';
        if (messagesLink) messagesLink.style.display = 'none';
        if (topNavSearch) topNavSearch.style.display = 'none';
        if (topNavMenu) topNavMenu.style.display = 'none';
        document.body.classList.remove('auth-pending');
        document.body.classList.remove('has-sidebar');
        if (loginStatus) loginStatus.textContent = 'Not signed in';
        if (settingsUserName) settingsUserName.textContent = '-';
        if (settingsUserEmail) settingsUserEmail.textContent = '-';
        if (settingsUserId) settingsUserId.textContent = '-';
        if (settingsLastLogin) settingsLastLogin.textContent = '-';
        clearUnreadListener();
      }

      auth.onAuthStateChanged(async function (user) {
        if (user) {
          try {
            await showAuthenticated(user);
          } catch (err) {
            console.error('Failed to load account details', err);
            showSignedOut();
          }
        } else {
          showSignedOut();
        }
      });

      if (signOutBtn) {
        signOutBtn.addEventListener('click', function () {
          auth.signOut().then(function () {
            showSignedOut();
            window.location.replace('/login.html');
          });
        });
      }

      if (deleteAccountBtn) {
        deleteAccountBtn.addEventListener('click', async function () {
          const user = auth.currentUser;
          if (!user) {
            alert('Please sign in first.');
            return;
          }
          const confirmed = window.confirm('Are you sure you want to permanently delete your account? This cannot be undone.');
          if (!confirmed) return;
          try {
            await user.delete();
            alert('Your account has been deleted.');
            window.location.replace('/login.html');
          } catch (err) {
            if (err && err.code === 'auth/requires-recent-login') {
              try {
                const provider = new firebase.auth.GoogleAuthProvider();
                await user.reauthenticateWithPopup(provider);
                await user.delete();
                alert('Your account has been deleted.');
                window.location.replace('/login.html');
              } catch (reauthErr) {
                console.error('Re-auth or delete失败', reauthErr);
                alert('Account deletion failed: ' + (reauthErr && reauthErr.message ? reauthErr.message : 'unknown error'));
              }
            } else {
              console.error('Delete account failed', err);
              alert('Account deletion failed: ' + (err && err.message ? err.message : 'unknown error'));
            }
          }
        });
      }

      function performSearch(queryText) {
        if (!queryText || queryText.trim().length < 2) {
          if (searchResultsEl) searchResultsEl.style.display = 'none';
          return;
        }

        const query = queryText.trim().toLowerCase();
        const candidates = document.querySelectorAll('main h1, main h2, main p, main div');
        const results = [];

        candidates.forEach(function (el) {
          const text = (el.textContent || '').trim();
          if (!text) return;
          const idx = text.toLowerCase().indexOf(query);
          if (idx === -1) return;
          results.push({ el: el, title: text.slice(0, 60), snippet: text.slice(Math.max(0, idx - 20), Math.min(text.length, idx + 80)) });
        });

        if (!searchResultsEl) return;
        if (results.length === 0) {
          searchResultsEl.innerHTML = '<div style="padding:12px;color:#666">No results</div>';
          searchResultsEl.style.display = 'block';
          return;
        }

        searchResultsEl.innerHTML = results.slice(0, 8).map(function (r, i) {
          return '<div class="sr-item" data-idx="' + i + '" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid #f4f6f8"><div style="font-weight:600;color:#092a4b;margin-bottom:6px">' + r.title + '</div><div style="font-size:0.9rem;color:#556">' + r.snippet + '</div></div>';
        }).join('');
        searchResultsEl.style.display = 'block';

        Array.from(searchResultsEl.querySelectorAll('.sr-item')).forEach(function (node, i) {
          node.addEventListener('click', function () {
            const target = results[i].el;
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            searchResultsEl.style.display = 'none';
          });
        });
      }

      if (siteSearchInput) {
        siteSearchInput.addEventListener('input', function (e) { performSearch(e.target.value); });
      }

      document.addEventListener('click', function (ev) {
        if (!searchResultsEl || !siteSearchInput) return;
        if (ev.target === siteSearchInput || searchResultsEl.contains(ev.target)) return;
        searchResultsEl.style.display = 'none';
      });
    });
  </script>
