					<p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
				</div>
			</div>
		</footer>

		<!-- Firebase SDKs -->
		<script defer="" src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
		<script defer="" src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
		<script defer="" src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
		<script defer="" src="/firebase-config.js"></script>
		<script defer="" src="/header-profile.js"></script>
		<script defer="" src="/mobile-compat.js"></script>
		<script defer="" src="/page-transition.js"></script>

		<script>
			// Client-only auth: show/hide protected UI using Firebase
			window.addEventListener('load', function () {
			if (!window.firebase || !window.firebaseConfig) {
			console.warn('Firebase not available; protected UI will remain hidden');
			return;
			}
			try { firebase.initializeApp(window.firebaseConfig); } catch (e) { /* already initialized */ }

			const auth = firebase.auth();
			const protectedContent = document.getElementById('protected-content');
			const loginSection = document.getElementById('login-section');
			const userNameEl = document.getElementById('userName');
			const signOutBtn = document.getElementById('signOutBtn');
			const signInLink = document.getElementById('signInLink');
			const messagesLink = document.getElementById('messagesLink');
			const messagesUnreadDot = document.getElementById('messagesUnreadDot');
			const topNavMenu = document.getElementById('topNavMenu');
			const topNavSearch = document.getElementById('topNavSearch');
			const db = (firebase.firestore && typeof firebase.firestore === 'function') ? firebase.firestore() : null;
			let unreadUnsubscribe = null;

			const topicTagButtons = Array.from(document.querySelectorAll('[data-topic-tag]'));
			const insightArticles = Array.from(document.querySelectorAll('[data-insight-article]'));
			const activeTagLabel = document.getElementById('activeTagLabel');
			const topicEmptyState = document.getElementById('topicEmptyState');

			function normalizeTag(value) {
			return String(value || '').trim().toLowerCase();
			}

			function setActiveTopicTag(tag) {
			const normalized = normalizeTag(tag);
			let visibleCount = 0;
			const selectedLabel = String(tag || 'all');

			topicTagButtons.forEach(function (button) {
			const isActive = normalizeTag(button.getAttribute('data-topic-tag')) === normalized;
			button.classList.toggle('active', isActive);
			});

			insightArticles.forEach(function (article) {
			const tags = String(article.getAttribute('data-tags') || '')
			.split(',')
			.map(normalizeTag)
			.filter(Boolean);
			const isVisible = normalized === 'all' || tags.indexOf(normalized) !== -1;
			article.style.display = isVisible ? 'block' : 'none';
			if (isVisible) visibleCount += 1;
			});

			if (activeTagLabel) {
			activeTagLabel.textContent = normalized === 'all' ? 'Showing all insights' : 'Filtered by ' + selectedLabel;
			}
			if (topicEmptyState) {
			topicEmptyState.style.display = visibleCount > 0 ? 'none' : 'block';
			}
			}

			topicTagButtons.forEach(function (button) {
			button.addEventListener('click', function () {
			setActiveTopicTag(button.getAttribute('data-topic-tag') || 'all');
			});
			});
			setActiveTopicTag('all');

			function clearUnreadListener() {
			if (typeof unreadUnsubscribe === 'function') {
			unreadUnsubscribe();
			unreadUnsubscribe = null;
			}
			if (messagesUnreadDot) {
			messagesUnreadDot.style.display = 'none';
			messagesUnreadDot.textContent = '';
			}
			}

			function watchUnreadMessages(uid) {
			clearUnreadListener();
			if (!db || !uid) return;
			unreadUnsubscribe = db.collection('messages').where('recipientUid', '==', uid).onSnapshot(function (snapshot) {
			let unreadCount = 0;
			snapshot.forEach(function (doc) {
			const data = doc.data() || {};
			if (data.isOpened !== true) unreadCount += 1;
			});
			if (messagesUnreadDot) {
			if (unreadCount > 0) {
			messagesUnreadDot.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
			messagesUnreadDot.style.display = 'inline-flex';
			} else {
			messagesUnreadDot.style.display = 'none';
			messagesUnreadDot.textContent = '';
			}
			}
			}, function () {
			if (messagesUnreadDot) {
			messagesUnreadDot.style.display = 'none';
			messagesUnreadDot.textContent = '';
			}
			});
			}

			function showAuthenticated(user) {
			if (loginSection) loginSection.style.display = 'none';
			if (protectedContent) protectedContent.style.display = 'block';
			if (userNameEl) userNameEl.textContent = user.displayName || (user.email || 'Member');
			if (signOutBtn) signOutBtn.style.display = 'inline-flex';
			if (signInLink) signInLink.style.display = 'none';
			if (messagesLink) messagesLink.style.display = 'inline-flex';
			if (topNavMenu) topNavMenu.style.display = 'block';
			if (topNavSearch) topNavSearch.style.display = 'flex';
			document.body.classList.remove('auth-pending');
			document.body.classList.add('has-sidebar');
			watchUnreadMessages(user && user.uid ? user.uid : '');
			}

			function showSignedOut() {
			if (loginSection) loginSection.style.display = 'block';
			if (protectedContent) protectedContent.style.display = 'none';
			if (signOutBtn) signOutBtn.style.display = 'none';
			if (signInLink) signInLink.style.display = 'inline-flex';
			if (messagesLink) messagesLink.style.display = 'none';
			if (topNavMenu) topNavMenu.style.display = 'none';
			if (topNavSearch) topNavSearch.style.display = 'none';
			document.body.classList.remove('auth-pending');
			document.body.classList.remove('has-sidebar');
			clearUnreadListener();
			}

			auth.onAuthStateChanged(function (user) {
			if (user) showAuthenticated(user);
			else showSignedOut();
			});

			if (signOutBtn) {
			signOutBtn.addEventListener('click', function () {
			auth.signOut().then(() => {
			showSignedOut();
			window.location.replace('/login.html');
			});
			});
			}
			});
		</script>
	</body>
</html>