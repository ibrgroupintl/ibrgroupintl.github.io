    .topic-tags-panel { margin-top:1.5rem; padding:1rem 1.25rem; background:#f8f9fa; border:1px solid #e5e7eb; border-radius:10px; }
    .topic-tag-filters { display:flex; flex-wrap:wrap; gap:10px; margin-top:.9rem; }
    .topic-tag-btn { border:1px solid #c7d2fe; background:#eef2ff; color:#092a4b; padding:8px 12px; border-radius:999px; font-weight:600; font-size:.92rem; cursor:pointer; transition:background-color .2s ease,border-color .2s ease,color .2s ease; }
    .topic-tag-btn:hover,.topic-tag-btn:focus,.topic-tag-btn.active { background:#092a4b; border-color:#092a4b; color:#fff; }
    .topic-tag-btn.priority { border-color:#afb8e9; background:#afb8e9; color:#000; }

    .insight-tags { display:flex; flex-wrap:wrap; gap:8px; margin:.85rem 0 .95rem; }
    .insight-tag { display:inline-flex; align-items:center; padding:4px 10px; border-radius:999px; background:#e8edf7; color:#092a4b; font-size:.82rem; font-weight:700; letter-spacing:.01em; }
    .insight-tag.priority { background:#dbeafe; color:#0f3d63; }
    .topic-empty-state { display:none; margin-top:1rem; padding:1rem 1.1rem; border-radius:8px; background:#fff7ed; color:#7c2d12; border:1px solid #fed7aa; font-size:.95rem; }

    .substack-feed-panel { margin-top:1.5rem; padding:1rem 1.25rem; background:#f8fbff; border:1px solid #dbe3ee; border-radius:10px; }
    .substack-feed-status { font-size:.92rem; color:var(--muted); margin-bottom:.85rem; }
    .substack-feed-list { display:grid; gap:14px; }
    .substack-image { width:100%; max-height:320px; object-fit:cover; border-radius:8px; margin-bottom:.9rem; border:1px solid #dbe3ee; }
    .substack-snippet { margin-top:.8rem; color:#334155; font-size:.94rem; line-height:1.45; }
    .substack-meta { color:var(--muted); font-size:.92rem; margin-bottom:.25rem; }

    .message-icon-link { width:42px; height:42px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; border:1px solid #c7d2fe; background:#eef2ff; color:#092a4b; text-decoration:none; position:relative; flex:0 0 auto; }
    .message-icon-link:hover,.message-icon-link:focus { background:#092a4b; border-color:#092a4b; color:#fff; }
    .message-unread-dot { position:absolute; top:2px; right:2px; min-width:16px; height:16px; padding:0 4px; border-radius:999px; background:#22c55e; color:#fff; border:2px solid #fff; box-shadow:0 0 0 1px rgba(2,42,75,.12); display:none; pointer-events:none; font-size:10px; font-weight:700; line-height:12px; align-items:center; justify-content:center; text-align:center; }

    @media (max-width:980px) {
      .sidebar-menu-shell { position:static; width:100%; max-width:900px; margin:12px auto; }
      body.has-sidebar #protected-content { margin-left:0; }
    }
