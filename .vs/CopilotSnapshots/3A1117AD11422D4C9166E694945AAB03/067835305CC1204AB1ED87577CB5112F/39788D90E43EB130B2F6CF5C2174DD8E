  <script>
    window.addEventListener('load', function () {
      const protectedContent = document.getElementById('protected-content');
      const loginSection = document.getElementById('login-section');
      const userNameEl = document.getElementById('userName');
      const signOutBtn = document.getElementById('signOutBtn');
      const signInLink = document.getElementById('signInLink');
      const messagesLink = document.getElementById('messagesLink');
      const messagesUnreadDot = document.getElementById('messagesUnreadDot');
      const topNavMenu = document.getElementById('topNavMenu');
      const topNavSearch = document.getElementById('topNavSearch');
      const topicTagButtons = Array.from(document.querySelectorAll('[data-topic-tag]'));
      const activeTagLabel = document.getElementById('activeTagLabel');
      const topicEmptyState = document.getElementById('topicEmptyState');
      const substackFeedStatus = document.getElementById('substackFeedStatus');
      const substackFeedList = document.getElementById('substackFeedList');
      let insightArticles = Array.from(document.querySelectorAll('[data-insight-article]'));
      let unreadUnsubscribe = null;
      let activeTopicTag = 'all';
      let substackFeedLoaded = false;
      const db = (window.firebase && firebase.firestore && typeof firebase.firestore === 'function') ? firebase.firestore() : null;

      function normalizeTag(value) { return String(value || '').trim().toLowerCase(); }
      function refreshInsightArticles() { insightArticles = Array.from(document.querySelectorAll('[data-insight-article]')); }

      function setActiveTopicTag(tag) {
        activeTopicTag = String(tag || 'all');
        const normalized = normalizeTag(activeTopicTag);
        let visibleCount = 0;
        refreshInsightArticles();
        topicTagButtons.forEach(function (button) {
          button.classList.toggle('active', normalizeTag(button.getAttribute('data-topic-tag')) === normalized);
        });
        insightArticles.forEach(function (article) {
          const tags = String(article.getAttribute('data-tags') || '').split(',').map(normalizeTag).filter(Boolean);
          const isVisible = normalized === 'all' || tags.indexOf(normalized) !== -1;
          article.style.display = isVisible ? 'block' : 'none';
          if (isVisible) visibleCount += 1;
        });
        if (activeTagLabel) activeTagLabel.textContent = normalized === 'all' ? 'Showing all insights' : 'Filtered by ' + activeTopicTag;
        if (topicEmptyState) topicEmptyState.style.display = visibleCount > 0 ? 'none' : 'block';
      }

      function clearUnreadListener() {
        if (typeof unreadUnsubscribe === 'function') { unreadUnsubscribe(); unreadUnsubscribe = null; }
        if (messagesUnreadDot) { messagesUnreadDot.style.display = 'none'; messagesUnreadDot.textContent = ''; }
      }

      function watchUnreadMessages(uid) {
        clearUnreadListener();
        if (!db || !uid) return;
        unreadUnsubscribe = db.collection('messages').where('recipientUid', '==', uid).onSnapshot(function (snapshot) {
          let unreadCount = 0;
          snapshot.forEach(function (doc) { const data = doc.data() || {}; if (data.isOpened !== true) unreadCount += 1; });
          if (messagesUnreadDot) {
            if (unreadCount > 0) { messagesUnreadDot.textContent = unreadCount > 99 ? '99+' : String(unreadCount); messagesUnreadDot.style.display = 'inline-flex'; }
            else { messagesUnreadDot.style.display = 'none'; messagesUnreadDot.textContent = ''; }
          }
        });
      }

      function decodeHtmlEntities(text) { const t = document.createElement('textarea'); t.innerHTML = String(text || ''); return t.value; }
      function escapeHtml(text) { return String(text || '').replace(/[&<>"']/g, function (ch) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]; }); }

      function stripHtml(text) {
        return decodeHtmlEntities(String(text || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim());
      }

      function normalizePostTags(post) {
        const rawTags = [];
        if (Array.isArray(post.postTags)) rawTags.push.apply(rawTags, post.postTags);
        if (Array.isArray(post.tags)) rawTags.push.apply(rawTags, post.tags);
        if (Array.isArray(post.podcastTags)) rawTags.push.apply(rawTags, post.podcastTags);

        const parsed = rawTags.map(function (tag) {
          if (!tag) return '';
          if (typeof tag === 'string') return tag;
          return tag.name || tag.label || tag.slug || '';
        }).map(function (x) { return String(x || '').trim(); }).filter(Boolean);

        if (parsed.length) return parsed;

        const fallback = [];
        const audience = String(post.audience || '').toLowerCase();
        if (audience === 'only_paid') fallback.push('Paid');
        if (audience === 'everyone') fallback.push('Public');
        return fallback.length ? fallback : ['Insights'];
      }

      function isApprovedSubstackPost(post) {
        if (!post) return false;
        const title = String(post.title || '').trim();
        if (!title) return false;

        const rawUrl = String(post.canonical_url || post.canonicalUrl || '');
        const slug = String(post.slug || '').trim();
        const link = rawUrl || (slug ? ('https://substack.ibrecruitment.com/p/' + slug) : '');
        if (!link) return false;

        try {
          const urlObj = new URL(link);
          const isTrustedHost = urlObj.hostname === 'substack.ibrecruitment.com' || urlObj.hostname.endsWith('.substack.com');
          if (!isTrustedHost) return false;
        } catch (e) {
          return false;
        }

        const postType = String(post.type || '').toLowerCase();
        if (postType && ['newsletter', 'podcast'].indexOf(postType) === -1) return false;

        return true;
      }

      function substackArchiveToJson(payload) {
        const posts = Array.isArray(payload) ? payload : (Array.isArray(payload.posts) ? payload.posts : []);
        const approvedPosts = posts.filter(isApprovedSubstackPost);
        const items = approvedPosts.map(function (post) {
          const postDateRaw = post.post_date || post.published_at || post.publishedAt || '';
          const postDate = new Date(postDateRaw);
          const formattedDate = isNaN(postDate.getTime()) ? 'Date unavailable' : new Intl.DateTimeFormat('en-GB', { year:'numeric', month:'long', day:'2-digit' }).format(postDate);
          const bodySource = post.description || post.subtitle || post.body_html || post.search_engine_description || '';
          const snippet = stripHtml(bodySource).slice(0, 240);
          const title = decodeHtmlEntities(post.title || 'Untitled');
          const slug = post.slug ? String(post.slug) : '';
          const canonicalUrl = post.canonical_url || post.canonicalUrl || (slug ? ('https://substack.ibrecruitment.com/p/' + slug) : 'https://substack.ibrecruitment.com');
          const imageUrl = post.cover_image || post.coverImage || post.social_image || post.image || '';
          return {
            title: title,
            link: canonicalUrl,
            date: formattedDate,
            timestamp: isNaN(postDate.getTime()) ? 0 : postDate.getTime(),
            tags: normalizePostTags(post),
            imageUrl: imageUrl,
            snippet: snippet
          };
        });
        return { source: 'substack.ibrecruitment.com/api/v1/archive', items: items };
      }

      async function fetchSubstackArchiveJson() {
        const endpoint = 'https://substack.ibrecruitment.com/api/v1/archive?sort=new';
        const response = await fetch(endpoint, { cache: 'no-store', headers: { 'Accept': 'application/json' } });
        if (!response.ok) throw new Error('Substack API request failed');
        return response.json();
      }

      function renderSubstackFeed(feedJson) {
        if (!substackFeedList || !substackFeedStatus) return;
        const posts = (feedJson && Array.isArray(feedJson.items) ? feedJson.items : []).sort(function (a, b) { return (b.timestamp || 0) - (a.timestamp || 0); }).slice(0, 8);
        if (!posts.length) {
          substackFeedStatus.textContent = 'No approved posts available right now.';
          substackFeedList.innerHTML = '';
          return;
        }
        substackFeedStatus.textContent = posts.length + ' approved posts loaded from Substack API.';
        substackFeedList.innerHTML = posts.map(function (post) {
          const tags = post.tags && post.tags.length ? post.tags : ['Insights'];
          const safeTags = tags.map(function (tag) { return escapeHtml(tag); });
          const tagHtml = safeTags.map(function (tag) {
            const p = ['esg','energy','real estate'].indexOf(normalizeTag(tag)) !== -1;
            return '<span class="insight-tag' + (p ? ' priority' : '') + '">' + tag + '</span>';
          }).join('');
          const imageHtml = post.imageUrl ? '<img src="' + escapeHtml(post.imageUrl) + '" alt="' + escapeHtml(post.title) + '" class="substack-image">' : '';
          return '<article data-insight-article="true" data-tags="' + safeTags.join(',') + '" style="background:#f8f9fa;padding:20px;border-radius:8px">' +
            imageHtml +
            '<h2 style="margin-top:0">' + escapeHtml(post.title) + '</h2>' +
            '<p class="substack-meta">Published: ' + escapeHtml(post.date) + ' | Substack</p>' +
            '<div class="insight-tags">' + tagHtml + '</div>' +
            '<p class="substack-snippet">' + escapeHtml(post.snippet || 'Read the full article for details.') + '</p>' +
            '<a href="' + escapeHtml(post.link) + '" target="_blank" rel="noopener noreferrer" class="resource-cta" style="display:inline-block">Read More</a>' +
          '</article>';
        }).join('');
        window.substackFeedJson = feedJson;
        setActiveTopicTag(activeTopicTag || 'all');
      }

      async function loadSubstackFeed() {
        if (!auth || !auth.currentUser) {
          if (substackFeedStatus) substackFeedStatus.textContent = 'Sign in to load the latest embedded insights feed.';
          return;
        }
        if (substackFeedLoaded) return;
        substackFeedLoaded = true;
        if (substackFeedStatus) substackFeedStatus.textContent = 'Loading latest posts...';
        try {
          const payload = await fetchSubstackArchiveJson();
          renderSubstackFeed(substackArchiveToJson(payload));
        } catch (e) {
          if (substackFeedStatus) substackFeedStatus.textContent = 'Unable to load Substack feed right now. Please try again later.';
          if (substackFeedList) substackFeedList.innerHTML = '';
        }
      }

      function showAuthenticated(user) {
        if (loginSection) loginSection.style.display = 'none';
        if (protectedContent) protectedContent.style.display = 'block';
        if (userNameEl) userNameEl.textContent = user.displayName || (user.email || 'Member');
        if (signOutBtn) signOutBtn.style.display = 'inline-flex';
        if (signInLink) signInLink.style.display = 'none';
        if (messagesLink) messagesLink.style.display = 'inline-flex';
        if (topNavMenu) topNavMenu.style.display = 'block';
        if (topNavSearch) topNavSearch.style.display = 'flex';
        document.body.classList.remove('auth-pending');
        document.body.classList.add('has-sidebar');
        watchUnreadMessages(user && user.uid ? user.uid : '');
        loadSubstackFeed();
      }

      function showSignedOut() {
        if (loginSection) loginSection.style.display = 'block';
        if (protectedContent) protectedContent.style.display = 'none';
        if (signOutBtn) signOutBtn.style.display = 'none';
        if (signInLink) signInLink.style.display = 'inline-flex';
        if (messagesLink) messagesLink.style.display = 'none';
        if (topNavMenu) topNavMenu.style.display = 'none';
        if (topNavSearch) topNavSearch.style.display = 'none';
        document.body.classList.remove('auth-pending');
        document.body.classList.remove('has-sidebar');
        clearUnreadListener();
      }

      topicTagButtons.forEach(function (button) {
        button.addEventListener('click', function () { setActiveTopicTag(button.getAttribute('data-topic-tag') || 'all'); });
      });
      setActiveTopicTag('all');

      if (!window.firebase || !window.firebaseConfig) {
        showSignedOut();
        return;
      }

      try { firebase.initializeApp(window.firebaseConfig); } catch (e) { }
      const auth = firebase.auth();
      auth.onAuthStateChanged(function (user) { if (user) showAuthenticated(user); else showSignedOut(); });

      if (signOutBtn) {
        signOutBtn.addEventListener('click', function () {
          auth.signOut().then(function () { showSignedOut(); window.location.replace('/login.html'); });
        });
      }
    });
  </script>
</body>
</html>