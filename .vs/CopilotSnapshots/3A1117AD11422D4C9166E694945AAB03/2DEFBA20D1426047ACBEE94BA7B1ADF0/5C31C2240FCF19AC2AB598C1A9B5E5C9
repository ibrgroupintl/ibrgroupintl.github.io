rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'developers@ibrecruitment.com';
    }

    function isValidInsightDoc(data) {
      return data.keys().hasOnly(['title', 'link', 'date', 'timestamp', 'tags', 'imageUrl', 'snippet', 'source', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.link is string &&
        (data.link.matches('^https://substack\\.ibrecruitment\\.com/.*') || data.link.matches('^https://[a-z0-9-]+\\.substack\\.com/.*')) &&
        data.date is string && data.date.size() <= 80 &&
        data.timestamp is number &&
        data.tags is list && data.tags.size() <= 20 &&
        data.imageUrl is string &&
        data.snippet is string && data.snippet.size() <= 1000 &&
        data.source is string && data.source == 'substack-rss' &&
        data.updatedAt is timestamp;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );

      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['isOpened', 'openedAt', 'openedByUid']) &&
        request.resource.data.isOpened == true &&
        request.resource.data.openedByUid == request.auth.uid;

      allow create, delete: if false;
    }

    match /insightsFeed/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidInsightDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    match /userProfiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['userId', 'email', 'updatedAt']) &&
        request.resource.data.userId is string && request.resource.data.userId.size() >= 4 && request.resource.data.userId.size() <= 20 &&
        request.resource.data.email is string &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /userIds/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
