// Existing function
exports.getPostsCsv = functions.https.onCall(async (data, context) => {
  if (!context.auth) {
    throw new functions.https.HttpsError('unauthenticated', 'Must be signed in');
  }
  // Optional: check custom claims e.g. isSubscriber
  // if (!context.auth.token.isSubscriber) throw new functions.https.HttpsError('permission-denied','Subscribers only');

  const file = storage.bucket(BUCKET).file('Default/posts.csv');
  const expiresMs = Date.now() + 5 * 60 * 1000; // 5 minutes
  const [url] = await file.getSignedUrl({
    version: 'v4',
    action: 'read',
    expires: expiresMs,
  });
  return { url };
});

// --- Begin adminFetchAndRelayRss and dependencies ---
const parser = new Parser();
const SUBSTACK_RSS_URL = 'https://substack.ibrecruitment.com/feed'; // <-- Replace with your feed

// Fetch Substack RSS and store in Firestore
exports.fetchSubstackRssToFirestore = functions.pubsub.schedule('every 60 minutes').onRun(async (context) => {
  const feed = await parser.parseURL(SUBSTACK_RSS_URL);
  const db = admin.firestore();

  for (const item of feed.items) {
    const docId = item.guid || item.link;
    const docRef = db.collection('insightsFeed').doc(docId.replace(/[^\0-\w-]/g, ''));

    const doc = await docRef.get();
    if (!doc.exists) {
      await docRef.set({
        title: item.title || '',
        link: item.link || '',
        date: item.pubDate || '',
        snippet: item.contentSnippet || '',
        source: feed.title || 'Substack',
        tags: [],
        timestamp: item.isoDate ? new Date(item.isoDate).getTime() : Date.now()
      });
    }
  }
  return null;
});

