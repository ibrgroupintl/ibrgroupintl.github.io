<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Secure Login</title>
  <link rel="stylesheet" href="/index.css">
  <!-- Firebase client SDKs -->
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <style>
    /* Minimal, neutral login card styling */
    /* Use column layout so footer sits below content; center main area vertically */
    body{display:flex;flex-direction:column;min-height:100vh;margin:0;background:var(--rc-bg, var(--site-bg))}
    .login-main{flex:1;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap;padding:24px}
    .card{width:380px;max-width:92vw;background:var(--rc-surface, var(--card-bg));border-radius:12px;padding:28px;box-shadow:var(--rc-shadow, var(--shadow));border:1px solid var(--rc-border, var(--border))}
    h1{font-size:1.25rem;margin:0 0 8px;color:var(--text)}
    /* Center the sign-in heading and lead paragraph for better visual balance */
    #signin-title { text-align: center; }
    .lead { text-align: center; }
    p.lead{color:var(--rc-text-dim, var(--muted));margin:0 0 18px}
    .actions{display:flex;flex-direction:column;gap:12px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:10px 12px;border-radius:8px;border:none;cursor:pointer;font-weight:600}
    .btn-primary{background:var(--accent);color:#fff}
    .btn-outline{background:transparent;border:1px solid var(--rc-border, var(--border));color:var(--rc-text-dim, var(--muted))}
    .note{font-size:0.85rem;color:var(--rc-text-dim, var(--muted));text-align:center}
    #error{color:#b00020;font-size:0.95rem;display:none;margin-top:8px}
    /* Page-scoped container centering for login page only */
    .login-page .container{display:flex;flex-direction:column;align-items:center;justify-content:center}
    /* Links block inside the card: horizontal and centered */
    .meta-links{display:flex;flex-direction:row;gap:12px;justify-content:center;align-items:center}
    
    /* Google Sign-In Button Styling */
    .google-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 0;
      height: 40px;
      border-radius: 4px;
      border: none;
      background: #4285f4;
      color: #fff;
      font-family: 'Roboto', Arial, sans-serif;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.3s, box-shadow 0.3s;
      box-shadow: 0 2px 4px 0 rgba(0,0,0,.25);
      width: 100%;
    }
    .google-btn:hover {
      background: #357ae8;
      box-shadow: 0 3px 8px 0 rgba(0,0,0,.3);
    }
    .google-btn:active {
      background: #2c5dd4;
    }
    .google-btn-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fff;
      width: 40px;
      height: 40px;
      border-radius: 2px 0 0 2px;
      flex-shrink: 0;
    }
    .google-btn-text {
      padding-right: 12px;
      flex: 1;
      text-align: center;
    }
    
    /* User Status Display */
    .user-status {
      display: none;
      padding: 16px;
      background: rgba(66, 133, 244, 0.1);
      border-radius: 8px;
      border: 1px solid rgba(66, 133, 244, 0.3);
    }
    .user-status.active {
      display: block;
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }
    .user-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid var(--accent);
    }
    .user-details {
      flex: 1;
    }
    .user-name {
      font-weight: 600;
      color: var(--text);
      margin: 0 0 4px 0;
    }
    .user-email {
      font-size: 0.85rem;
      color: var(--muted);
      margin: 0;
    }
    .sign-out-btn {
      background: #ea4335;
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 500;
      width: 100%;
      transition: background 0.3s;
    }
    .sign-out-btn:hover {
      background: #d33426;
    }
  </style>
  <style>
    /* Mobile responsiveness for login card */
    @media (max-width:480px){
      .card{width:92vw;padding:20px}
      h1{font-size:1.05rem}
      .btn{padding:10px;border-radius:10px}
      .actions{gap:10px}
      .note{font-size:0.82rem}
    }
  </style>
</head>
<body>
  <header class="resource-nav" role="banner">
    <div class="container container-nav">
      <div class="logo" style="display:flex;align-items:center;gap:12px">
        <img src="/160.jpg" alt="Impact logo" class="site-logo" style="height:36px;width:auto;display:block">
        <span class="site-title" style="color:lightgrey">Impact in Business Recruitment</span>
      </div>
      <div class="user-menu">
        <code class="contact-code"><b>Enquiries:</b> 07940916731</code>
      </div>
    </div>
  </header>

  <main class="login-main">
    <div class="card" role="main" aria-labelledby="signin-title">
    <h1 id="signin-title">Secure Login</h1>
    <p class="lead">Sign in with your Google account to access the protected portal.</p>

    <div id="error" role="alert"></div>

    <!-- User Status (shown when logged in) -->
    <div id="userStatus" class="user-status">
      <div class="user-info">
        <img id="userAvatar" class="user-avatar" src="" alt="User avatar">
        <div class="user-details">
          <p class="user-name" id="userName"></p>
          <p class="user-email" id="userEmail"></p>
        </div>
      </div>
      <button id="signOutBtn" class="sign-out-btn">Sign Out</button>
    </div>

    <div id="signInActions" class="actions">
      <button id="googleBtn" class="google-btn" type="button">
        <span class="google-btn-icon">
          <svg width="18" height="18" viewBox="0 0 18 18">
            <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
            <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
            <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.348 2.825.957 4.039l3.007-2.332z"/>
            <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.163 6.656 3.58 9 3.58z"/>
          </svg>
        </span>
        <span class="google-btn-text">Sign in with Google</span>
      </button>
      <a class="btn btn-outline" href="/index.html">Return to User Portal</a>
    </div>

    <p class="note">This site uses Firebase Authentication (Google). Your sign-in will be handled by Google and Firebase.</p>

    <div class="meta-links" style="margin-top:12px">
      <a href="/terms.html" class="btn btn-outline" style="padding:6px 10px">Terms</a>
      <a href="/privacy.html" class="btn btn-outline" style="padding:6px 10px">Privacy</a>
      <a href="/cookies.html" class="btn btn-outline" style="padding:6px 10px">Cookies</a>
    </div>
    </div>
  </main>

  <script>
    // Wait for page and deferred SDKs to load
    (function() {
      // Prevent multiple executions
      if (window._loginInitialized) return;
      window._loginInitialized = true;

      window.addEventListener('load', function () {
        if (!window.firebase || !window.firebaseConfig) {
          console.error('Firebase SDK or config not available');
          return;
        }
        try { firebase.initializeApp(window.firebaseConfig); } catch (e) { /* already initialized */ }

        const auth = firebase.auth();
        const googleBtn = document.getElementById('googleBtn');
        const signOutBtn = document.getElementById('signOutBtn');
        const errEl = document.getElementById('error');
        const userStatus = document.getElementById('userStatus');
        const signInActions = document.getElementById('signInActions');
        const userAvatar = document.getElementById('userAvatar');
        const userName = document.getElementById('userName');
        const userEmail = document.getElementById('userEmail');

        function showError(msg) { 
          if (errEl) { 
            errEl.textContent = msg; 
            errEl.style.display = 'block'; 
          } 
        }

        function showUserStatus(user) {
          if (userStatus && signInActions) {
            userStatus.classList.add('active');
            signInActions.style.display = 'none';
            if (userAvatar && user.photoURL) {
              userAvatar.src = user.photoURL;
              userAvatar.alt = user.displayName || 'User';
            }
            if (userName) userName.textContent = user.displayName || 'User';
            if (userEmail) userEmail.textContent = user.email || '';
          }
        }

        function hideUserStatus() {
          if (userStatus && signInActions) {
            userStatus.classList.remove('active');
            signInActions.style.display = 'flex';
          }
        }

        let redirectTimer = null;
        function redirectToPortal() {
          if (redirectTimer) return;
          redirectTimer = setTimeout(function () {
            window.location.replace('/index.html');
          }, 500);
        }

        // Monitor auth state changes
        auth.onAuthStateChanged(function(user) {
          if (user) {
            showUserStatus(user);
            redirectToPortal();
          } else {
            hideUserStatus();
            if (redirectTimer) {
              clearTimeout(redirectTimer);
              redirectTimer = null;
            }
          }
        });

        // Handle redirect result (if used as fallback)
        auth.getRedirectResult().then((result) => {
          if (result && result.user) {
            showUserStatus(result.user);
            redirectToPortal();
          }
        }).catch(err => console.error('Redirect result error', err));

        async function signInWithGoogle() {
          const provider = new firebase.auth.GoogleAuthProvider();
          try {
            const result = await auth.signInWithPopup(provider);
            showUserStatus(result.user);
            redirectToPortal();
          } catch (err) {
            console.warn('Popup failed, falling back to redirect', err);
            try { await auth.signInWithRedirect(provider); } catch (rerr) { showError(rerr.message || 'Authentication failed'); }
          }
        }

        async function signOut() {
          try {
            await auth.signOut();
            hideUserStatus();
            if (errEl) errEl.style.display = 'none';
          } catch (err) {
            showError('Sign out failed: ' + (err.message || 'Unknown error'));
          }
        }

        if (googleBtn) {
          googleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (errEl) errEl.style.display='none';
            signInWithGoogle();
          }, { once: false });
        }

        if (signOutBtn) {
          signOutBtn.addEventListener('click', function(e) {
            e.preventDefault();
            signOut();
          });
        }
      });
    })();
  </script>


  <script src="/index.js" defer></script>
  <script>
    (function(){
      try {
        var cookieName = 'ibr_cookie_consent_v1';
        function setCookie(name,value,days){var d=new Date();d.setTime(d.getTime()+(days*24*60*60*1000));document.cookie = name+'='+encodeURIComponent(value)+';path=/;SameSite=Lax';}
        function getCookie(name){var v=document.cookie.match('(^|;)\\s*'+name+'\\s*=\\s*([^;]+)');return v?decodeURIComponent(v.pop()):null}
        var bar = document.getElementById('cookieConsentBar');
        if (!bar) return;
        if (getCookie(cookieName)) { bar.style.display = 'none'; return; }
        var accept = document.getElementById('cookieAcceptBtn');
        var decline = document.getElementById('cookieDeclineBtn');
        if (accept) accept.addEventListener('click', function(){ setCookie(cookieName,'accepted',365); bar.style.display = 'none'; });
        if (decline) decline.addEventListener('click', function(){ setCookie(cookieName,'declined',365); bar.style.display = 'none'; });
      } catch(e){ console.error('cookie bar init', e);}    
    })();
  </script>

  <!-- Inline cookie consent UI placed in footer for login page -->
  <footer class="resource-footer" role="contentinfo">
    <div class="container" style="text-align:center">
      <div id="cookieConsentBar" style="width:100%;max-width:1200px;margin:0 auto 12px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:12px;border-radius:8px;background:rgba(2,6,23,0.06);">
        <div style="flex:1;min-width:220px;color:var(--muted)">We use cookies to improve your experience. By using this site you agree to our use of cookies. <a href="/privacy.html" style="color:var(--text);text-decoration:underline;margin-left:8px">Learn more</a></div>
        <div style="display:flex;gap:8px;align-items:center">
          <button id="cookieDeclineBtn" style="background:transparent;border:1px solid rgba(0,0,0,0.08);color:var(--text);padding:8px 12px;border-radius:8px;">Decline</button>
          <button id="cookieAcceptBtn" style="background:var(--accent);border:none;color:#fff;padding:8px 12px;border-radius:8px;">Accept</button>
        </div>
      </div>
      <div>
        <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
