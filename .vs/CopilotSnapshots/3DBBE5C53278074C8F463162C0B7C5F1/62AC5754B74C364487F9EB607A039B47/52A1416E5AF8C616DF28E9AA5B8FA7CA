<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="index, follow">
  <title>Impact in Business Recruitment — Human Resources Centre</title>
  <link rel="stylesheet" href="/resource-centre.css">
  <link rel="stylesheet" href="/index.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="resource-nav" role="banner">
    <div class="container container-nav">
      <div class="logo">
        <span class="site-title">User Portal</span>
      </div>
      <div class="user-menu">
        <a class="btn btn-outline nav-login" href="/login.html">Sign In</a>
      </div>
    </div>
  </header>

  <main class="hub-main" role="main">
    <section class="container" style="padding:6rem 0;text-align:center">
      <h1 style="font-size:2.25rem;margin-bottom:0.5rem">Welcome to the Human Resources Centre</h1>
      <p style="color:var(--rc-text-dim);max-width:720px;margin:0.5rem auto 1.5rem">Centralized hub for recruitment reports, executive moves and curated career insights across infrastructure finance and commercial real estate.</p>
      <div style="display:flex;justify-content:center;margin-top:1.5rem">
        <a class="btn btn-primary" href="mailtoi:developers@ibrecruitment.com">Request Early Access</a>
      </div>
    </section>

    <section class="container" style="padding:3rem 0">
      <div class="resource-grid">
        <article class="resource-card">
          <div class="card-icon">📊</div>
          <h3>Market Reports</h3>
          <p>Download annual hiring trends and sector analysis to inform hiring strategy.</p>
        </article>
        <article class="resource-card">
          <div class="card-icon">🏢</div>
          <h3>Executive Moves</h3>
          <p>Monitor senior hires and leadership transitions across the industry.</p>
        </article>
        <article class="resource-card">
          <div class="card-icon">📚</div>
          <h3>Insights Archive</h3>
          <p>Access past research and editorial content for reference and benchmarking.</p>
        </article>
      </div>
    </section>
  </main>

  <!-- cookie consent bar removed from fixed position; consent UI moved into footer below -->

  <footer class="resource-footer" role="contentinfo">
    <div class="container" style="text-align:center">
      <div style="margin-bottom:8px;">
        <a href="/terms.html" class="btn btn-outline" style="padding:6px 10px;margin-right:8px">Terms</a>
        <a href="/privacy.html" class="btn btn-outline" style="padding:6px 10px">Privacy</a>
      </div>

      <!-- Inline cookie consent UI placed inside footer (non-fixed) -->
      <div id="cookieConsentBar" style="width:100%;max-width:1200px;margin:0 auto 12px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:12px;border-radius:8px;background:rgba(2,6,23,0.06);">
        <div style="flex:1;min-width:220px;color:var(--muted)">We use cookies to improve your experience. By using this site you agree to our use of cookies. <a href="/privacy.html" style="color:var(--text);text-decoration:underline;margin-left:8px">Learn more</a></div>
        <div style="display:flex;gap:8px;align-items:center">
          <button id="cookieDeclineBtn" style="background:transparent;border:1px solid rgba(0,0,0,0.08);color:var(--text);padding:8px 12px;border-radius:8px;">Decline</button>
          <button id="cookieAcceptBtn" style="background:var(--accent);border:none;color:#fff;padding:8px 12px;border-radius:8px;">Accept</button>
        </div>
      </div>

      <div>
        <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Load Font Awesome for icons used in header (CDN) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js" defer></script>
  <script src="/index.js" defer></script>
  <script>
    (function(){
      try {
        var cookieName = 'ibr_cookie_consent_v1';
        function setCookie(name,value,days){var d=new Date();d.setTime(d.getTime()+(days*24*60*60*1000));document.cookie = name+'='+encodeURIComponent(value)+';path=/;SameSite=Lax';}
        function getCookie(name){var v=document.cookie.match('(^|;)\\s*'+name+'\\s*=\\s*([^;]+)');return v?decodeURIComponent(v.pop()):null}
        var bar = document.getElementById('cookieConsentBar');
        if (!bar) return;
        if (getCookie(cookieName)) { bar.parentNode && bar.parentNode.removeChild(bar); return; }
        document.getElementById('cookieAcceptBtn').addEventListener('click', function(){ setCookie(cookieName,'accepted',365); bar.remove(); });
        document.getElementById('cookieDeclineBtn').addEventListener('click', function(){ setCookie(cookieName,'declined',365); bar.remove(); });
      } catch(e){ console.error('cookie bar init', e);}    
    })();
  </script>
</body>
</html>
