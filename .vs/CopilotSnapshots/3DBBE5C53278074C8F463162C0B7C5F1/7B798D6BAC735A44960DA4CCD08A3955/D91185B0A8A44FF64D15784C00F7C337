// index.js - small site config and UI helpers (JSON-like structure)
window.SITE_CONFIG = {
  title: 'Impact in Business Recruitment',
  contactEmail: 'uk-hr-enquiries@ibrecruitment.com'
};

document.addEventListener('DOMContentLoaded', function(){
  // sync document title from config
  if (window.SITE_CONFIG && SITE_CONFIG.title) {
    document.title = SITE_CONFIG.title + ' — Human Resources Centre';
  }

  // wire sign-in buttons to the canonical login path
  document.querySelectorAll('.nav-login, a[href="/login.html"]').forEach(function(el){
    el.addEventListener('click', function(e){
      // anchor will navigate; ensure it's consistent
      // nothing special here but keep handler for analytics hooks later
    });
  });

  // populate contact links
  var emailEls = document.querySelectorAll('.nav-email');
  emailEls.forEach(function(a){
    a.setAttribute('href', 'mailto:' + SITE_CONFIG.contactEmail);
    if (a.textContent.indexOf('@') === -1) a.textContent = SITE_CONFIG.contactEmail;
  });
});
