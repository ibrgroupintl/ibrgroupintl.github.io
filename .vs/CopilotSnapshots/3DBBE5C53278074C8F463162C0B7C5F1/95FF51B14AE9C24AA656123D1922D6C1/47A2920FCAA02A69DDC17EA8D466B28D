<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Welcome Hub | Impact in Business Recruitment Blog's Human Resources Centre</title>
    <link rel="stylesheet" href="resource-centre.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
      /* Minimal button styling to match login.ejs primary button */
      .btn { display:inline-block; text-decoration:none; font-weight:600; border-radius:8px; padding:8px 12px; }
      .btn-primary { background:#0f62fe; color:#fff; border:none; }
      .nav-login { margin-right:12px; }
      .resource-nav .user-menu { display:flex; gap:8px; align-items:center; }
    </style>

    <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
<script src="/firebase-config.js"></script>
<script>
  firebase.initializeApp(window.firebaseConfig);
  firebase.auth().onAuthStateChanged(user => {
    if (!user) location.replace('/login.html');
    // else optionally show user info
  });
</script>

</head>
<body class="light-theme">
    <nav class="resource-nav">
        <div class="container container-nav">
            <div class="logo">
                <span class="site-title">Human Resources Centre</span>
            </div>
            <div class="user-menu">
                <a href="/login" class="btn btn-primary nav-login" title="Sign in">Sign in</a>
                <a href="mailto:uk-hr-enquiries@ibrecruitment.com" class="btn btn-outline nav-email">
                    <i class="fas fa-envelope"></i> uk-hr-enquiries@ibrecruitment.com
                </a>
            </div>
          </div>
    </nav>

    <header class="hub-header">
        <div class="container container-header">
            <h1>Welcome to the Human Resources Centre</h1>
            <p>Your centralized hub for recruitment reports, executive moves, and career insights.</p>
        </div>
    </header>

    <main class="hub-main">
        <div class="container">
            <div class="resource-grid">
                <section class="resource-card">
                    <div class="card-icon">📊</div>
                    <h3>Market Reports</h3>
                    <p>Exclusive annual reports on global real estate and infrastructure hiring trends.</p>
                    <a href="#" class="btn btn-primary">Download Latest</a>
                </section>
                <section class="resource-card">
                    <div class="card-icon">🏢</div>
                    <h3>Executive Moves</h3>
                    <p>Track high-level people moves across infrastructure finance and commercial real estate.</p>
                    <a href="#" class="btn btn-primary">View People Moves</a>
                </section>
                <section class="resource-card">
                    <div class="card-icon">📚</div>
                    <h3>Insights Archive</h3>
                    <p>Deep-dive into past analysis and editorial pieces regarding leadership capital.</p>
                    <a href="#" class="btn btn-primary">Browse Archives</a>
                </section>
            </div>
        </div>
    </main>

    <footer class="resource-footer">
        <div class="container">
            <p>&copy; 2026 Impact in Business Recruitment Blog. Secure Backend Gateway.</p>
        </div>
    </footer>

    <script src="resource-centre.js"></script>
</body>
</html>
