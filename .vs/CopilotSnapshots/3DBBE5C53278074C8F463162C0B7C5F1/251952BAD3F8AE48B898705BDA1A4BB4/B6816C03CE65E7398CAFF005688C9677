require('dotenv').config(); // Load environment variables from .env
const express = require('express');
const session = require('express-session');
const mysql = require('mysql2/promise');
const argon2 = require('argon2');
const helmet = require('helmet');
const path = require('path');
const passport = require('passport');
const GoogleStrategy = require('passport-google-oauth20').Strategy;
const MySQLStore = require('express-mysql-session')(session);

const app = express();

// --- 1. Security Headers & Middleware ---
app.use(helmet()); // Sets secure HTTP headers
app.use(express.urlencoded({ extended: false })); // Replaces PHP $_POST
app.set('view engine', 'ejs');
app.set('views', path.join(__dirname, 'views')); // Ensures the 'views' folder is found

// --- Serve static site from repository root ---
// This makes /resource-centre.html, CSS and JS files available from the same origin
app.use(express.static(path.join(__dirname, '..')));

// Redirect root to the resource centre page for convenience
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, '..', 'index.html'));
});

// --- 2. Database Connection (Using .env variables) ---
// Support Cloud SQL socketPath (CLOUD_SQL_CONNECTION_NAME) for Cloud Run and tune pool for concurrency
const useSocket = !!process.env.CLOUD_SQL_CONNECTION_NAME;
const defaultPoolSize = Math.max(2, parseInt(process.env.DB_CONN_LIMIT || process.env.DB_POOL_SIZE || '10', 10));
const dbConfig = {
    user: process.env.DB_USER || process.env.DB_USERNAME || 'root',
    password: process.env.DB_PASSWORD || process.env.DB_PASS || '',
    database: process.env.DB_NAME || process.env.DB_DATABASE || '',
    charset: 'utf8mb4',
    waitForConnections: true,
    connectionLimit: defaultPoolSize,
    queueLimit: 0,
    // mysql2 option: timeout for initial connection handshake
    connectTimeout: parseInt(process.env.DB_CONNECT_TIMEOUT_MS || '10000', 10),
    // mysql2 doesn't expose acquireTimeout directly on pool options, but we set a conservative value
    acquireTimeout: parseInt(process.env.DB_ACQUIRE_TIMEOUT_MS || '10000', 10)
};

if (useSocket) {
    // Use Cloud SQL Unix socket path when provided (Cloud Run / Cloud Functions)
    dbConfig.socketPath = `/cloudsql/${process.env.CLOUD_SQL_CONNECTION_NAME}`;
} else {
    dbConfig.host = process.env.DB_HOST || '127.0.0.1';
    if (process.env.DB_PORT) dbConfig.port = parseInt(process.env.DB_PORT, 10);
}

const dbPool = mysql.createPool(dbConfig);
console.log(`DB pool configured. socketPath=${useSocket ? dbConfig.socketPath : 'none'}, connectionLimit=${dbConfig.connectionLimit}`);

// Basic connectivity test (non-blocking). Logs a warning if DB is unreachable.
(async () => {
    try {
        const conn = await dbPool.getConnection();
        // mysql2/promise exposes ping via connection.ping() or simple query
        await conn.ping();
        conn.release();
        console.log('DB pool: connection OK');
    } catch (err) {
        console.warn('DB pool: cannot establish connection - continuing without DB. Error:', err && err.message);
    }
})();

// --- 3. Session Configuration ---
// Configure a persistent MySQL-backed session store (safer for production than MemoryStore)
const sessionStoreOptions = {
    host: process.env.DB_HOST || '127.0.0.1',
    port: process.env.DB_PORT ? parseInt(process.env.DB_PORT, 10) : 3306,
    user: process.env.DB_USER || process.env.DB_USERNAME || 'root',
    password: process.env.DB_PASSWORD || process.env.DB_PASS || '',
    database: process.env.DB_NAME || process.env.DB_DATABASE || '',
    // default expiration handled by session cookie maxAge below
    createDatabaseTable: true
};
const sessionStore = new MySQLStore(sessionStoreOptions);
app.use(session({
    name: 'ibr_resource_session',
    secret: process.env.SESSION_SECRET || '59c81a27a88a41f51677925579b821be37323c37ec21c73bf865c3f053a1698df3ac7d6e739149652c476897156dce7e',
    resave: false,
    saveUninitialized: false,
    store: sessionStore,
    cookie: {
        domain: process.env.COOKIE_DOMAIN || 'supa-73a39.firebaseapp.com',
        path: '/',
        // Set secure cookies only in production when running over HTTPS
        secure: process.env.NODE_ENV === 'production',
        httpOnly: true,  // Prevents XSS cookie theft
        sameSite: 'strict' // Prevents CSRF
        ,maxAge: 24 * 60 * 60 * 1000 // 1 day
    }
}));

// --- Passport Configuration (Google OAuth) ---
app.use(passport.initialize());
app.use(passport.session());

passport.serializeUser((user, done) => {
    // Serialize minimal info into session
    done(null, { id: user.id, displayName: user.displayName, emails: user.emails });
});

passport.deserializeUser((obj, done) => {
    done(null, obj);
});

// Configure Google Strategy
passport.use(new GoogleStrategy({
    clientID: process.env.GOOGLE_CLIENT_ID || '',
    clientSecret: process.env.GOOGLE_CLIENT_SECRET || '',
    callbackURL: process.env.GOOGLE_CALLBACK_URL || '/auth/google/callback'
}, async (accessToken, refreshToken, profile, done) => {
    try {
        // Here you could find or create a corresponding local user record.
        // For now we just pass the profile through.
        return done(null, profile);
    } catch (err) {
        return done(err);
    }
}));

// --- 4. Auth Middleware ---
const authCheck = (req, res, next) => {
    const timeoutSeconds = 1800; // 30 minutes
    const now = Math.floor(Date.now() / 1000);

    if (req.session.logged_in_at && (now - req.session.logged_in_at > timeoutSeconds)) {
        return req.session.destroy(() => {
            res.clearCookie('ibr_resource_session');
            res.redirect('/login');
        });
    }

    // Allow authenticated via Passport (Google) or existing local session
    if (req.isAuthenticated && req.isAuthenticated()) {
        req.session.logged_in_at = now;
        return next();
    }

    if (!req.session.user_id || !req.session.username) {
        return res.redirect('/login');
    }

    req.session.logged_in_at = now;
    next();
};

// --- 5. Routes ---

// Login Page (GET)
app.get('/login', (req, res) => {
    res.render('login', { error: null });
});

// Start Google OAuth flow
app.get('/auth/google', passport.authenticate('google', { scope: ['profile', 'email'] }));

// OAuth callback
app.get('/auth/google/callback', passport.authenticate('google', { failureRedirect: '/login' }), (req, res) => {
    // Successful authentication
    // Optionally persist user to DB here and set minimal session values
    req.session.user_id = req.user.id || req.user.sub || null;
    req.session.username = req.user.displayName || (req.user.emails && req.user.emails[0] && req.user.emails[0].value) || 'google-user';
    // normalize session timestamp name used by authCheck
    req.session.logged_in_at = Math.floor(Date.now() / 1000);
    res.redirect('/index');
});

// Logout
app.get('/logout', (req, res) => {
    req.logout(function(err) {
        // ignore errors from logout, destroy session anyway
        req.session.destroy(() => {
            res.clearCookie('ibr_resource_session');
            res.redirect('/login');
        });
    });
});

// Login Logic (POST)
app.post('/login', async (req, res) => {
    const username = (req.body.username || '').trim();
    const password = req.body.password || '';
    const dummyHash = '$argon2id$v=19$m=65536,t=4,p=1$aaaaaaaaaaaaaaaaaaaaaa$bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';

    try {
        const [rows] = await dbPool.execute(
            'SELECT id, username, password_hash FROM admin_users WHERE username = ? LIMIT 1',
            [username]
        );
        const user = rows[0];

        const hashToVerify = user ? user.password_hash : dummyHash; //
        const isVerified = await argon2.verify(hashToVerify, password);

        if (isVerified && user) {
            req.session.regenerate((err) => {
                if (err) throw err;
                req.session.user_id = user.id;
                req.session.username = user.username;
                // normalize session timestamp property name used by authCheck
                req.session.logged_in_at = Math.floor(Date.now() / 1000);
                res.redirect('/index');
            });
            await dbPool.execute('UPDATE admin_users SET last_login = NOW() WHERE id = ?', [user.id]);
        } else {
            res.render('login', { error: 'Invalid credentials' }); //
        }
    } catch (err) {
        console.error(err);
        res.render('login', { error: 'An error occurred. Please try again later.' });
    }
});

app.get('/index', authCheck, (req, res) => {
    res.send('Welcome to the Protected Resources Centre, ' + req.session.username);
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Server running on port ${PORT}`));

