<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Secure Login</title>
  <link rel="stylesheet" href="/index.css">
  <!-- Firebase client SDKs -->
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <style>
    /* Minimal, neutral login card styling */
    body{display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:var(--rc-bg, var(--site-bg))}
    .card{width:380px;background:var(--rc-surface, var(--card-bg));border-radius:12px;padding:28px;box-shadow:var(--rc-shadow, var(--shadow));border:1px solid var(--rc-border, var(--border));margin:0 auto}
    h1{font-size:1.25rem;margin:0 0 8px;color:var(--text)}
    /* Center the sign-in heading and lead paragraph for better visual balance */
    #signin-title { text-align: center; }
    .lead { text-align: center; }
    p.lead{color:var(--rc-text-dim, var(--muted));margin:0 0 18px}
    .actions{display:flex;flex-direction:column;gap:12px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:10px 12px;border-radius:8px;border:none;cursor:pointer;font-weight:600}
    .btn-primary{background:var(--accent);color:#fff}
    .btn-outline{background:transparent;border:1px solid var(--rc-border, var(--border));color:var(--rc-text-dim, var(--muted))}
    .note{font-size:0.85rem;color:var(--rc-text-dim, var(--muted));text-align:center}
    #error{color:#b00020;font-size:0.95rem;display:none;margin-top:8px}
  </style>
  <style>
    /* Mobile responsiveness for login card */
    @media (max-width:480px){
      .card{width:92vw;padding:20px}
      h1{font-size:1.05rem}
      .btn{padding:10px;border-radius:10px}
      .actions{gap:10px}
      .note{font-size:0.82rem}
    }
  </style>
</head>
<body>
</head>
<body>
  <div class="card" role="main" aria-labelledby="signin-title">
    <h1 id="signin-title">Secure Login</h1>
    <p class="lead">Sign in with your Google account to access the protected portal.</p>

    <div id="error" role="alert"></div>

    <div class="actions">
      <button id="googleBtn" class="btn btn-primary" type="button">Sign in with Google</button>
      <a class="btn btn-outline" href="/index.html">Return to public site</a>
    </div>

  <!-- Terms & Privacy links (bottom of page, above footer) -->
  <div class="container" style="text-align:center;margin:18px 0 8px">
    <a href="/terms.html" class="btn btn-outline" style="padding:6px 10px;margin-right:8px">Terms</a>
    <a href="/privacy.html" class="btn btn-outline" style="padding:6px 10px">Privacy</a>
  </div>

    <p class="note">This site uses Firebase Authentication (Google). Your sign-in will be handled by Google and Firebase.</p>
  </div>

  <script>
    // Wait for page and deferred SDKs to load
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) {
        console.error('Firebase SDK or config not available');
        return;
      }
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) { /* already initialized */ }

      const auth = firebase.auth();
      const googleBtn = document.getElementById('googleBtn');
      const errEl = document.getElementById('error');

      function showError(msg) { if (errEl) { errEl.textContent = msg; errEl.style.display = 'block'; } }

      // Handle redirect result (if used as fallback)
      auth.getRedirectResult().then((result) => {
        if (result && result.user) {
          result.user.getIdToken().then(idToken => {
            // Send token to server to create session
            fetch('/sessionLogin', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ idToken })
            }).then(r => r.json()).then(() => window.location.replace('/index.html')).catch(err => showError('Server login failed'));
          });
        }
      }).catch(err => console.error('Redirect result error', err));

      async function signInWithGoogle() {
        const provider = new firebase.auth.GoogleAuthProvider();
        try {
          const result = await auth.signInWithPopup(provider);
          const idToken = await result.user.getIdToken();
          const res = await fetch('/sessionLogin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idToken })
          });
          if (res.ok) return window.location.replace('/index.html');
          const json = await res.json();
          showError(json && json.error ? json.error : 'Server login failed');
        } catch (err) {
          console.warn('Popup failed, falling back to redirect', err);
          try { await auth.signInWithRedirect(provider); } catch (rerr) { showError(rerr.message || 'Authentication failed'); }
        }
      }

      if (googleBtn) googleBtn.addEventListener('click', () => { if (errEl) errEl.style.display='none'; signInWithGoogle(); });
    });
  </script>
  <footer class="resource-footer">
    <div class="container" style="text-align:center">
      

      <!-- Inline cookie consent UI placed inside footer (non-fixed) -->
      <div id="cookieConsentBar" style="width:100%;max-width:900px;margin:0 auto 12px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:12px;border-radius:8px;background:rgba(2,6,23,0.06);">
        <div style="flex:1;min-width:180px;color:var(--muted)">We use cookies to improve your experience. By using this site you agree to our use of cookies. <a href="/privacy.html" style="color:var(--text);text-decoration:underline;margin-left:8px">Learn more</a></div>
        <div style="display:flex;gap:8px;align-items:center">
          <button id="cookieDeclineBtn" style="background:transparent;border:1px solid rgba(0,0,0,0.08);color:var(--text);padding:8px 12px;border-radius:8px;">Decline</button>
          <button id="cookieAcceptBtn" style="background:var(--accent);border:none;color:#fff;padding:8px 12px;border-radius:8px;">Accept</button>
        </div>
      </div>

      <div>
        </div>
    </div>
  </footer>

  <script src="/index.js" defer></script>
  <script>
    (function(){
      try {
        var cookieName = 'ibr_cookie_consent_v1';
        function setCookie(name,value,days){var d=new Date();d.setTime(d.getTime()+(days*24*60*60*1000));document.cookie = name+'='+encodeURIComponent(value)+';path=/;SameSite=Lax';}
        function getCookie(name){var v=document.cookie.match('(^|;)\\s*'+name+'\\s*=\\s*([^;]+)');return v?decodeURIComponent(v.pop()):null}
        var bar = document.getElementById('cookieConsentBar');
        if (!bar) return;
        if (getCookie(cookieName)) { bar.style.display = 'none'; return; }
        var accept = document.getElementById('cookieAcceptBtn');
        var decline = document.getElementById('cookieDeclineBtn');
        if (accept) accept.addEventListener('click', function(){ setCookie(cookieName,'accepted',365); bar.style.display = 'none'; });
        if (decline) decline.addEventListener('click', function(){ setCookie(cookieName,'declined',365); bar.style.display = 'none'; });
      } catch(e){ console.error('cookie bar init', e);}    
    })();
  </script>
</body>
</html>
