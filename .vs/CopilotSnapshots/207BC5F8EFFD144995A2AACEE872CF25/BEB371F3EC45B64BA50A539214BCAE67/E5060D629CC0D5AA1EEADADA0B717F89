<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#0284c7">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="index, follow">
  <title>Profile Page — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/resource-centre.css">
  <link rel="stylesheet" href="/index.css">
  <link rel="stylesheet" href="/mobile-compat.css">
  <link rel="stylesheet" href="/page-transition.css">
  <style>
    .page-wrapper { background:#fff; max-width:1920px; min-height:100vh; margin:0 auto; box-shadow:0 0 20px rgba(0,0,0,.1); }
    .sidebar-menu-shell { display:none; position:fixed; top:88px; left:24px; width:220px; background:#fff; border:1px solid #dbe3ee; border-radius:12px; box-shadow:0 10px 24px rgba(2,6,23,.12); padding:10px 0; z-index:950; }
    .sidebar-menu-link { display:block; padding:11px 14px; margin:2px 8px; border-radius:8px; color:#092a4b; text-decoration:none; font-size:.95rem; font-weight:600; transition:background-color .2s ease,color .2s ease,transform .2s ease; }
    .sidebar-menu-link:hover,.sidebar-menu-link:focus { background:#092a4b; color:#fff; transform:translateX(3px); }
    body.has-sidebar .profile-shell { margin-left:260px; }
    .message-icon-link { width:42px; height:42px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; border:1px solid #c7d2fe; background:#eef2ff; color:#092a4b; text-decoration:none; }
    .message-icon-link:hover,.message-icon-link:focus { background:#092a4b; border-color:#092a4b; color:#fff; }
    .auth-shell { max-width:760px; margin:2rem auto; padding:2rem; border-radius:16px; border:1px solid #dbe3ee; background:linear-gradient(145deg,#fff 0%,#f6fbff 100%); text-align:center; box-shadow:0 8px 24px rgba(2,6,23,.08); }
    .profile-shell { display:none; max-width:980px; margin:2rem auto 3rem; padding:0 1rem; }
    .panel { background:#fff; border:1px solid #dbe3ee; border-radius:14px; box-shadow:0 6px 20px rgba(2,6,23,.06); }
    .panel-head { padding:1rem; border-bottom:1px solid #edf2f7; }
    .panel-body { padding:1rem; }
    .form-grid { display:grid; gap:12px; }
    .form-row { display:grid; gap:8px; }
    .name-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .form-label { font-weight:600; color:#0f2f4f; }
    .form-control { width:100%; border:1px solid #d0d7de; border-radius:8px; padding:10px 12px; box-sizing:border-box; font:inherit; }
    .form-control:focus { border-color:#0284c7; box-shadow:0 0 0 3px rgba(2,132,199,.12); outline:none; }
    textarea.form-control { min-height:170px; font-size:inherit; line-height:1.5; font-family:'Open Sans', Arial, sans-serif; }
    .muted { color:var(--muted); font-size:.9rem; }
    .image-preview { width:120px; height:120px; border-radius:12px; object-fit:cover; border:1px solid #dbe3ee; background:#f8fafc; }
    .button-row { display:flex; gap:10px; flex-wrap:wrap; }
    .status-note { margin-top:.75rem; color:var(--muted); }
    @media (max-width:980px){ .sidebar-menu-shell{ position:static; width:100%; max-width:980px; margin:12px auto; } body.has-sidebar .profile-shell{ margin-left:auto; } .name-grid{ grid-template-columns:1fr; } }
  </style>
</head>
<body class="auth-pending">
  <div class="page-wrapper">
    <header class="resource-nav" role="banner">
      <div class="container container-nav">
        <div class="logo" style="display:flex;align-items:center;gap:12px">
          <img src="/160.jpg" alt="Impact logo" class="site-logo" style="height:36px;width:auto;display:block">
          <span class="site-title" style="color:lightgrey">Premium</span>
        </div>
        <div class="user-menu" style="margin-left:auto;display:flex;align-items:center;gap:12px">
          <div class="auth-profile-chip" data-auth-profile>
            <img class="auth-profile-photo" data-auth-photo src="/160.jpg" alt="Profile photo">
            <span class="auth-profile-name" data-auth-name></span>
          </div>
          <a class="message-icon-link" href="/messages.html" id="messagesLink" aria-label="Open secure messages inbox" title="Messages inbox" style="display:none">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path><path d="M6 8l6 4 6-4"></path></svg>
          </a>
          <a class="btn btn-outline nav-login" href="/login.html" id="signInLink">Sign In</a>
          <button class="btn btn-outline" id="signOutBtn" style="display:none">Sign Out</button>
        </div>
      </div>
    </header>

    <nav id="topNavMenu" class="sidebar-menu-shell" aria-label="Members navigation">
      <a class="sidebar-menu-link" href="/index.html">Home</a>
      <a class="sidebar-menu-link" href="/profile.html">Profile Page</a>
      <a class="sidebar-menu-link" href="/members.html">Members Area</a>
      <a class="sidebar-menu-link" href="/messages.html">Messages Inbox</a>
      <a class="sidebar-menu-link" href="/insights.html">Insights Archive</a>
      <a class="sidebar-menu-link" href="/uploads.html">Resume Uploads</a>
      <a class="sidebar-menu-link" href="/settings.html">Account Settings</a>
      <a class="sidebar-menu-link" href="https://editor.ibrecruitment.com/claude.html" target="_blank" rel="noopener noreferrer">Ask Claude Code</a>
      <a class="sidebar-menu-link" href="https://www.ibrecruitment.com/contact" target="_blank" rel="noopener noreferrer">Contact Sales</a>
    </nav>

    <section id="loginSection" class="auth-shell">
      <h1 style="margin:0;color:#092a4b">Profile Page</h1>
      <p style="margin:.75rem 0 1.25rem;color:var(--muted)">Sign in to edit your member profile page.</p>
      <a class="btn btn-primary" href="/login.html">Go to Sign In</a>
    </section>

    <main id="profileShell" class="profile-shell" role="main">
      <section class="panel">
        <div class="panel-head">
          <h1 style="margin:0;color:#092a4b;font-size:1.3rem">Member Profile Settings</h1>
          <p class="muted" style="margin:.45rem 0 0">Your profile URL: <a id="publicProfileLink" href="#" target="_blank" rel="noopener noreferrer">-</a></p>
          <p id="publicProfileDocStatus" class="muted" style="margin:.35rem 0 0">Profile record: loading...</p>
        </div>
        <div class="panel-body">
          <div class="form-grid">
            <div class="form-row">
              <span class="form-label">Profile image</span>
              <img id="profileImagePreview" class="image-preview" src="/100.png" alt="Profile image preview">
              <input id="profileImageInput" class="form-control" type="file" accept="image/png,image/jpeg,image/webp">
              <span class="muted">Default image is used if none uploaded.</span>
            </div>

            <div class="name-grid">
              <div class="form-row">
                <label class="form-label" for="firstNameInput">First name (max 50)</label>
                <input id="firstNameInput" class="form-control" type="text" maxlength="50" placeholder="First name">
              </div>
              <div class="form-row">
                <label class="form-label" for="lastNameInput">Last name (max 50)</label>
                <input id="lastNameInput" class="form-control" type="text" maxlength="50" placeholder="Last name">
              </div>
            </div>

            <div class="form-row">
              <label class="form-label" for="bioInput">Bio (max 1000)</label>
              <textarea id="bioInput" class="form-control" maxlength="1000" placeholder="Tell people about your work and focus..."></textarea>
            </div>

            <div class="name-grid">
              <div class="form-row">
                <label class="form-label" for="socialLabelInput">Social platform</label>
                <input id="socialLabelInput" class="form-control" type="text" maxlength="40" placeholder="LinkedIn">
              </div>
              <div class="form-row">
                <label class="form-label" for="socialUrlInput">Social URL</label>
                <input id="socialUrlInput" class="form-control" type="url" maxlength="300" placeholder="https://...">
              </div>
            </div>

            <div class="button-row">
              <button type="button" class="btn btn-primary" id="saveProfileBtn">Save Profile</button>
              <a href="/settings.html" class="btn btn-outline">Back to Settings</a>
              <a id="openPublicProfileBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Open Profile Page</a>
            </div>

            <p id="profileStatus" class="status-note">Loading profile...</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="resource-footer" role="contentinfo">
      <div class="container" style="text-align:center">
        <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
      </div>
    </footer>
  </div>

  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <script defer src="/header-profile.js"></script>
  <script defer src="/mobile-compat.js"></script>
  <script defer src="/page-transition.js"></script>

  <script>
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) return;
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) {}

      const DEFAULT_PUBLIC_IMAGE = '/100.png';
      const auth = firebase.auth();
      const db = firebase.firestore();

      const loginSection = document.getElementById('loginSection');
      const profileShell = document.getElementById('profileShell');
      const signOutBtn = document.getElementById('signOutBtn');
      const signInLink = document.getElementById('signInLink');
      const messagesLink = document.getElementById('messagesLink');
      const topNavMenu = document.getElementById('topNavMenu');

      const profileImagePreview = document.getElementById('profileImagePreview');
      const profileImageInput = document.getElementById('profileImageInput');
      const firstNameInput = document.getElementById('firstNameInput');
      const lastNameInput = document.getElementById('lastNameInput');
      const bioInput = document.getElementById('bioInput');
      const socialLabelInput = document.getElementById('socialLabelInput');
      const socialUrlInput = document.getElementById('socialUrlInput');
      const saveProfileBtn = document.getElementById('saveProfileBtn');
      const profileStatus = document.getElementById('profileStatus');
      const publicProfileLink = document.getElementById('publicProfileLink');
      const publicProfileDocStatus = document.getElementById('publicProfileDocStatus');
      const openPublicProfileBtn = document.getElementById('openPublicProfileBtn');

      const USER_ID_PREFIX = 'IB';
      const USER_ID_TOTAL_LENGTH = 8;
      const USER_ID_SUFFIX_LENGTH = USER_ID_TOTAL_LENGTH - USER_ID_PREFIX.length;

      let currentUser = null;
      let userIdValue = '';
      let imageDataUrl = '';

      const toBase36Padded = (num, len) => (num >>> 0).toString(36).toUpperCase().padStart(len, '0').slice(-len);

      function generateDeterministicUserId(uid, salt) {
        if (!uid) return 'IB000000';
        const input = String(uid) + '|' + String(salt || 0) + '|IBR';
        let hash = 2166136261;
        for (let i = 0; i < input.length; i++) {
          hash ^= input.charCodeAt(i);
          hash = Math.imul(hash, 16777619);
        }
        return USER_ID_PREFIX + toBase36Padded(hash, USER_ID_SUFFIX_LENGTH);
      }

      async function createUniqueUserIdForUser(user) {
        const deterministicFallback = generateDeterministicUserId(user && user.uid, 0);
        const profileRef = db.collection('userProfiles').doc(user.uid);

        for (let attempt = 0; attempt < 200; attempt++) {
          const candidate = generateDeterministicUserId(user.uid, attempt);
          const candidateRef = db.collection('userIds').doc(candidate);

          try {
            const assigned = await db.runTransaction(async function (tx) {
              const profileSnap = await tx.get(profileRef);
              if (profileSnap.exists) {
                const existing = profileSnap.data() && profileSnap.data().userId;
                if (existing && typeof existing === 'string') return existing.toUpperCase();
              }

              const candidateSnap = await tx.get(candidateRef);
              if (candidateSnap.exists) {
                const data = candidateSnap.data() || {};
                if (data.uid !== user.uid) throw new Error('collision');
              }

              tx.set(candidateRef, { uid: user.uid, email: user.email || '', updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
              tx.set(profileRef, { userId: candidate, email: user.email || '', updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
              return candidate;
            });

            if (assigned) return assigned.toUpperCase();
          } catch (err) {
            if (err && err.message === 'collision') continue;
            throw err;
          }
        }

        return deterministicFallback;
      }

      async function getOrCreateUserId(user) {
        const deterministicFallback = generateDeterministicUserId(user && user.uid, 0);
        const profileSnap = await db.collection('userProfiles').doc(user.uid).get();
        if (profileSnap.exists) {
          const data = profileSnap.data() || {};
          if (data.userId && typeof data.userId === 'string') return data.userId.toUpperCase();
        }
        return createUniqueUserIdForUser(user).catch(function () { return deterministicFallback; });
      }

      function setPublicLink(userId) {
        const href = '/public/' + encodeURIComponent(userId) + '.html';
        publicProfileLink.href = href;
        publicProfileLink.textContent = href;
        if (openPublicProfileBtn) openPublicProfileBtn.href = href;
      }

      function setStatus(text) {
        profileStatus.textContent = text;
      }

      function normalizeText(value, max) {
        const text = String(value || '').trim();
        return typeof max === 'number' ? text.slice(0, max) : text;
      }

      function normalizeUrl(value) {
        const input = normalizeText(value, 300);
        if (!input) return '';
        try {
          const u = new URL(input);
          if (u.protocol !== 'http:' && u.protocol !== 'https:') return '';
          return u.toString();
        } catch {
          return '';
        }
      }

      function downscaleImageToDataUrl(file) {
        return new Promise(function (resolve, reject) {
          const reader = new FileReader();
          reader.onload = function () {
            const img = new Image();
            img.onload = function () {
              const canvas = document.createElement('canvas');
              const maxSide = 512;
              const scale = Math.min(1, maxSide / Math.max(img.width, img.height));
              canvas.width = Math.max(1, Math.round(img.width * scale));
              canvas.height = Math.max(1, Math.round(img.height * scale));
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
              const dataUrl = canvas.toDataURL('image/jpeg', 0.82);
              if (dataUrl.length > 900000) {
                reject(new Error('Image too large after processing.')); return;
              }
              resolve(dataUrl);
            };
            img.onerror = function () { reject(new Error('Unsupported image file.')); };
            img.src = String(reader.result || '');
          };
          reader.onerror = function () { reject(new Error('Unable to read image file.')); };
          reader.readAsDataURL(file);
        });
      }

      async function loadProfile(uid = '') {
        const snap = await db.collection('publicProfiles').doc(uid).get();
        const data = snap.exists ? (snap.data() || {}) : {};

        if (publicProfileDocStatus) {
          publicProfileDocStatus.textContent = snap.exists ? 'Profile record: found' : 'Profile record: not saved yet';
        }

        firstNameInput.value = normalizeText(data.firstName, 50);
        lastNameInput.value = normalizeText(data.lastName, 50);
        bioInput.value = normalizeText(data.bio, 1000);
        socialLabelInput.value = normalizeText(data.socialLabel, 40);
        socialUrlInput.value = normalizeText(data.socialUrl, 300);

        imageDataUrl = normalizeText(data.imageDataUrl);
        profileImagePreview.src = imageDataUrl || DEFAULT_PUBLIC_IMAGE;
      }

      async function saveProfile() {
        if (!currentUser || !userIdValue) return;

        const firstName = normalizeText(firstNameInput.value, 50);
        const lastName = normalizeText(lastNameInput.value, 50);
        const bio = normalizeText(bioInput.value, 1000);
        const socialLabel = normalizeText(socialLabelInput.value, 40);
        const socialUrl = normalizeUrl(socialUrlInput.value);

        if (socialUrlInput.value && !socialUrl) {
          setStatus('Please enter a valid http(s) social URL.');
          return;
        }

        saveProfileBtn.disabled = true;
        setStatus('Saving profile...');
        try {
          const payload = {
            uid: currentUser.uid,
            userId: userIdValue,
            firstName: firstName,
            lastName: lastName,
            bio: bio,
            socialLabel: socialLabel,
            socialUrl: socialUrl,
            imageDataUrl: imageDataUrl || '',
            updatedAt: firebase.firestore.FieldValue.serverTimestamp()
          };

          await db.collection('publicProfiles').doc(currentUser.uid).set(payload, { merge: true });

          if (publicProfileDocStatus) publicProfileDocStatus.textContent = 'Profile record: saved';
          setStatus('Profile saved successfully.');
        } catch (err) {
          console.error('Profile save failed', err);
          const message = err && err.message ? err.message : 'unknown error';
          setStatus('Profile save failed: ' + message);
        } finally {
          saveProfileBtn.disabled = false;
        }
      }

      function showSignedOut() {
        loginSection.style.display = 'block';
        profileShell.style.display = 'none';
        signOutBtn.style.display = 'none';
        signInLink.style.display = 'inline-flex';
        if (messagesLink) messagesLink.style.display = 'none';
        if (topNavMenu) topNavMenu.style.display = 'none';
        document.body.classList.remove('auth-pending');
        document.body.classList.remove('has-sidebar');
        if (publicProfileDocStatus) publicProfileDocStatus.textContent = 'Public profile record: sign in to view';
      }

      async function showAuthenticated(user) {
        currentUser = user;
        loginSection.style.display = 'none';
        profileShell.style.display = 'block';
        signOutBtn.style.display = 'inline-flex';
        signInLink.style.display = 'none';
        if (messagesLink) messagesLink.style.display = 'inline-flex';
        if (topNavMenu) topNavMenu.style.display = 'block';
        document.body.classList.remove('auth-pending');
        document.body.classList.add('has-sidebar');

        setStatus('Loading profile...');
        userIdValue = await getOrCreateUserId(user);
        setPublicLink(userIdValue);
        await loadProfile(user.uid);
        if (publicProfileDocStatus) publicProfileDocStatus.textContent = 'Public profile record: loading...';
        setStatus('Profile loaded.');
      }

      auth.onAuthStateChanged(async function (user) {
        if (!user) {
          currentUser = null;
          showSignedOut();
          return;
        }
        try {
          await showAuthenticated(user);
        } catch (err) {
          console.error('Profile load failed', err);
          setStatus('Unable to load profile right now.');
        }
      });

      profileImageInput.addEventListener('change', async function () {
        const file = profileImageInput.files && profileImageInput.files[0];
        if (!file) return;
        try {
          const url = await downscaleImageToDataUrl(file);
          imageDataUrl = url;
          profileImagePreview.src = imageDataUrl;
          setStatus('Image ready. Save profile to publish it.');
        } catch (err) {
          console.error('Image processing failed', err);
          setStatus(err && err.message ? err.message : 'Image upload failed.');
        }
      });

      saveProfileBtn.addEventListener('click', saveProfile);

      signOutBtn.addEventListener('click', function () {
        auth.signOut().then(function () {
          showSignedOut();
          window.location.replace('/loggedout.html');
        });
      });
    });
  </script>
</body>
</html>
