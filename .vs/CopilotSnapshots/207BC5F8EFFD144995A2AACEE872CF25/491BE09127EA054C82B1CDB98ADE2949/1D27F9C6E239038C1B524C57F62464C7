{
  "functions": {
    "source": "functions"
  },
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules"
    },
    {
      "database": "ibusername",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".vs/**",
      "app/**",
      "functions/**",
      "firebase-debug.log",
      "*.md",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "*.sln",
      "*.slnx",
      "wasnt-sure.txt",
      "flist.json"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/login", "destination": "/login.html" },
      { "source": "/index", "destination": "/index.html" },
      { "source": "/profile.html", "destination": "/editprofile.html" },
      { "source": "/profile/**", "function": "publicProfilePage" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "no-referrer-when-downgrade" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
        ]
      }
    ]
  }
}
