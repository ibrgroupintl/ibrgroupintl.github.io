    <section id="loginSection" class="auth-shell">
      <h1 style="margin:0;color:#092a4b">Accounts Admin</h1>
      <p style="margin:.75rem 0 1.25rem;color:var(--muted)">Sign in with a Firebase admin account (with <code>admin</code> or <code>ownerAdmin</code> access) to manage user access.</p>
      <a class="btn btn-primary" href="/login.html">Go to Sign In</a>
    </section>

    <section id="deniedSection" class="auth-shell" style="display:none">
      <h2 style="margin:0;color:#092a4b">Access denied</h2>
      <p style="margin:.75rem 0 1.25rem;color:var(--muted)">This page is restricted to Firebase users with <code>admin</code> or <code>ownerAdmin</code> access. Please contact the site administrator if you need access.</p>
      <a class="btn btn-outline" href="/messages.html">Back to Messages</a>
    </section>

    <main id="accountsShell" class="accounts-shell" role="main">
      <section class="hero">
        <h1>Accounts Admin</h1>
        <p>Manage non-admin authenticated users from Firebase Authentication (project: <strong>wale-491803</strong>).</p>
      </section>

      <section class="panel" aria-label="Non-admin accounts">
        <div class="panel-head">
          <h2 style="margin:0;color:#092a4b">Non-admin user accounts</h2>
          <button type="button" class="btn btn-outline" id="refreshBtn">Refresh list</button>
        </div>
        <div class="panel-body">
          <p id="statusNote" class="status-note">Loading accounts...</p>
          <div class="accounts-table-wrap">
            <table class="accounts-table" aria-describedby="statusNote">
              <thead>
                <tr>
                  <th>User ID</th>
                  <th>Email</th>
                  <th>Display name</th>
                  <th>Status</th>
                  <th>Last sign in</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="accountsRows"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="panel" aria-label="Administrator accounts" style="margin-top:1rem">
        <div class="panel-head">
          <h2 style="margin:0;color:#092a4b">Administrator accounts</h2>
        </div>
        <div class="panel-body">
          <p id="adminStatusNote" class="status-note">Loading admin accounts...</p>
          <div class="accounts-table-wrap">
            <table class="accounts-table" aria-describedby="adminStatusNote">
              <thead>
                <tr>
                  <th>User ID</th>
                  <th>Email</th>
                  <th>Display name</th>
                  <th>Status</th>
                  <th>Last sign in</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="adminRows"></tbody>
            </table>
          </div>
        </div>
