          <span style="color:var(--muted)">|</span>
          <a href="/cookies.html" style="color:var(--muted);text-decoration:none;font-size:.9rem;">Cookie Policy</a>
        </div>
        <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
      </div>
    </footer>
  </div>

  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-functions-compat.js"></script>
  <script defer src="/firebase-config.js"></script>
  <script defer src="/header-profile.js"></script>
  <script defer src="/mobile-compat.js"></script>
  <script defer src="/page-transition.js"></script>

  <script>
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) return;
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) { }

      const AUTHORIZED_ADMIN_EMAIL = 'developers@ibrecruitment.com';
      const ADMIN_ENDPOINTS = [
  '/adminAccountsManager',
  'https://us-central1-wale-491803.cloudfunctions.net/adminAccountsManager'
];

      const auth = firebase.auth();
      const functionsClient = (firebase.app && typeof firebase.app === 'function' && firebase.app().functions)
  ? firebase.app().functions('us-central1')
  : null;
const loginSection = document.getElementById('loginSection');
const deniedSection = document.getElementById('deniedSection');
const accountsShell = document.getElementById('accountsShell');
const signOutBtn = document.getElementById('signOutBtn');
const signInLink = document.getElementById('signInLink');
const messagesLink = document.getElementById('messagesLink');
const composeLink = document.getElementById('composeLink');
const topNavMenu = document.getElementById('topNavMenu');
const refreshBtn = document.getElementById('refreshBtn');
const accountsRows = document.getElementById('accountsRows');
const adminRows = document.getElementById('adminRows');
const statusNote = document.getElementById('statusNote');
const adminStatusNote = document.getElementById('adminStatusNote');

      let currentUser = null;

      function esc(v) {
        return String(v || '').replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; });
      }

      function formatDate(value) {
        const d = value ? new Date(value) : null;
        if (!d || isNaN(d.getTime())) return 'Never';
        return new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          year: 'numeric',
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZoneName: 'short'
        }).format(d);
      }

      function tokenHasAdminAccess(email, claims) {
        const normalized = String(email || '').trim().toLowerCase();
        const c = claims && typeof claims === 'object' ? claims : {};
        // Always grant admin access to developers@ibrecruitment.com
        if (normalized === 'developers@ibrecruitment.com') return true;
        return normalized === AUTHORIZED_ADMIN_EMAIL || c.admin === true || c.ownerAdmin === true;
      }

      async function callAdminEndpoint(method, payload) {
        if (!currentUser) throw new Error('Not signed in');

        if (functionsClient && typeof functionsClient.httpsCallable === 'function') {
          try {
            const callable = functionsClient.httpsCallable('adminAccountsManagerCallable');
            const mode = method === 'GET' ? 'list' : 'action';
            const result = await callable({ mode: mode, uid: payload && payload.uid, action: payload && payload.action });
            const data = result && result.data ? result.data : {};
            if (!data.ok) throw new Error(data.error || 'Request failed');
            return data;
          } catch (err) {
            console.warn('Callable adminAccountsManagerCallable failed, trying HTTP fallback', err);
          }
        }

        const token = await currentUser.getIdToken(true);
        let lastError = null;

        for (let i = 0; i < ADMIN_ENDPOINTS.length; i += 1) {
          const endpoint = ADMIN_ENDPOINTS[i];
          const url = endpoint.startsWith('http') ? endpoint : new URL(endpoint, window.location.origin).toString();

          try {
            const response = await fetch(url, {
              method: method,
              mode: 'cors',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + token
              },
              body: method === 'POST' ? JSON.stringify(payload || {}) : undefined
            });

            const data = await response.json().catch(function () { return {}; });
            if (!response.ok || !data.ok) {
              throw new Error((data && data.error) ? data.error : ('Request failed (' + response.status + ')'));
            }

            return data;
          } catch (err) {
            lastError = err;
          }
        }

        throw new Error(lastError && lastError.message ? lastError.message : 'Failed to fetch');
      }

      function wireRowActions(container) {
        Array.from(container.querySelectorAll('button[data-action]')).forEach(function (btn) {
          btn.addEventListener('click', async function () {
            const row = btn.closest('tr');
            const uid = row && row.getAttribute('data-uid') ? row.getAttribute('data-uid') : '';
            const action = btn.getAttribute('data-action') || '';
            if (!uid || !action) return;

            let confirmMessage = 'Update this account?';
            if (action === 'grantAdmin') confirmMessage = 'Grant admin access to this account?';
            else if (action === 'revokeAdmin') confirmMessage = 'Revoke admin access from this account?';
            else if (action === 'ban') confirmMessage = 'Ban this account from signing in?';
            else if (action === 'unban') confirmMessage = 'Unban this account?';
            if (!window.confirm(confirmMessage)) return;

            btn.disabled = true;
            statusNote.textContent = 'Updating account...';
            adminStatusNote.textContent = 'Updating account...';
            try {
              await callAdminEndpoint('POST', { uid: uid, action: action });
              await loadAccounts();
            } catch (err) {
              const msg = 'Update failed: ' + (err && err.message ? err.message : 'unknown error');
              statusNote.textContent = msg;
              adminStatusNote.textContent = msg;
            } finally {
              btn.disabled = false;
            }
          });
        });
      }

      function formatUserId(uid) {
        const source = String(uid || '');
        let hash = 0;
        for (let i = 0; i < source.length; i += 1) {
          hash = (hash * 31 + source.charCodeAt(i)) % 100000000;
        }
        return String(hash).padStart(8, '0');
      }

      function renderRows(users) {
        if (!users.length) {
          accountsRows.innerHTML = '<tr><td colspan="6" style="color:var(--muted)">No non-admin authenticated users found.</td></tr>';
          statusNote.textContent = '0 accounts loaded.';
          return;
        }

        let missingIds = 0;
        accountsRows.innerHTML = users.map(function (u) {
          const statusPill = u.disabled ? '<span class="pill banned">Banned</span>' : '<span class="pill active">Active</span>';
          const banLabel = u.disabled ? 'Unban' : 'Ban';
          const banAction = u.disabled ? 'unban' : 'ban';
          const resolvedUserId = String(u.userId || '').trim().toUpperCase();
          const userIdCell = resolvedUserId
            ? esc(resolvedUserId)
            : (missingIds++, '<span class="missing-userid">Missing ID</span>');
          return '<tr data-uid="' + esc(u.uid) + '">' +
            '<td>' + userIdCell + '</td>' +
            '<td>' + esc(u.email || '') + '</td>' +
            '<td>' + esc(u.displayName || '-') + '</td>' +
            '<td>' + statusPill + '</td>' +
            '<td>' + esc(formatDate(u.lastSignInAt)) + '</td>' +
            '<td><div class="action-row">' +
            '<button type="button" class="btn btn-outline" data-action="' + banAction + '">' + banLabel + '</button>' +
            '<button type="button" class="btn btn-primary" data-action="grantAdmin">Grant admin</button>' +
            '</div></td>' +
            '</tr>';
        }).join('');

        wireRowActions(accountsRows);
        statusNote.textContent = users.length + ' account' + (users.length === 1 ? '' : 's') + ' loaded.' + (missingIds ? (' ' + missingIds + ' missing User ID mapping' + (missingIds === 1 ? '.' : 's.')) : '');
      }

      function renderAdminRows(users) {
        if (!users.length) {
          adminRows.innerHTML = '<tr><td colspan="6" style="color:var(--muted)">No administrator accounts found.</td></tr>';
          adminStatusNote.textContent = '0 admin accounts loaded.';
          return;
        }

        let missingIds = 0;
        adminRows.innerHTML = users.map(function (u) {
          const statusPill = u.disabled ? '<span class="pill banned">Banned</span>' : '<span class="pill active">Active</span>';
          const isPrimaryAdmin = String(u.email || '').toLowerCase() === AUTHORIZED_ADMIN_EMAIL;
          const actionHtml = isPrimaryAdmin
            ? '<span style="color:var(--muted);font-size:.85rem">Protected</span>'
            : '<button type="button" class="btn btn-outline" data-action="revokeAdmin">Revoke admin</button>';
          const resolvedUserId = String(u.userId || '').trim().toUpperCase();
          const userIdCell = resolvedUserId
            ? esc(resolvedUserId)
            : (missingIds++, '<span class="missing-userid">Missing ID</span>');
          return '<tr data-uid="' + esc(u.uid) + '">' +
            '<td>' + userIdCell + '</td>' +
            '<td>' + esc(u.email || '') + '</td>' +
            '<td>' + esc(u.displayName || '-') + '</td>' +
            '<td>' + statusPill + '</td>' +
            '<td>' + esc(formatDate(u.lastSignInAt)) + '</td>' +
            '<td><div class="action-row">' + actionHtml + '</div></td>' +
            '</tr>';
        }).join('');

        wireRowActions(adminRows);
        adminStatusNote.textContent = users.length + ' admin account' + (users.length === 1 ? '' : 's') + ' loaded.' + (missingIds ? (' ' + missingIds + ' missing User ID mapping' + (missingIds === 1 ? '.' : 's.')) : '');
      }

      const db = firebase.firestore();

      async function attachUserIds(users) {
        // Fetch userId for each user from userProfiles
        const promises = users.map(async (u) => {
          try {
            const snap = await db.collection('userProfiles').doc(u.uid).get();
            if (snap.exists && snap.data().userId) {
              u.userId = snap.data().userId;
            } else {
              u.userId = '';
            }
          } catch {
            u.userId = '';
          }
          return u;
        });
        return Promise.all(promises);
      }

      async function loadAccounts() {
        statusNote.textContent = 'Loading accounts...';
        adminStatusNote.textContent = 'Loading admin accounts...';
        try {
          const data = await callAdminEndpoint('GET');
          let users = Array.isArray(data.users) ? data.users : [];
          let adminUsers = Array.isArray(data.adminUsers) ? data.adminUsers : [];
          users = await attachUserIds(users);
          adminUsers = await attachUserIds(adminUsers);
          renderRows(users);
          renderAdminRows(adminUsers);
        } catch (err) {
          accountsRows.innerHTML = '';
          adminRows.innerHTML = '';
          const msg = 'Unable to load accounts: ' + (err && err.message ? err.message : 'unknown error');
          statusNote.textContent = msg;
          adminStatusNote.textContent = msg;
        }
      }

      function showSignedOut() {
        loginSection.style.display = 'block';
        deniedSection.style.display = 'none';
        accountsShell.style.display = 'none';
        signOutBtn.style.display = 'none';
        signInLink.style.display = 'inline-flex';
        if (messagesLink) messagesLink.style.display = 'none';
        if (composeLink) composeLink.style.display = 'none';
        if (topNavMenu) topNavMenu.style.display = 'none';
        document.body.classList.remove('auth-pending');
        document.body.classList.remove('has-sidebar');
      }

      function showDenied() {
        loginSection.style.display = 'none';
        deniedSection.style.display = 'block';
        accountsShell.style.display = 'none';
        signOutBtn.style.display = 'inline-flex';
        signInLink.style.display = 'none';
        if (messagesLink) messagesLink.style.display = 'inline-flex';
        if (composeLink) composeLink.style.display = 'none';
        if (topNavMenu) topNavMenu.style.display = 'none';
        document.body.classList.remove('auth-pending');
        document.body.classList.remove('has-sidebar');
      }

      function showAdmin() {
        loginSection.style.display = 'none';
        deniedSection.style.display = 'none';
        accountsShell.style.display = 'block';
        signOutBtn.style.display = 'inline-flex';
        signInLink.style.display = 'none';
        if (messagesLink) messagesLink.style.display = 'inline-flex';
        if (composeLink) composeLink.style.display = 'inline-flex';
        if (topNavMenu) topNavMenu.style.display = 'block';
        document.body.classList.remove('auth-pending');
        document.body.classList.add('has-sidebar');
      }

      auth.onAuthStateChanged(async function (user) {
        currentUser = user || null;
        if (!user) {
          showSignedOut();
          return;
        }

        let claims = {};
        try {
          const tokenResult = await user.getIdTokenResult(true);
          claims = tokenResult && tokenResult.claims ? tokenResult.claims : {};
        } catch (err) {
          claims = {};
        }

        if (!tokenHasAdminAccess(user.email, claims)) {
          showDenied();
          return;
        }

        showAdmin();
        await loadAccounts();
      });

      if (refreshBtn) {
        refreshBtn.addEventListener('click', function () { loadAccounts(); });
      }

      if (signOutBtn) {
        signOutBtn.addEventListener('click', function () {
          auth.signOut().then(function () {
            showSignedOut();
            window.location.replace('/loggedout.html');
          });
        });
      }
    });
  </script>
</body>
