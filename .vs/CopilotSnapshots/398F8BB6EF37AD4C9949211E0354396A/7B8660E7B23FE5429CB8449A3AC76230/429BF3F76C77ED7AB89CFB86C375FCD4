  <link rel="stylesheet" href="/mobile-compat.css">
  <link rel="stylesheet" href="/page-transition.css">
  <style>
    .page-wrapper { background:#fff; max-width:1920px; min-height:100vh; margin:0 auto; box-shadow:0 0 20px rgba(0,0,0,.1); }
    .sidebar-menu-shell { display:none; position:fixed; top:88px; left:24px; width:220px; background:#fff; border:1px solid #dbe3ee; border-radius:12px; box-shadow:0 10px 24px rgba(2,6,23,.12); padding:10px 0; z-index:950; }
    .sidebar-menu-link { display:block; padding:11px 14px; margin:2px 8px; border-radius:8px; color:#092a4b; text-decoration:none; font-size:.95rem; font-weight:600; transition:background-color .2s ease,color .2s ease,transform .2s ease; }
    .sidebar-menu-link:hover,.sidebar-menu-link:focus { background:#092a4b; color:#fff; transform:translateX(3px); }
    body.has-sidebar .accounts-shell { margin-left:260px; }
    .message-icon-link { width:42px; height:42px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; border:1px solid #c7d2fe; background:#eef2ff; color:#092a4b; text-decoration:none; }
    .message-icon-link:hover,.message-icon-link:focus { background:#092a4b; border-color:#092a4b; color:#fff; }
    .accounts-shell { display:none; max-width:1180px; margin:2rem auto 3rem; padding:0 1rem; }
    .auth-shell { max-width:760px; margin:2rem auto; padding:2rem; border-radius:16px; border:1px solid #dbe3ee; background:linear-gradient(145deg,#fff 0%,#f6fbff 100%); text-align:center; box-shadow:0 8px 24px rgba(2,6,23,.08); }
    .panel { background:#fff; border:1px solid #dbe3ee; border-radius:14px; box-shadow:0 6px 20px rgba(2,6,23,.06); }
    .panel-head { padding:1rem; border-bottom:1px solid #edf2f7; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
    .panel-body { padding:1rem; }
    .status-note { margin:.75rem 0 0; color:var(--muted); }
    .accounts-table-wrap { overflow:auto; border:1px solid #e6edf5; border-radius:10px; }
    .accounts-table { width:100%; border-collapse:collapse; min-width:760px; }
    .accounts-table th,.accounts-table td { padding:.7rem .75rem; border-bottom:1px solid #eef2f7; text-align:left; font-size:.9rem; }
    .accounts-table th { background:#f8fbff; color:#0f2f4f; }
    .accounts-table tr:last-child td { border-bottom:0; }
    .action-row { display:flex; gap:8px; flex-wrap:wrap; }
    .pill { display:inline-flex; align-items:center; border-radius:999px; padding:3px 9px; font-size:.75rem; font-weight:600; }
    .pill.active { background:#dcfce7; color:#166534; }
    .pill.banned { background:#fee2e2; color:#991b1b; }
    .hero { margin-bottom:1rem; padding:1rem 1.1rem; border:1px solid #dbe3ee; border-radius:14px; background:linear-gradient(115deg,#f0f8ff 0%,#f8fbff 55%,#fff 100%); }
    .hero h1 { margin:0; color:#092a4b; font-size:1.35rem; }
    .hero p { margin:.45rem 0 0; color:var(--muted); }
    .missing-userid {
      display:inline-flex;
      align-items:center;
      border-radius:999px;
      padding:3px 9px;
      font-size:.75rem;
      font-weight:600;
      background:#fff7ed;
      color:#9a3412;
      border:1px solid #fdba74;
    }
    @media (max-width:980px){ .sidebar-menu-shell{ position:static; width:100%; max-width:1180px; margin:12px auto; } body.has-sidebar .accounts-shell{ margin-left:auto; } }
  </style>
</head>
