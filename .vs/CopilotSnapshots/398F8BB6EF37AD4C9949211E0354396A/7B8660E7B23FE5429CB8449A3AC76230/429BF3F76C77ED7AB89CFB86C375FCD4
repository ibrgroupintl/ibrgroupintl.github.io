        <div class="user-menu" style="margin-left:auto;display:flex;align-items:center;gap:12px">
          <div class="auth-profile-chip" data-auth-profile>
            <img class="auth-profile-photo" data-auth-photo src="/160.jpg" alt="Profile photo">
            <span class="auth-profile-name" data-auth-name></span>
          </div>
          <a class="message-icon-link" href="/compose.html" id="composeLink" aria-label="Compose secure message" title="Compose message" style="display:none">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
            </svg>
          </a>
          <a class="message-icon-link" href="/messages.html" id="messagesLink" aria-label="Open secure messages inbox" title="Messages inbox" style="display:none">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path><path d="M6 8l6 4 6-4"></path>
            </svg>
