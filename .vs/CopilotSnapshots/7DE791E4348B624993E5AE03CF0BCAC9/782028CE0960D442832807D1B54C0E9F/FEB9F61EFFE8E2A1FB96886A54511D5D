rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        (resource.data.recipientUid is string && resource.data.recipientUid == request.auth.uid) ||
        (request.auth.token.email is string && request.auth.token.email == 'developers@ibrecruitment.com')
      );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
