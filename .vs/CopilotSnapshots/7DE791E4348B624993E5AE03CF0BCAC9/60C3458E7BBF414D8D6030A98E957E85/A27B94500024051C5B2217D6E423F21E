<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#0284c7">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="index, nofollow">
  <title>Messages Inbox — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/resource-centre.css">
  <link rel="stylesheet" href="/index.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    .page-wrapper {
      background: white;
      max-width: 1920px;
      min-height: 100vh;
      margin: 0 auto;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .contact-code {
      font-family: Arial, Helvetica, sans-serif;
    }

    .nav-dropdown {
      position: relative;
      display: inline-block;
    }

    .dropdown-btn {
      background: #eef2ff;
      border: 1px solid #c7d2fe;
      color: #092a4b;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .dropdown-btn:hover,
    .dropdown-btn:focus {
      background: #092a4b;
      border-color: #092a4b;
      color: #fff;
    }

    .dropdown-content {
      display: none;
      position: absolute;
      background-color: #ffffff;
      min-width: 220px;
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.18);
      padding: 8px 0;
      z-index: 2;
      border-radius: 8px;
      border: 1px solid #dbe3ee;
      top: 100%;
      left: 0;
      margin-top: 6px;
      overflow: hidden;
    }

    .dropdown-content a {
      color: #092a4b !important;
      padding: 12px 20px;
      text-decoration: none;
      display: block;
      font-size: 0.95rem;
    }

    .dropdown-content a:hover {
      background-color: #092a4b;
      color: #ffffff !important;
    }

    .nav-dropdown:hover .dropdown-content {
      display: block;
    }

    .message-icon-link {
      width: 42px;
      height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      border: 1px solid #c7d2fe;
      background: #eef2ff;
      color: #092a4b;
      text-decoration: none;
      position: relative;
    }

    .message-unread-dot {
      position: absolute;
      top: 5px;
      right: 5px;
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: #22c55e;
      border: 2px solid #ffffff;
      box-shadow: 0 0 0 1px rgba(2, 42, 75, 0.12);
      display: none;
      pointer-events: none;
    }

    .message-icon-link:hover,
    .message-icon-link:focus {
      background: #092a4b;
      border-color: #092a4b;
      color: #fff;
    }

    .auth-shell {
      max-width: 760px;
      margin: 2rem auto;
      padding: 2rem;
      border-radius: 16px;
      border: 1px solid #dbe3ee;
      background: linear-gradient(145deg, #ffffff 0%, #f6fbff 100%);
      text-align: center;
      box-shadow: 0 8px 24px rgba(2, 6, 23, 0.08);
    }

    .dashboard {
      display: none;
      max-width: 1180px;
      margin: 2rem auto 3rem;
      padding: 0 1rem;
    }

    .dashboard-hero {
      padding: 1.1rem 1.2rem;
      border: 1px solid #dbe3ee;
      border-radius: 14px;
      background: linear-gradient(115deg, #f0f8ff 0%, #f8fbff 55%, #ffffff 100%);
      box-shadow: 0 6px 20px rgba(2, 6, 23, 0.06);
      margin-bottom: 1rem;
    }

    .hero-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .hero-title {
      margin: 0;
      color: #092a4b;
      font-size: 1.35rem;
    }

    .hero-subtitle {
      margin: 0.35rem 0 0;
      color: var(--muted);
    }

    .stats-grid {
      margin-top: 1rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px;
    }

    .stat-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 0.85rem 1rem;
    }

    .stat-label {
      color: var(--muted);
      font-size: 0.85rem;
      margin: 0 0 0.3rem;
    }

    .stat-value {
      margin: 0;
      font-size: 1.25rem;
      color: #092a4b;
      font-weight: 700;
    }

    .workspace {
      display: grid;
      grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
      gap: 12px;
      align-items: start;
    }

    .panel {
      background: #fff;
      border: 1px solid #dbe3ee;
      border-radius: 14px;
      box-shadow: 0 6px 20px rgba(2, 6, 23, 0.06);
    }

    .panel-head {
      padding: 0.9rem 1rem;
      border-bottom: 1px solid #edf2f7;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .panel-body {
      padding: 0.9rem 1rem 1rem;
    }

    .panel-head h2 {
      margin: 0;
      color: #092a4b;
      font-size: 1rem;
    }

    .folder-tabs {
      display: inline-flex;
      border: 1px solid #dbe3ee;
      border-radius: 10px;
      overflow: hidden;
    }

    .folder-btn {
      border: 0;
      background: #fff;
      color: #334155;
      font-weight: 600;
      padding: 7px 12px;
      cursor: pointer;
      font-size: 0.86rem;
    }

    .folder-btn+ .folder-btn {
      border-left: 1px solid #e2e8f0;
    }

    .folder-btn.active {
      background: #e0f2fe;
      color: #0c4a6e;
    }

    .search-input {
      width: 100%;
      border-radius: 10px;
      border: 1px solid #d0d7de;
      padding: 10px 12px;
      box-sizing: border-box;
      outline: none;
    }

    .search-input:focus {
      border-color: #0284c7;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
    }

    .inbox-status {
      margin: 0.75rem 0 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .thread-list {
      margin-top: 0.85rem;
      display: grid;
      gap: 8px;
      max-height: 620px;
      overflow: auto;
    }

    .thread-item {
      border: 1px solid #e6edf5;
      border-radius: 10px;
      padding: 0.75rem 0.8rem;
      cursor: pointer;
      background: #fff;
      text-align: left;
    }

    .thread-item:hover {
      border-color: #9dd6f2;
      background: #f8fcff;
    }

    .thread-item.active {
      border-color: #0284c7;
      background: #eff9ff;
      box-shadow: inset 0 0 0 1px rgba(2, 132, 199, 0.2);
    }

    .thread-title {
      margin: 0;
      color: #092a4b;
      font-size: 0.95rem;
      font-weight: 700;
    }

    .thread-snippet {
      margin: 0.35rem 0 0;
      color: #4d5b6d;
      font-size: 0.88rem;
      line-height: 1.35;
    }

    .thread-meta {
      margin-top: 0.5rem;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      color: #64748b;
      font-size: 0.79rem;
      flex-wrap: wrap;
    }

    .message-viewer {
      min-height: 520px;
      display: flex;
      flex-direction: column;
    }

    .message-empty {
      margin: auto;
      max-width: 440px;
      text-align: center;
      color: var(--muted);
    }

    .message-card {
      border: 1px solid #e6edf5;
      border-radius: 12px;
      padding: 1rem;
      background: #fff;
    }

    .message-head {
      display: grid;
      gap: 8px;
      margin-bottom: 0.95rem;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid #eef2f7;
    }

    .message-subject {
      margin: 0;
      color: #092a4b;
      font-size: 1.2rem;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 3px 9px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .pill.delivered {
      background: #dcfce7;
      color: #166534;
    }

    .pill.queued {
      background: #dbeafe;
      color: #1e40af;
    }

    .pill.stored {
      background: #f1f5f9;
      color: #334155;
    }

    .message-body {
      margin: 0;
      white-space: pre-wrap;
      word-break: break-word;
      line-height: 1.5;
      color: #1f2937;
    }

    @media (max-width: 980px) {
      .workspace {
        grid-template-columns: 1fr;
      }

      .message-viewer {
        min-height: 360px;
      }

      .thread-list {
        max-height: 360px;
      }
    }
  </style>
</head>

<body>
  <div class="page-wrapper">
    <header class="resource-nav" role="banner">
      <div class="container container-nav">
        <div class="logo" style="display:flex;align-items:center;gap:12px">
          <img src="/160.jpg" alt="Impact logo" class="site-logo" style="height:36px;width:auto;display:block">
          <span class="site-title" style="color:lightgrey">Impact in Business Recruitment</span>
        </div>

        <div style="flex:1;display:none;align-items:center;margin-left:24px" id="topNavMenu">
          <div class="nav-dropdown">
            <button class="dropdown-btn">☰ Menu</button>
            <div class="dropdown-content">
              <a href="/index.html">Members Area</a>
              <a href="/messages.html">Messages Inbox</a>
              <a href="/insights.html">Insights Archive</a>
              <a href="/uploads.html">Resume Uploads</a>
              <a href="/settings.html">Account Settings</a>
              <a href="https://www.ibrecruitment.com/contact" target="_blank" rel="noopener noreferrer">Contact</a>
