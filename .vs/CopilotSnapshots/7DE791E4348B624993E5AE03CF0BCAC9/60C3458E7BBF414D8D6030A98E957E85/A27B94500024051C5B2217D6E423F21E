  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <script defer src="/firebase-config.js"></script>

  <script>
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) return;
      try {
        firebase.initializeApp(window.firebaseConfig);
      } catch (e) { }

      const AUTHORIZED_COMPOSE_EMAIL = 'developers@ibrecruitment.com';
      const auth = firebase.auth();
      const db = firebase.firestore();

      const loginSection = document.getElementById('login-section');
      const dashboard = document.getElementById('dashboard');
      const signOutBtn = document.getElementById('signOutBtn');
      const signInLink = document.getElementById('signInLink');
      const topNavMenu = document.getElementById('topNavMenu');
      const composeLink = document.getElementById('composeLink');
      const userEmailDisplay = document.getElementById('userEmailDisplay');
      const messageSearchInput = document.getElementById('messageSearchInput');
      const messagesStatus = document.getElementById('messagesStatus');
      const messagesList = document.getElementById('messagesList');
      const messagePreviewBody = document.getElementById('messagePreviewBody');
      const previewHint = document.getElementById('previewHint');
      const folderInboxBtn = document.getElementById('folderInboxBtn');
      const folderSentBtn = document.getElementById('folderSentBtn');
      const statTotal = document.getElementById('statTotal');
      const statDelivered = document.getElementById('statDelivered');
      const statQueued = document.getElementById('statQueued');
      const statStored = document.getElementById('statStored');
      const messagesUnreadDot = document.getElementById('messagesUnreadDot');

      let unsubscribeInbox = null;
      let allMessages = [];
      let filteredMessages = [];
      let selectedMessageId = '';
      let currentFolder = 'inbox';
      let currentUserUid = '';
      let isAdminUser = false;

      function esc(v) {
        return String(v || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
      }

      function trunc(v, max) {
        const s = String(v || '');
        if (s.length <= max) return s;
        return s.slice(0, Math.max(0, max - 1)) + '…';
      }

      function toMillis(v) {
        if (!v) return 0;
        if (typeof v === 'number') return v;
        if (v.toMillis) return v.toMillis();
        if (v.toDate) return v.toDate().getTime();
        const d = new Date(v);
        return isNaN(d.getTime()) ? 0 : d.getTime();
      }

      function formatDate(v) {
        if (!v) return 'Just now';
        const d = v.toDate ? v.toDate() : new Date(v);
        if (isNaN(d.getTime())) return String(v || 'Just now');
        return new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          year: 'numeric',
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZoneName: 'short'
        }).format(d);
      }

      function delivery(s) {
        s = String(s || '').toLowerCase();
        if (s === 'available' || s === 'delivered') return { label: 'Available', cls: 'delivered' };
        if (s === 'pending' || s === 'queued') return { label: 'Delivered', cls: 'delivered' };
        return { label: 'Stored', cls: 'stored' };
      }

      function resetStats() {
        statTotal.textContent = '0';
        statDelivered.textContent = '0';
        statQueued.textContent = '0';
        statStored.textContent = '0';
      }

      function updateStats(items) {
        let d = 0, q = 0, s = 0;
        items.forEach(i => {
          const n = String(i.messageState || i.deliveryStatus || '').toLowerCase();
          if (n === 'available' || n === 'delivered') d++;
          else if (n === 'pending' || n === 'queued') q++;
          else s++;
        });
        statTotal.textContent = String(items.length);
        statDelivered.textContent = String(d);
        statQueued.textContent = String(q);
        statStored.textContent = String(s);
      }

      async function markMessageOpened(item) {
        if (!item || currentFolder !== 'inbox' || !currentUserUid || item.isOpened === true) return;
        try {
          await db.collection('messages').doc(item.id).update({
            isOpened: true,
            openedAt: firebase.firestore.FieldValue.serverTimestamp(),
            openedByUid: currentUserUid
          });
        } catch (err) {
          console.warn('Failed to mark message opened', err);
        }
      }

      function renderPreview(item) {
        if (!item) {
          previewHint.textContent = 'Select a message';
          messagePreviewBody.innerHTML = '<div class="message-empty"><h3 style="margin:0 0 .5rem;color:#092a4b">No message selected</h3><p style="margin:0">Pick a message from the left column to preview full details.</p></div>';
          return;
        }

        if (currentFolder === 'inbox') {
          markMessageOpened(item);
        }

        const d = delivery(item.messageState || item.deliveryStatus);
        previewHint.textContent = item.receivedAtText;
        messagePreviewBody.innerHTML =
          '<article class="message-card">' +
          '<div class="message-head">' +
          '<h3 class="message-subject">' + esc(item.subject || 'No subject') + '</h3>' +
          '<div style="display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;color:#475569;font-size:.9rem">' +
          '<span><strong>' + (currentFolder === 'sent' ? 'To' : 'From') + ':</strong> ' + esc(currentFolder === 'sent' ? (item.recipientLabel || 'Unknown recipient') : (item.senderEmail || 'admin-messages@ibrecruitment.com')) + '</span>' +
          '<span><strong>Received:</strong> ' + esc(item.receivedAtText) + '</span>' +
          '<span class="pill ' + d.cls + '">' + esc(d.label) + '</span>' +
          '</div>' +
          '</div>' +
          '<p class="message-body">' + esc(item.body || '') + '</p>' +
          '</article>';
      }

      function renderList(items) {
        if (!items.length) {
          messagesStatus.textContent = currentFolder === 'sent' ? 'No sent messages found.' : 'No messages found.';
          messagesList.innerHTML = '';
          renderPreview(null);
          return;
        }

        messagesStatus.textContent = items.length + ' ' + (currentFolder === 'sent' ? 'sent message' : 'message') + (items.length === 1 ? '' : 's') + ' loaded.';
        messagesList.innerHTML = items.map(item => {
          const d = delivery(item.messageState || item.deliveryStatus);
          const active = item.id === selectedMessageId ? ' active' : '';
          const isSent = currentFolder === 'sent';
          const titleText = trunc(item.subject || 'No subject', isSent ? 48 : 72);
          const snippetText = trunc((item.body || '') || '(No message content)', isSent ? 72 : 120);
          const docIdMeta = isSent ? '<span><strong>ID:</strong> ' + esc(item.id) + '</span>' : '';
          return '<button type="button" class="thread-item' + active + '" data-id="' + esc(item.id) + '">' +
            '<p class="thread-title">' + esc(titleText) + '</p>' +
            '<p class="thread-snippet">' + esc(snippetText) + '</p>' +
            '<div class="thread-meta">' +
            '<span>' + esc(isSent ? ('To: ' + trunc(item.recipientLabel || 'Unknown recipient', 36)) : (item.senderEmail || 'admin')) + '</span>' +
            '<span>' + esc(d.label) + '</span>' +
            docIdMeta +
            '</div>' +
            '</button>';
        }).join('');

        Array.from(messagesList.querySelectorAll('.thread-item')).forEach(node => node.addEventListener('click', function () {
          selectedMessageId = node.getAttribute('data-id') || '';
          const selected = filteredMessages.find(x => x.id === selectedMessageId) || null;
          renderList(filteredMessages);
          renderPreview(selected);
        }));

        if (!selectedMessageId) {
          selectedMessageId = items[0].id;
        }
        renderPreview(items.find(x => x.id === selectedMessageId) || items[0]);
      }

      function renderUnreadDotFromItems(items) {
        if (!messagesUnreadDot) return;
        let unread = 0;
        items.forEach(function (item) {
          if (item.isOpened !== true) unread += 1;
        });
        messagesUnreadDot.style.display = unread > 0 ? 'inline-block' : 'none';
      }

      function applySearch() {
        const q = String(messageSearchInput.value || '').trim().toLowerCase();
        filteredMessages = !q ? allMessages.slice() : allMessages.filter(i => [i.subject, i.body, i.senderEmail, i.recipientLabel].join(' ').toLowerCase().indexOf(q) !== -1);
        if (filteredMessages.every(m => m.id !== selectedMessageId)) selectedMessageId = filteredMessages[0] ? filteredMessages[0].id : '';
        renderList(filteredMessages);
      }

      function clearListener() {
        if (typeof unsubscribeInbox === 'function') {
          unsubscribeInbox();
          unsubscribeInbox = null;
        }
      }

      function subscribe() {
        clearListener();

        if (!db || !currentUserUid) {
          allMessages = [];
          filteredMessages = [];
          selectedMessageId = '';
          resetStats();
          messagesStatus.textContent = 'Inbox is unavailable right now.';
          messagesList.innerHTML = '';
          renderPreview(null);
          return;
        }

        messagesStatus.textContent = currentFolder === 'sent' ? 'Loading sent messages...' : 'Loading inbox...';
        const query = (currentFolder === 'sent' && isAdminUser)
          ? db.collection('messages').where('source', '==', AUTHORIZED_COMPOSE_EMAIL)
          : db.collection('messages').where('recipientUid', '==', currentUserUid);

        unsubscribeInbox = query.onSnapshot(function (snapshot) {
          const items = [];
          snapshot.forEach(function (doc) {
            const data = doc.data() || {};
            const receivedAt = data.receivedAt || data.createdAt || data.sentAt || null;
            items.push({
              id: doc.id,
              subject: data.subject || data.title || '',
              body: data.body || data.message || '',
              senderEmail: data.senderEmail || data.fromEmail || 'admin-messages@ibrecruitment.com',
              recipientLabel: data.recipientLoginEmail || data.recipientEmail || '',
              receivedAtText: formatDate(receivedAt),
              receivedAtSort: toMillis(receivedAt),
              deliveryStatus: data.deliveryStatus || '',
              messageState: data.messageState || data.deliveryStatus || 'stored',
              isOpened: data.isOpened === true
            });
          });

          items.sort((a, b) => b.receivedAtSort - a.receivedAtSort);
          allMessages = items;
          updateStats(items);
          renderUnreadDotFromItems(items);
          applySearch();
        }, function () {
          allMessages = [];
          filteredMessages = [];
          selectedMessageId = '';
          resetStats();
          messagesStatus.textContent = 'Unable to load messages right now.';
          messagesList.innerHTML = '';
          renderPreview(null);
          if (messagesUnreadDot) messagesUnreadDot.style.display = 'none';
        });
      }

      function setFolder(folder) {
        if ((folder !== 'inbox' && folder !== 'sent') || (folder === 'sent' && !isAdminUser)) return;
        currentFolder = folder;
        folderInboxBtn.classList.toggle('active', currentFolder === 'inbox');
        folderSentBtn.classList.toggle('active', currentFolder === 'sent');
        selectedMessageId = '';
        subscribe();
      }

      function showAuthenticated(user) {
        const email = String((user && user.email) || '').trim().toLowerCase();
        currentUserUid = String((user && user.uid) || '').trim();
        isAdminUser = email === AUTHORIZED_COMPOSE_EMAIL;
        userEmailDisplay.textContent = email || 'Not available';
        loginSection.style.display = 'none';
        dashboard.style.display = 'block';
        signOutBtn.style.display = 'inline-flex';
        signInLink.style.display = 'none';
        topNavMenu.style.display = 'flex';

        composeLink.style.display = isAdminUser ? 'inline-flex' : 'none';
        folderSentBtn.style.display = isAdminUser ? 'inline-flex' : 'none';
        if (!isAdminUser && currentFolder === 'sent') currentFolder = 'inbox';
        folderInboxBtn.classList.toggle('active', currentFolder === 'inbox');
        folderSentBtn.classList.toggle('active', currentFolder === 'sent');
        subscribe();
      }

      function showSignedOut() {
        loginSection.style.display = 'block';
        dashboard.style.display = 'none';
        signOutBtn.style.display = 'none';
        signInLink.style.display = 'inline-flex';
        topNavMenu.style.display = 'none';
        composeLink.style.display = 'none';
        folderSentBtn.style.display = 'none';
        currentFolder = 'inbox';
        currentUserUid = '';
        isAdminUser = false;
        clearListener();
      }

      auth.onAuthStateChanged(function (user) { if (user) showAuthenticated(user); else showSignedOut(); });
      signOutBtn.addEventListener('click', function () { auth.signOut().then(function () { showSignedOut(); window.location.replace('/login.html'); }); });
      messageSearchInput.addEventListener('input', applySearch);
      folderInboxBtn.addEventListener('click', function () { setFolder('inbox'); });
      folderSentBtn.addEventListener('click', function () { setFolder('sent'); });
    });
  </script>
</body>

</html>
