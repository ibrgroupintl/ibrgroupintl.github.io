<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#0284c7">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="index, nofollow">
  <title>Messages Inbox — Impact in Business Recruitment</title>
  <link rel="stylesheet" href="/resource-centre.css">
  <link rel="stylesheet" href="/index.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    .page-wrapper {
      background: white;
      max-width: 1920px;
      min-height: 1080px;
      margin: 0 auto;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }
    .contact-code {
      font-family: Arial, Helvetica, sans-serif;
    }
    .nav-dropdown { position: relative; display: inline-block; }
    .dropdown-btn {
      background: #eef2ff;
      border: 1px solid #c7d2fe;
      color: #092a4b;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .dropdown-btn:hover,
    .dropdown-btn:focus {
      background: #092a4b;
      border-color: #092a4b;
      color: #fff;
    }
    .dropdown-content {
      display: none;
      position: absolute;
      background-color: #ffffff;
      min-width: 220px;
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.18);
      padding: 8px 0;
      z-index: 1;
      border-radius: 8px;
      border: 1px solid #dbe3ee;
      top: 100%;
      left: 0;
      margin-top: 6px;
      overflow: hidden;
    }
    .dropdown-content a {
      color: #092a4b !important;
      padding: 12px 20px;
      text-decoration: none;
      display: block;
      font-size: 0.95rem;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    .dropdown-content a:hover {
      background-color: #092a4b;
      color: #ffffff !important;
    }
    .nav-dropdown:hover .dropdown-content { display: block; }

    .inbox-shell {
      margin: 2rem auto;
      max-width: 920px;
      text-align: left;
    }
    .inbox-summary {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
      padding: 1.25rem;
      margin-bottom: 1rem;
    }
    .inbox-list {
      display: grid;
      gap: 12px;
    }
    .message-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
      padding: 1rem 1.1rem;
    }
    .message-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 16px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      color: var(--muted);
      font-size: 0.92rem;
    }
    .message-subject {
      margin: 0 0 0.5rem;
      color: var(--text);
      font-size: 1.05rem;
    }
    .message-body {
      margin: 0;
      color: var(--text);
      white-space: pre-wrap;
      word-break: break-word;
    }
    .message-empty {
      padding: 1rem;
      border: 1px dashed #cfd8e3;
      border-radius: 12px;
      background: #fbfdff;
      color: var(--muted);
    }
    .message-toolbar {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .message-icon-link {
      width: 42px;
      height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      border: 1px solid #c7d2fe;
      background: #eef2ff;
      color: #092a4b;
      text-decoration: none;
      flex: 0 0 auto;
    }
    .message-icon-link:hover,
    .message-icon-link:focus {
      background: #092a4b;
      border-color: #092a4b;
      color: #fff;
    }
  </style>
</head>
<body>
  <div class="page-wrapper">
    <header class="resource-nav" role="banner">
      <div class="container container-nav">
        <div class="logo" style="display:flex;align-items:center;gap:12px">
          <img src="/160.jpg" alt="Impact logo" class="site-logo" style="height:36px;width:auto;display:block">
          <span class="site-title" style="color:lightgrey">Impact in Business Recruitment</span>
        </div>

        <div style="flex:1;display:none;align-items:center;margin-left:24px" id="topNavMenu">
          <div class="nav-dropdown">
            <button class="dropdown-btn">☰ Menu</button>
            <div class="dropdown-content">
              <a href="/index.html">Members Area</a>
              <a href="/messages.html">Messages Inbox</a>
              <a href="/insights.html">Insights Archive</a>
              <a href="/uploads.html">Resume Uploads</a>
              <a href="/settings.html">Account Settings</a>
              <a href="https://www.ibrecruitment.com/contact" target="_blank" rel="noopener noreferrer">Contact</a>
            </div>
          </div>
        </div>

        <div id="topNavSearch" class="top-nav-search" style="flex:0 1 auto;display:none;align-items:center;justify-content:center;margin:0 24px">
          <div style="position:relative;max-width:480px;width:100%">
            <input id="siteSearchInput" type="search" placeholder="Search messages" aria-label="Search inbox" style="width:100%;padding:8px 12px 8px 34px;border-radius:6px;border:1px solid #d0d7de;outline:none;box-sizing:border-box;background-color:#fff;background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2214%22 height=%2214%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%2364748b%22 stroke-width=%222.2%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22%3E%3Ccircle cx=%2211%22 cy=%2211%22 r=%227%22/%3E%3Cline x1=%2221%22 y1=%2221%22 x2=%2216.65%22 y2=%2216.65%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:10px center;background-size:14px 14px;" />
            <div id="searchResults" style="position:absolute;top:110%;left:0;right:0;background:#fff;border:1px solid #e6e9ee;border-radius:6px;box-shadow:0 8px 20px rgba(2,6,23,0.08);max-height:320px;overflow:auto;display:none;z-index:1000"></div>
          </div>
        </div>

        <button id="navToggle" class="btn btn-outline" aria-label="Toggle menu" style="display:none">☰</button>
        <div class="user-menu" style="margin-left:auto;display:flex;align-items:center;gap:12px">
          <code class="contact-code"><b>Enquiries:</b> 07940916731</code>
          <a class="message-icon-link" href="/compose.html" id="composeLink" aria-label="Compose secure message" title="Compose message" style="display:none">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
            </svg>
          </a>
          <a class="message-icon-link" href="/messages.html" id="messagesLink" aria-label="Open secure messages inbox" title="Messages inbox">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
              <path d="M6 8l6 4 6-4"></path>
            </svg>
          </a>
          <a class="btn btn-outline nav-login" href="/login.html" id="signInLink">Sign In</a>
          <button class="btn btn-outline" id="signOutBtn" style="display:none">Sign Out</button>
        </div>
      </div>
    </header>

    <div id="login-section" style="max-width:820px;margin:1.5rem auto;text-align:center">
      <div class="signin-card">
        <p class="intro-note">Please sign in to access your secure messages inbox.</p>
        <div class="divider"></div>
        <div class="center-buttons">
          <a class="btn btn-primary" href="/login.html">Go to Sign In</a>
        </div>
      </div>
    </div>

    <main id="protected-content" class="container" role="main" style="padding:3rem 0;max-width:980px;text-align:center;display:none">
      <h1>Messages Inbox</h1>
      <p class="lead">This secure inbox shows messages routed to your authenticated account. New Firebase messages are queued for Mailgun email notification and displayed here in real time.</p>

      <div class="inbox-shell">
        <div class="message-toolbar">
          <div>
            <p style="margin:0;color:var(--muted)">Signed in as</p>
            <p style="margin:0;font-weight:600" id="userEmailDisplay">-</p>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <a class="btn btn-outline" href="/settings.html">Account Settings</a>
            <a class="btn btn-outline" href="/index.html">Back to Homepage</a>
          </div>
        </div>

        <div class="inbox-summary">
          <p style="margin:0 0 0.5rem;font-weight:600">Delivery note</p>
          <p style="margin:0;color:var(--text)">Mailgun notification status is shown for each message. If no messages are available yet, the inbox will remain empty.</p>
        </div>

        <section aria-labelledby="inboxHeading">
          <h2 id="inboxHeading" style="margin-top:0">Latest messages</h2>
          <div id="messagesStatus" class="message-empty">Loading your inbox...</div>
          <div id="messagesList" class="inbox-list" style="margin-top:12px"></div>
        </section>
      </div>
    </main>

    <footer class="resource-footer" role="contentinfo">
      <div class="container" style="text-align:center">
        <div style="margin:12px 0;display:flex;gap:16px;justify-content:center;align-items:center;flex-wrap:wrap;">
          <a href="/terms.html" style="color:var(--muted);text-decoration:none;font-size:0.9rem;">Terms of Service</a>
          <span style="color:var(--muted)">|</span>
          <a href="/privacy.html" style="color:var(--muted);text-decoration:none;font-size:0.9rem;">Privacy Policy</a>
          <span style="color:var(--muted)">|</span>
          <a href="/cookies.html" style="color:var(--muted);text-decoration:none;font-size:0.9rem;">Cookie Policy</a>
        </div>
        <div>
          <p style="margin:0;color:var(--muted)">&copy; 2026 Impact in Business Recruitment. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </div>

  <script defer="" src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script defer="" src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>
  <script defer="" src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <script defer="" src="/firebase-config.js"></script>

  <script>
    window.addEventListener('load', function () {
      if (!window.firebase || !window.firebaseConfig) {
        console.warn('Firebase not available; protected UI will remain hidden');
        return;
      }
      try { firebase.initializeApp(window.firebaseConfig); } catch (e) { }

      const auth = firebase.auth();
      const db = (firebase.firestore && typeof firebase.firestore === 'function') ? firebase.firestore() : null;
      const protectedMain = document.getElementById('protected-content');
      const loginSection = document.getElementById('login-section');
      const signOutBtn = document.getElementById('signOutBtn');
      const signInLink = document.getElementById('signInLink');
      const topNavMenu = document.getElementById('topNavMenu');
      const topNavSearch = document.getElementById('topNavSearch');
      const composeLink = document.getElementById('composeLink');
      const siteSearchInput = document.getElementById('siteSearchInput');
      const searchResultsEl = document.getElementById('searchResults');
      const userEmailDisplay = document.getElementById('userEmailDisplay');
      const messagesStatus = document.getElementById('messagesStatus');
      const messagesList = document.getElementById('messagesList');
      let unsubscribeInbox = null;

      function escapeHtml(s) {
        return (s || '').replace(/[&<>"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; });
      }

      function clearInboxListener() {
        if (typeof unsubscribeInbox === 'function') {
          unsubscribeInbox();
          unsubscribeInbox = null;
        }
      }

      function toMillis(value) {
        if (!value) return 0;
        if (typeof value === 'number') return value;
        if (value.toMillis && typeof value.toMillis === 'function') return value.toMillis();
        if (value.toDate && typeof value.toDate === 'function') return value.toDate().getTime();
        var parsed = new Date(value);
        return isNaN(parsed.getTime()) ? 0 : parsed.getTime();
      }

      function formatReceivedAt(value) {
        if (!value) return 'Just now';
        const date = value.toDate ? value.toDate() : new Date(value);
        if (isNaN(date.getTime())) return String(value);
        return new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          year: 'numeric',
          month: 'short',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZoneName: 'short'
        }).format(date);
      }

      function formatDeliveryStatus(status) {
        const normalized = (status || '').toLowerCase();
        if (normalized === 'delivered') return 'Sent via Mailgun';
        if (normalized === 'queued') return 'Queued for Mailgun';
        return 'Stored only';
      }

      function renderMessages(items) {
        if (!messagesStatus || !messagesList) return;
        if (!items.length) {
          messagesStatus.textContent = 'No messages yet.';
          messagesList.innerHTML = '';
          return;
        }

        messagesStatus.textContent = items.length + ' message' + (items.length === 1 ? '' : 's') + ' loaded.';
        messagesList.innerHTML = items.map(function (item) {
          return '<article class="message-card">' +
            '<div class="message-meta">' +
              '<span><strong>From:</strong> ' + escapeHtml(item.senderEmail || 'Admin') + '</span>' +
              '<span><strong>Received:</strong> ' + escapeHtml(item.receivedAtText) + '</span>' +
              '<span><strong>Email notification:</strong> ' + escapeHtml(item.deliveryStatusText) + '</span>' +
            '</div>' +
            '<h3 class="message-subject">' + escapeHtml(item.subject || 'No subject') + '</h3>' +
            '<p class="message-body">' + escapeHtml(item.body || '') + '</p>' +
          '</article>';
        }).join('');
      }

      function loadInbox(user) {
        const email = (user && user.email) ? String(user.email).trim().toLowerCase() : '';
        const uid = (user && user.uid) ? String(user.uid).trim() : '';
        if (userEmailDisplay) userEmailDisplay.textContent = email || 'Not available';

        clearInboxListener();

        if (!db || !uid) {
          if (messagesStatus) messagesStatus.textContent = 'Messages will appear here when the Mailgun workflow is connected.';
          if (messagesList) messagesList.innerHTML = '';
          return;
        }

        if (messagesStatus) messagesStatus.textContent = 'Loading your inbox...';
        unsubscribeInbox = db.collection('messages').where('recipientUid', '==', uid).onSnapshot(function (snapshot) {
          const items = [];
          snapshot.forEach(function (doc) {
            const data = doc.data() || {};
            const receivedAtValue = data.receivedAt || data.createdAt || data.sentAt || null;
            items.push({
              id: doc.id,
              subject: data.subject || data.title || '',
              body: data.body || data.message || '',
              senderEmail: data.senderEmail || data.fromEmail || 'admin-messages@ibrecruitment.com',
              receivedAtText: formatReceivedAt(receivedAtValue),
              receivedAtSort: toMillis(receivedAtValue),
              deliveryStatusText: formatDeliveryStatus(data.deliveryStatus)
            });
          });

          items.sort(function (a, b) {
            return b.receivedAtSort - a.receivedAtSort;
          });

          renderMessages(items.slice(0, 50));
        }, function (err) {
          console.error('Inbox load failed', err);
          if (messagesStatus) messagesStatus.textContent = 'Unable to load messages right now.';
          if (messagesList) messagesList.innerHTML = '<div class="message-empty">Messages could not be loaded.</div>';
        });
      }

      function showAuthenticated(user) {
        if (loginSection) loginSection.style.display = 'none';
        if (protectedMain) protectedMain.style.display = 'block';
        if (signOutBtn) signOutBtn.style.display = 'inline-flex';
        if (signInLink) signInLink.style.display = 'none';
        if (topNavMenu) topNavMenu.style.display = 'flex';
        if (topNavSearch) topNavSearch.style.display = 'flex';
        if (composeLink) composeLink.style.display = 'inline-flex';
        loadInbox(user);
      }

      function showSignedOut() {
        if (loginSection) loginSection.style.display = 'block';
        if (protectedMain) protectedMain.style.display = 'none';
        if (signOutBtn) signOutBtn.style.display = 'none';
        if (signInLink) signInLink.style.display = 'inline-flex';
        if (topNavMenu) topNavMenu.style.display = 'none';
        if (topNavSearch) topNavSearch.style.display = 'none';
        if (composeLink) composeLink.style.display = 'none';
        clearInboxListener();
        if (messagesStatus) messagesStatus.textContent = 'Please sign in to view your inbox.';
        if (messagesList) messagesList.innerHTML = '';
      }

      auth.onAuthStateChanged(function (user) {
        if (user) showAuthenticated(user);
        else showSignedOut();
      });

      if (signOutBtn) {
        signOutBtn.addEventListener('click', function () {
          auth.signOut().then(function () {
            showSignedOut();
            window.location.replace('/login.html');
          });
        });
      }

      function performSearch(queryText) {
        if (!queryText || queryText.trim().length < 2) {
          if (searchResultsEl) searchResultsEl.style.display = 'none';
          return;
        }
        const query = queryText.trim().toLowerCase();
        const candidates = document.querySelectorAll('main h1, main h2, main h3, main p, main article');
        const results = [];

        candidates.forEach(function (el) {
          const text = (el.textContent || '').trim();
          if (!text) return;
          const idx = text.toLowerCase().indexOf(query);
          if (idx === -1) return;
          results.push({ el: el, title: text.slice(0, 60), snippet: text.slice(Math.max(0, idx - 20), Math.min(text.length, idx + 80)) });
        });

        if (!searchResultsEl) return;
        if (results.length === 0) {
          searchResultsEl.innerHTML = '<div style="padding:12px;color:#666">No results</div>';
          searchResultsEl.style.display = 'block';
          return;
        }

        searchResultsEl.innerHTML = results.slice(0, 8).map(function (r, i) {
          return '<div class="sr-item" data-idx="' + i + '" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid #f4f6f8"><div style="font-weight:600;color:#092a4b;margin-bottom:6px">' + escapeHtml(r.title) + '</div><div style="font-size:0.9rem;color:#556">' + escapeHtml(r.snippet) + '</div></div>';
        }).join('');
        searchResultsEl.style.display = 'block';

        Array.from(searchResultsEl.querySelectorAll('.sr-item')).forEach(function (node, i) {
          node.addEventListener('click', function () {
            const target = results[i].el;
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            if (searchResultsEl) searchResultsEl.style.display = 'none';
          });
        });
      }

      if (siteSearchInput) {
        siteSearchInput.addEventListener('input', function (e) { performSearch(e.target.value); });
      }

      document.addEventListener('click', function (ev) {
        if (!searchResultsEl || !siteSearchInput) return;
        if (ev.target === siteSearchInput || searchResultsEl.contains(ev.target)) return;
        searchResultsEl.style.display = 'none';
      });
    });
  </script>
</body>
</html>
