:root {
    /* Color Palette */
    --color-bg: #12141d;
    --color-bg-secondary: #1a1e29;
    --color-text: #e0e6ed;
    --color-text-dim: #94a3b8;
    --color-accent: #007bff; /* Primary Blue */
    --color-accent-gradient: linear-gradient(135deg, #007bff 0%, #00d2ff 100%);
    --color-surface: #1e293b;
    --color-border: #334155;

    /* Spacing System */
    --spacing-1: 0.25rem;
    --spacing-2: 0.5rem;
    --spacing-3: 0.75rem;
    --spacing-4: 1rem;
    --spacing-6: 1.5rem;
    --spacing-8: 2rem;
    --spacing-12: 3rem;
    --spacing-16: 4rem;
    --spacing-24: 6rem;

    /* Typography */
    --font-primary: 'Inter', sans-serif;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 1.875rem;
    --font-size-4xl: 2.25rem;

    /* Modern UI */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 16px;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

    /* Transitions */
    --transition-fast: 0.2s ease;
    --transition-normal: 0.35s ease;
}

/* Base Styles */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-primary);
    line-height: 1.6;
    overflow-x: hidden;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-6);
}

a {
    transition: var(--transition-fast);
    text-decoration: none;
    color: inherit;
}

ul {
    list-style: none;
}

/* Main Navbar */
.navbar {
    padding: var(--spacing-6) 0;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    transition: var(--transition-fast);
}

.navbar.scrolled {
    background: rgba(18, 20, 29, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-md);
    padding: var(--spacing-4) 0;
}

.container-navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo-img {
    height: 40px;
    display: block;
}

.nav-links .nav-list {
    display: flex;
    gap: var(--spacing-8);
    align-items: center;
}

.nav-links a {
    font-weight: 500;
    color: var(--color-text-dim);
}

.nav-links a:hover {
    color: var(--color-text);
}

.cta-nav a.btn {
    padding: var(--spacing-2) var(--spacing-6);
    background: var(--color-accent-gradient);
    color: white;
    border-radius: var(--radius-md);
}

/* Sections */
section {
    padding: var(--spacing-24) 0;
}

.text-center {
    text-align: center;
}

.section-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-12);
}

/* Buttons */
.btn {
    display: inline-block;
    padding: var(--spacing-3) var(--spacing-8);
    border-radius: var(--radius-md);
    font-weight: 600;
    text-align: center;
    border: none;
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.btn-primary {
    background: var(--color-accent-gradient);
    color: #fff;
}

.btn-secondary {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
}

.btn-large {
    padding: var(--spacing-4) var(--spacing-12);
    font-size: var(--font-size-lg);
}

/* Hero Section */
.hero-section {
    padding-top: var(--spacing-24);
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.container-hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: var(--spacing-12);
}

.hero-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 1.1;
    margin-bottom: var(--spacing-6);
    color: white;
}

.text-accent {
    background: var(--color-accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-text {
    font-size: var(--font-size-xl);
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-8);
    max-width: 600px;
}

.hero-actions {
    display: flex;
    gap: var(--spacing-4);
}

.circle-blob {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0,123,255,0.2) 0%, rgba(18,20,29,0) 70%);
    border-radius: 50%;
    filter: blur(40px);
}

/* Features Section */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-8);
}

.feature-card {
    background: var(--color-bg-secondary);
    padding: var(--spacing-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: var(--transition-normal);
}

.feature-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-8px);
}

.feature-icon {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-4);
}

.feature-card h3 {
    margin-bottom: var(--spacing-4);
}

.feature-card p {
    color: var(--color-text-dim);
}

/* Testimonials Section */
.testimonials-section {
    background: var(--color-bg-secondary);
    padding: var(--spacing-24) 0;
}

.testimonial-slider {
    max-width: 800px;
    margin: 0 auto;
}

.testimonial-item {
    padding: var(--spacing-8);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    text-align: center;
}

.testimonial-text {
    font-size: var(--font-size-2xl);
    font-style: italic;
    margin-bottom: var(--spacing-6);
    line-height: 1.4;
}

.testimonial-author {
    font-weight: 600;
    color: var(--color-text-dim);
}

/* Join Section */
.join-section {
    padding: var(--spacing-24) 0;
    background: radial-gradient(circle at center, rgba(0, 123, 255, 0.1) 0%, rgba(18, 20, 29, 0) 100%);
}

.join-text {
    font-size: var(--font-size-xl);
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-8);
}

.join-actions {
    margin-top: var(--spacing-8);
}

/* Cookie Banner */
.cookie-banner {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    right: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-6);
    box-shadow: var(--shadow-lg);
    z-index: 2000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.5s ease;
}

.cookie-banner.hidden {
    transform: translateY(200%);
}

.cookie-actions {
    margin-left: var(--spacing-8);
}

/* Footer Links */
.footer {
    padding: var(--spacing-16) 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.footer-links a {
    margin-left: var(--spacing-6);
    color: var(--color-text-dim);
    font-size: 0.9rem;
}

.footer-links a:hover {
    color: var(--color-text);
}

/* Animations */
.animate-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.animate-reveal.active {
    opacity: 1;
    transform: translateY(0);
}

.delay-1 { transition-delay: 0.1s; }
.delay-2 { transition-delay: 0.2s; }
.delay-3 { transition-delay: 0.3s; }

/* Chatbot Popup Styling (as per instructions) */
.chatbot-popup {
    position: fixed;
    bottom: 6rem;
    right: 2rem;
    width: 350px;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
    z-index: 2000;
    overflow: hidden;
    transition: transform var(--transition-normal), opacity var(--transition-normal);
}

.chatbot-popup.hidden {
    transform: translateY(20px) scale(0.9);
    opacity: 0;
    pointer-events: none;
}

.chatbot-header {
    background: var(--color-accent-gradient); /* Ensure gradient header as per instructions */
    padding: var(--spacing-4) var(--spacing-6);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chatbot-body {
    padding: var(--spacing-6);
    min-height: 200px;
}

.chatbot-footer {
    padding: var(--spacing-4) var(--spacing-6);
    display: flex;
    gap: var(--spacing-2);
    border-top: 1px solid var(--color-border);
}

.chat-input {
    flex-grow: 1;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0 var(--spacing-3);
    border-radius: var(--radius-md);
    color: var(--color-text);
}

.chat-input::placeholder {
    color: var(--color-text-dim);
}

.btn-chatbot-toggle {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--color-accent-gradient);
    color: white;
    border: none;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    z-index: 2000;
    font-size: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform var(--transition-fast);
}

.btn-chatbot-toggle:hover {
    transform: scale(1.1);
}

.btn-close {
    background: transparent;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
}

/* Responsive */
@media (max-width: 968px) {
    .container-hero {
        grid-template-columns: 1fr;
        text-align: center;
    }
    .hero-actions {
        justify-content: center;
    }
    .hero-text {
        margin: 0 auto var(--spacing-8);
    }
    .features-grid {
        grid-template-columns: 1fr;
    }
}
