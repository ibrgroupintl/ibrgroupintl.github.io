    <a href="https://www.instagram.com/ibrblogs" target="_blank" rel="noopener noreferrer" style="color:var(--muted);text-decoration:none">Instagram</a>
  </div>

  <footer class="resource-footer" role="contentinfo">
    <div class="container" style="text-align:center">
      <div style="margin:12px 0;display:flex;gap:16px;justify-content:center;align-items:center;">
        <a href="/terms.html" style="color:var(--muted);text-decoration:none;font-size:0.9rem;">Terms of Service</a>
