rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /publicProfiles/{uid} {
      // Anyone can read public profiles
      allow read: if true;
      // Only the signed-in user can create or update their own profile
      allow create, update: if request.auth != null && request.auth.uid == uid;
      // Only the signed-in user can delete their own profile
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // MESSAGES LOGIC
    match /messages/{messageId} {
      // Only recipient or admin can read
      allow read: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid
      );
      // Only recipient can update isOpened, openedAt, openedByUid
      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['isOpened', 'openedAt', 'openedByUid']) &&
        request.resource.data.isOpened == true &&
        request.resource.data.openedByUid == request.auth.uid;
      // No create/delete from client
      allow create, delete: if false;
    }

    // INSIGHTS RSS FEED LOGIC
    match /insightsFeed/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'title', 'link', 'date', 'timestamp', 'tags', 'imageUrl', 'snippet', 'source', 'updatedAt'
        ]) &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 300 &&
        request.resource.data.link is string &&
        (request.resource.data.link.matches('^https://substack\\.ibrecruitment\\.com/.*') || request.resource.data.link.matches('^https://[a-z0-9-]+\\.substack\\.com/.*')) &&
        request.resource.data.date is string && request.resource.data.date.size() <= 80 &&
        request.resource.data.timestamp is number &&
        request.resource.data.tags is list && request.resource.data.tags.size() <= 20 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.snippet is string && request.resource.data.snippet.size() <= 1000 &&
        request.resource.data.source is string && request.resource.data.source == 'substack-rss' &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // USER PROFILES
    match /userProfiles/{uid} {
  allow read: if isSignedIn() && request.auth.uid == uid;
  allow create, update: if isSignedIn() && request.auth.uid == uid &&
    request.resource.data.keys().hasOnly(['userId', 'email', 'firstName', 'lastName', 'bio', 'updatedAt']) &&
    request.resource.data.userId is string &&
    request.resource.data.email is string &&
    request.resource.data.firstName is string &&
    request.resource.data.lastName is string &&
    request.resource.data.bio is string &&
    request.resource.data.updatedAt is timestamp;
  allow delete: if false;
}

    // PUBLIC PROFILES
    match /publicProfiles/{uid} {
  allow read: if true; // or isSignedIn() if you want to restrict
  allow create, update: if isSignedIn() && request.auth.uid == uid &&
    request.resource.data.keys().hasOnly(['uid', 'userId', 'firstName', 'lastName', 'bio', 'email', 'updatedAt']) &&
    request.resource.data.uid == request.auth.uid &&
    request.resource.data.userId is string &&
    request.resource.data.firstName is string &&
    request.resource.data.lastName is string &&
    request.resource.data.bio is string &&
    request.resource.data.email is string &&
    request.resource.data.updatedAt is timestamp;
  allow delete: if isSignedIn() && request.auth.uid == uid;
}

    // DENY ALL OTHER ACCESS
    match /{document=**} {
      allow read, write: if false;
    }
  }
}