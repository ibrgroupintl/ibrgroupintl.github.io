rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        resource.data.recipientUid == request.auth.uid ||
        request.auth.token.email == 'developers@ibrecruitment.com'
      );
      
      allow update: if request.auth != null &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['isOpened', 'openedAt', 'openedByUid']) &&
        request.resource.data.isOpened == true &&
        request.resource.data.openedByUid == request.auth.uid;

      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
