# Example environment variables for the Node app
# DO NOT commit a real .env with secrets into source control

# Application
NODE_ENV=production
PORT=3000
SESSION_SECRET=your_generated_session_secret_here
COOKIE_DOMAIN=premium.ibrecruitment.com

# MySQL / Database (mysql2 pool)
DB_HOST=34.133.154.116
DB_USER=cameodj
DB_PASSWORD=:%VmHfKSn_dd*(kZ
DB_NAME=afters_with_rinse
DB_CONN_LIMIT=10

# Alternate env var names supported by the app (optional)
# DB_USERNAME= (alias for DB_USER)
# DB_PASS= (alias for DB_PASSWORD)
# DB_DATABASE= (alias for DB_NAME)

# Security notes:
# - Generate SESSION_SECRET with a secure random generator, e.g.:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   and set it in production environments (never check into git).
# - In production set NODE_ENV=production so cookies are marked secure.
# - Ensure GOOGLE_CALLBACK_URL exactly matches the redirect URI registered in Google Cloud Console.
